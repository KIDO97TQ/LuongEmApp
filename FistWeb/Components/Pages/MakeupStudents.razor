        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Lỗi khi upload: {ex.Message}");
        }
    }
    #endregion

    #region tab2
    private List<Data.DTOs.InfoMakeUp> allData = new();
    private List<Data.DTOs.InfoMakeUp> currentPageData = new();
    private bool checkNull = false, isLoadingOption = false;
    private int currentPage = 1;
    private int rowsPerPage = 12;
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < totalPages;
    private int totalPages => (int)Math.Ceiling((decimal)(allData.Count) / rowsPerPage);

    private void LoadPage()
    {
        currentPageData = allData
            .Skip((currentPage - 1) * rowsPerPage)
            .Take(rowsPerPage)
            .ToList();

        StateHasChanged();
    }

    private void NextPage()
    {
        if (currentPage * rowsPerPage < allData.Count)
        {
            currentPage++;
            LoadPage();
        }
    }

    private void PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            LoadPage();
        }
    }

    private async Task LoadData(string type, int month)
    {
        allData = await GetListMakeup.GetListMakeup("goiMakeupStu", int.Parse(this.year), month, type);

        checkNull = !(allData != null && allData.Any());

        currentPage = 1;
        LoadPage();
    }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        string type = e.Value?.ToString() ?? "";
        this.type_ = type;
        int moth = int.Parse(this.month);
        await LoadData(type, moth);
    }

    private string type_ = "";
    private async Task OnMonthChanged1(ChangeEventArgs e)
    {
        int thang = int.Parse(e.Value.ToString());

        await LoadData(this.type_, thang);
    }
    #endregion

    #region Dummary chart
    private double tongdoanhthuthang, tongDoanhThuNam;
    private string yearFix0, yearFix1, yearFix2;

    private async Task TimKiem()
    {
        try
        {
            int nam = int.Parse(DateTime.Now.Year.ToString());
            int thang = int.Parse(DateTime.Now.Month.ToString());

            var dataDoanhthuthang = await Getdoanhthuthang(nam, thang, 0);
            var dataDoanhthunam = await Getdoanhthunam(nam);

            await JS.InvokeVoidAsync("chartHelper.renderChart", "Doanhthuthang", dataDoanhthuthang, "bar");
            await JS.InvokeVoidAsync("chartHelper.renderChart", "Doanhthunam", dataDoanhthunam, "bar");

            if (!_disposed)
            {
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
        }
    }

    private async Task OnYearChanged(ChangeEventArgs e)
    {
        int nam = int.Parse(e.Value.ToString());
        year = nam.ToString();
        var dataDoanhthunam = await Getdoanhthunam(nam);

        await JS.InvokeVoidAsync("chartHelper.renderChart", "Doanhthunam", dataDoanhthunam, "bar");
        StateHasChanged();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        int nam = int.Parse(DateTime.Now.Year.ToString());
        int thang = int.Parse(e.Value.ToString());
        month = thang.ToString("D2");

        var dataDoanhthuthang = await Getdoanhthuthang(nam, thang, 0);
        await JS.InvokeVoidAsync("chartHelper.renderChart", "Doanhthuthang", dataDoanhthuthang, "bar");
        StateHasChanged();
    }

    private async Task OnDayChanged(ChangeEventArgs e)
    {
        int nam = int.Parse(DateTime.Now.Year.ToString());
        int thang = int.Parse(DateTime.Now.Month.ToString());
        int ngay = int.Parse(e.Value.ToString());
        month = thang.ToString("D2");

        var dataDoanhthuthang = await Getdoanhthuthang(nam, thang, ngay);
        await JS.InvokeVoidAsync("chartHelper.renderChart", "Doanhthuthang", dataDoanhthuthang, "bar");
        StateHasChanged();
    }

    private List<Data.DTOs.RentalSummaryMakeup> DoanhthuNam;
    private List<Data.DTOs.RentalSummaryMakeup> Doanhthuthang;
    public async Task<object> Getdoanhthunam(int nam)
    {
        DoanhthuNam = await GetSumMakeup.SumGetListMakeup("goiMakeupStu", nam);
        tongDoanhThuNam = (double)DoanhthuNam.Sum(x => x.Reverue);

        // Lấy danh sách tháng có dữ liệu
        var labels = DoanhthuNam
            .Select(x => x.Date.ToString("MM/yyyy"))
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        // Tính tổng doanh thu cho từng tháng
        var data = labels
            .Select(label => DoanhthuNam
                .Where(x => x.Date.ToString("MM/yyyy") == label)
                .Sum(x => x.Reverue))
            .ToList();

        // Tạo dataset (dạng đơn, không phân nhóm)
        var datasets = new[]
        {
        new
        {
            label = "Tổng doanh thu",
            data = data,
            backgroundColor = "rgba(79, 195, 247, 0.5)",
            borderColor = "rgba(79, 195, 247, 1)",
            borderWidth = 2,
            fill = true,
            tension = 0.4
        }
    };

        // Tạo chartData trả về JS
        var chartData = new
        {
            labels = labels,
            datasets = datasets
        };

        return chartData;
    }

    public async Task<object> Getdoanhthuthang(int nam, int thang, int ngay)
    {
        if (ngay == 0)
            Doanhthuthang = await GetSumMakeup.SumGetListMakeup("goiMakeupStu", nam, thang, null);
        else
            Doanhthuthang = await GetSumMakeup.SumGetListMakeup("goiMakeupStu", nam, thang, ngay);
        tongdoanhthuthang = (double)Doanhthuthang.Sum(x => x.Reverue);


        var labels = Doanhthuthang
            .Select(x => x.Date.Date.ToString("MM/yyyy"))
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        // Nhóm theo loại sản phẩm
        var productGroups = Doanhthuthang
            .GroupBy(x => x.Type)
            .ToDictionary(
                g => g.Key,
                g => labels.Select(label =>
                    g.Where(x => x.Date.Date.ToString("MM/yyyy") == label)
                     .Sum(x => x.Reverue)
                ).ToList()
            );

        // Tạo datasets
        var datasets = productGroups.Select(g => new
        {
            label = g.Key,
            data = g.Value,
            backgroundColor = GetRandomColor(),
            borderColor = "'rgba(79, 195, 247, 0.1)",
            borderWidth = 1,
            fill = true,
            tension = 0.4
        }).ToList();

        // Tạo chartData
        var chartData = new
        {
            labels = labels,
            datasets = datasets
        };
        return chartData;
    }

    private static readonly Random rand = new Random();
    private string GetRandomColor()
    {
        int r = rand.Next(0, 256);
        int g = rand.Next(0, 256);
        int b = rand.Next(0, 256);
        return $"rgba({r}, {g}, {b}, 0.5)";
    }

    private List<int> DaysInMonth = new();
    private void UpdateDays()
    {
        int days = DateTime.DaysInMonth(DateTime.Now.Year, DateTime.Now.Month);
        DaysInMonth = Enumerable.Range(1, days).ToList();
    }

                                     {
                                         if (decimal.TryParse(x.keyData1, out var number))
                                             return number;
                                         return decimal.MaxValue;
                                     })
                                     .Select(x => x.keyData1)
                                     .ToList();
                isLoading = false;
                await JS.InvokeVoidAsync("closeAllOptionMenus");
                await JS.InvokeVoidAsync("alert", $"Thêm Giá khóa makeup ({newValuePrice}) thành công!");
                newValuePrice = "";

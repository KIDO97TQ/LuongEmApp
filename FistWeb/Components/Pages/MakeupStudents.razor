            await JS.InvokeVoidAsync("closeAllOptionMenus");
            return;
        }
        bool confirmed = await JSx.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa giá khóa makeup này không?");

        if (confirmed)

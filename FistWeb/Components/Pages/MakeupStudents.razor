@page "/makeupstudents"
@using Microsoft.EntityFrameworkCore
@using System.Data
@using System.Text.Json
@using FistWeb.Data.Services
@using System.Text.RegularExpressions
@inject Data.AppDbContext Db
@inject IGetParamaterMakeupService GetListParamaterMakeup
@rendermode InteractiveServer
@inject IJSRuntime JS
@using System.Globalization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@using System.Text
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject IGetParaUserService GetSPInfo
@inject IAddParaService AddPara
@inject IDeleteParaService DeletePara
@inject IGetParaUserService GetUserInfo
@implements IDisposable
@inject IInsertRevenueService AddOrderMake
@inject IGetSumRevenueService GetSumMakeup
@inject IGetListMakeupService GetListMakeup
@inject LoadingService LoadingService

<div class="tabs">
    <button class="tab-btn active" data-tab="tab1">
        <img src="makeup-artist.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Thêm lịch học Make-up
    </button>
    <button class="tab-btn" data-tab="tab2">
        <img src="customer.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        List học viên
    </button>
    <button class="tab-btn" data-tab="tab3">
        <img src="pie-chart.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Tổng lịch học Make-up
    </button>
</div>

@* tab1 *@
<div class="tab-content active" id="tab1">
    <div class="form-container">
        <div class="form-section-left">
            <!-- Tên SP -->
            <div class="form-group">
                <label class="form-label required-label">Tên học viên:</label>
                <input type="text" @bind="TextValueNameSP" @bind:event="oninput" class="form-input" placeholder="Nhập tên học viên..." />
                <div></div>
            </div>

            <!-- Gói make -->
            <div class="form-group">
                <label class="form-label required-label">Khóa Makeup:</label>
                <select class="form-select" @bind="SelectValueSP" @bind:event="oninput">
                    <option value="">Chọn khóa makeup</option>
                    @{
                        if (this.ListGoimake != null && !isLoading)
                        {
                            foreach (var item in this.ListGoimake)
                            {
                                <option value="@item.Key">@item.Key</option>
                            }
                        }
                    }
                </select>
                @if (isLoading)
                {
                    <div class="spinner" style="margin-top:10px;"></div>
                }
                else
                {
                    <div class="option-wrapper">
                        <button class="btn btn-option" onclick="toggleOptionMenu(this)"><span>...</span> Option</button>
                        <div class="option-menu">
                            <div class="New-price">
                                <input id="priceInput" type="text"
                                       @bind="newValueSP"
                                       @bind:event="oninput"
                                       placeholder="Thêm mới khóa makeup..." />

                                <button class="option-itemAdd" type="button" @onclick="addGoiMakeupClick">
                                    <i class="bi-option bi-plus-circle-fill"></i>
                                </button>
                            </div>
                            <div class="option-item" @onclick="XoaGoiMakeClick">🗑️ Xóa khóa makeup đang chọn</div>

                        </div>
                    </div>
                }
            </div>

            <!-- Giá thuê theo ngày -->
            <div class="form-group">
                <label class="form-label required-label">Giá khóa Makeup:</label>
                <select class="form-select" @bind="SelectValuePrice" @bind:event="oninput">
                    <option value="">Chọn mức giá</option>
                    @{
                        if (this.ListPrice != null && !isLoading)
                        {
                            @foreach (var item in this.ListPrice)
                            {
                                if (decimal.TryParse(item, NumberStyles.Number, new CultureInfo("vi-VN"), out var parsedValue))
                                {
                                    <option value="@item">@parsedValue.ToString("N0", new CultureInfo("vi-VN")) Vnđ</option>
                                }
                            }
                        }
                    }
                </select>
                @if (isLoading)
                {
                    <div class="spinner" style="margin-top:10px;"></div>
                }
                else
                {
                    <div class="option-wrapper">
                        <button class="btn btn-option" onclick="toggleOptionMenu(this)"><span>...</span> Option</button>

                        <div class="option-menu">
                            <div class="New-price">
                                <input id="priceInput" type="text"
                                       @bind="newValuePrice"
                                       placeholder="Thêm mới khóa makeup..."
                                       @oninput="OnPriceInput"
                                       autofocus />
                                <button class="option-itemAdd" type="button" @onclick="addPriceClick">
                                    <i class="bi-option bi-plus-circle-fill"></i>
                                </button>
                            </div>
                            <div class="option-item" @onclick="XoaPriceClick">🗑️ Xóa giá khóa makeup đang chọn</div>
                        </div>
                    </div>
                }
            </div>

            <div class="store-info">
                @if (UpdateisLoading)
                {
                    <div class="spinner" style="margin-top:10px;"></div>
                }
                else
                {
                    <button class="button-add" type="button" @onclick="ADDOrderMake"><i class="bi bi-check2-circle"></i>Thêm học viên MakeUp</button>
                }
            </div>
        </div>
    </div>
</div>

@* tab2 *@
<div class="tab-content tab2" id="tab2">
    @if (isLoading)
    {
        <div> ⏳ Đang tải dữ liệu...</div>
    }
    else
    {
        <h3 class="header-controls">
            <div class="controls-left">
                Khóa Makeup
                <select class="control-select" value="type" @onchange="OnTypeChanged">
                    @{
                        if (this.ListGoimake != null && !isLoading)
                        {
                            <option value="All">All</option>
                            foreach (var item in this.ListGoimake)
                            {
                                <option value="@item.Key">@item.Key</option>
                            }
                        }
                    }
                </select>
                Tháng
                <select class="control-select" value="month" @onchange="OnMonthChanged1">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i.ToString("D2")">@i.ToString("D2")</option>
                    }
                </select>
            </div>
        </h3>
        <div class="chart-order">
            @*Hiện lên table*@
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Stt</th>
                        <th>Họ tên</th>
                        <th>Khóa Makeup</th>
                        <th>Giá Khóa Makeup</th>
                        <th>Ngày tạo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (currentPageData != null && currentPageData.Any())
                    {
                        int count = (currentPage - 1) * rowsPerPage + 1;
                        foreach (var item in currentPageData)
                        {
                            <tr>
                                <td data-label="STT">@count</td>
                                <td data-label="Họ tên">@item.namekh</td>
                                <td data-label="Khóa Makeup">@item.type</td>
                                <td data-label="Giá Khóa Makeup">@item.price.ToString("N0", new CultureInfo("vi-VN")) vnđ</td>
                                <td data-label="Ngày tạo">@item.createdate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                            count++;
                        }
                    }
                    else if (checkNull)
                    {
                        <tr>
                            <td colspan="13" style="text-align:center">❌ Không có dữ liệu.</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="13" style="text-align:center">⏳ Đang tải dữ liệu...</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination">
            <button @onclick="PrevPage" disabled="@(!CanPrev)">
                <i class="fa-solid fa-arrow-left"></i> Trước
            </button>
            <span>Trang @currentPage / @totalPages</span>
            <button @onclick="NextPage" disabled="@(!CanNext)">
                Sau <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>
    }
</div>

@* tab3 *@
<div class="tab-content" id="tab3">
    <div class="dashboard-row">
        <div class="chart-card">
            <div class="staff-header">
                <h3 class="card-title">
                    <img src="statistics.png" alt="icon" style="width: 35px; height: 35px; margin-right: 6px;">
                    Tổng doanh thu tháng @month
                </h3>
                <div class="staff-controls">
                    <label class="label-ca">Tháng: </label>
                    <select class="control-select" value="Month" @onchange="OnMonthChanged">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i.ToString("D2")">@i.ToString("D2")</option>
                        }
                    </select>
                </div>
                <div class="staff-controls">
                    <label class="label-ca">Ngày: </label>
                    <select class="control-select" @onchange="OnDayChanged">
                        @foreach (var day in DaysInMonth)
                        {
                            <option value="@day">@day.ToString("D2")</option>
                        }
                    </select>
                </div>
            </div>
            <div class="chart-wrapper">
                <div class="chart-container">
                    <canvas id="Doanhthuthang"></canvas>
                    <h4 class="chart-legend">Tổng doanh thu tháng @month: @tongdoanhthuthang.ToString("N0") Vnđ</h4>
                </div>
            </div>
        </div>
        <div class="chart-card">
            <div class="staff-header">
                <h3 class="card-title">
                    <img src="statistics.png" alt="icon" style="width: 35px; height: 35px; margin-right: 6px;">
                    Tổng doanh thu năm @year
                </h3>
                <div class="staff-controls">
                    <select class="control-select" value="year" @onchange="OnYearChanged">
                        <option value="@yearFix1">@yearFix1</option>
                        <option value="@yearFix0">@yearFix0</option>
                        <option value="@yearFix2">@yearFix2</option>
                    </select>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="Doanhthunam"></canvas>
                <h4 class="chart-legend">Tổng doanh thu năm @year: @tongDoanhThuNam.ToString("N0") Vnđ</h4>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', function() {
    // đổi active trên nút
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');

    // đổi nội dung hiển thị
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    document.getElementById(this.dataset.tab).classList.add('active');
    });
    });
</script>


@code {
    private string month;
    private string year;
    private List<Data.DTOs.ListParamaterMakeup> datapara = new();
    private List<Data.DTOs.ProductStock> dataWH = new();
    Dictionary<string, string> ListGoimake;
    List<string> ListPrice;
    private bool isLoading = true, UpdateisLoading = false, UpdateisLoading2 = false;
    private string SelectValueSP, TextValueNameSP, SelectValuePrice, newValueSP, newValuePrice;
    private string typeSelect, typeWHSelect;
    [Inject] private IJSRuntime JSx { get; set; }
    private bool isLoadingService = true;
    private bool _disposed = false;
    private CancellationTokenSource cts = new();
    public void Dispose()
    {
        _disposed = true;
        cts.Cancel();
        cts.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        this.month = DateTime.Now.Month.ToString();
        this.year = DateTime.Now.Year.ToString();
        this.yearFix0 = DateTime.Now.Year.ToString();
        this.yearFix1 = (DateTime.Now.Year - 1).ToString();
        this.yearFix2 = (DateTime.Now.Year + 1).ToString();
        UpdateDays();
    }

    private ValueTask OnBeforeNavigation(LocationChangingContext context)
    {
        if (isLoadingService)
        {
            context.PreventNavigation();
        }
        return ValueTask.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {

                LoadingService.Begin();
                bool isLoggedIn = await localStorage.GetItemAsync<bool>("isLoggedIn");
                if (isLoggedIn)
                {
                    isLoading = true;
                    //await GetMaterialInWH(true, false);
                    await TimKiem();
                    datapara = await GetListParamaterMakeup.GetParamaterMakeUp();
                    this.ListGoimake = datapara.Where(x => x.KeyPara == "goiMakeupStu").ToDictionary(x => x.keyData1, x => x.keyData2);
                    this.ListPrice = datapara.Where(x => x.KeyPara == "priceMakeupStu")
                                         .OrderBy(x =>
                                         {
                                             if (decimal.TryParse(x.keyData1, out var number))
                                                 return number;
                                             return decimal.MaxValue;
                                         })
                                         .Select(x => x.keyData1)
                                         .ToList();
                    await LoadData(this.type_, int.Parse(this.month));
                    isLoading = false;
                    if (!_disposed)
                    {
                        StateHasChanged();
                    }
                    LoadingService.End();
                    isLoadingService = false;
                }
                else
                {
                    LoadingService.End();
                    isLoadingService = false;
                    Navigation.NavigateTo("/", true);

                }
            }
            catch (Exception)
            {
                LoadingService.End();
                isLoadingService = false;
                throw;
            }
        }

    }

    #region tab1
    private async Task addGoiMakeupClick()
    {
        List<Data.DTOs.ListParaUser> datapara = await GetSPInfo.GetLoginUser("goiMakeupStu", newValueSP.ToUpper(), null);
        if (datapara != null && datapara.Any())
        {
            await JS.InvokeVoidAsync("alert", $"khóa makeup ({newValueSP}) đã tồn tại!");
        }
        else
        {
            isLoading = true;
            var random = new Random();
            string id = DateTime.Now.ToString("yyyyMMddHHmmss") + random.Next(10, 99);
            int checkInsert = await AddPara.InsertParamaterRawAsync("goiMakeupStu", newValueSP, id);
            if (checkInsert > 0)
            {
                List<Data.DTOs.ListParamaterMakeup> data = await GetListParamaterMakeup.GetParamaterMakeUp();
                this.ListGoimake = data.Where(x => x.KeyPara == "goiMakeupStu").ToDictionary(x => x.keyData1, x => x.keyData2);
                isLoading = false;
                await JS.InvokeVoidAsync("closeAllOptionMenus");
                await JS.InvokeVoidAsync("alert", $"Thêm khóa makeup ({newValueSP}) thành công!");
                newValueSP = "";
                StateHasChanged();
            }
            else
            {
                isLoading = false;
                await JS.InvokeVoidAsync("alert", $"Thêm khóa makeup ({newValueSP}) không thành công!");
            }
        }
    }

    private async Task XoaGoiMakeClick()
    {
        if (string.IsNullOrEmpty(SelectValueSP))
        {
            await JS.InvokeVoidAsync("alert", "Vui lòng chọn khóa makeup cần xóa trước");
            await JS.InvokeVoidAsync("closeAllOptionMenus");
            return;
        }
        bool confirmed = await JSx.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa khóa makeup này không?");

        if (confirmed)
        {
            isLoading = true;
            int checkInsert = await DeletePara.DeleteParamaterRawAsync("goiMakeupStu", SelectValueSP, null);
            if (checkInsert > 0)
            {
                List<Data.DTOs.ListParamaterMakeup> data = await GetListParamaterMakeup.GetParamaterMakeUp();
                this.ListGoimake = data.Where(x => x.KeyPara == "goiMakeupStu").ToDictionary(x => x.keyData1, x => x.keyData2);
                isLoading = false;
                await JS.InvokeVoidAsync("closeAllOptionMenus");
                await JS.InvokeVoidAsync("alert", $"Delete khóa makeup ({SelectValueSP}) thành công!");
                newValueSP = "";
                StateHasChanged();
            }
            else
            {
                isLoading = false;
                await JS.InvokeVoidAsync("alert", $"Delete khóa makeup ({newValueSP}) không thành công!");
            }
        }
    }

    private async Task addPriceClick()
    {
        isLoading = true;
        List<Data.DTOs.ListParaUser> datapara = await GetSPInfo.GetLoginUser("priceMakeupStu", newValuePrice, null);
        if (datapara != null && datapara.Any())
        {
            await JS.InvokeVoidAsync("alert", $"Giá khóa makeup ({newValuePrice}) đã tồn tại!");
            isLoading = false;
        }
        else
        {
            int checkInsert = await AddPara.InsertParamaterRawAsync("priceMakeupStu", newValuePrice, null);

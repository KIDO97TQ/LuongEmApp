            isLoading = true;
            int checkInsert = await DeletePara.DeleteParamaterRawAsync("priceMakeupStu", SelectValuePrice, null);
            if (checkInsert > 0)
            {
                List<Data.DTOs.ListParamaterMakeup> data = await GetListParamaterMakeup.GetParamaterMakeUp();
                this.ListPrice = data.Where(x => x.KeyPara == "priceMakeupStu")

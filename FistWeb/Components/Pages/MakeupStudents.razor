            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Thêm Giá khóa makeup ({newValuePrice}) không thành công!");
                isLoading = false;
            }
        }
    }

    private async Task XoaPriceClick()
    {
        if (string.IsNullOrEmpty(SelectValuePrice))
        {

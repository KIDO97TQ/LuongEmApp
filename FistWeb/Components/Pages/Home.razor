@page "/"
@rendermode InteractiveServer
@inject NavigationManager Navigation
@using FistWeb.Data.Services
@inject GetListThueDo GetListThueDo
@inject IGetParaUserService GetLoginUser
@inject IUpdatePWService UpdatePW
@inject IJSRuntime JS
@implements IDisposable
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<PageTitle>Home</PageTitle>

@if (isRestoring)
{
    <p>🔄 Đang kiểm tra trạng thái đăng nhập...</p>
}
else if (!isLoggedIn)
{
    <div class="full-screen-center">
        <div class="form-area">
            <div class="wrapper">
                @{
                    if (CheckforgotPW)
                    {
                        <h2>Xác nhận mật khẩu</h2>
                        <form @onsubmit:preventDefault="true">
                            <div class="box">
                                <input type="text" @bind="pass1" placeholder="Nhập mật khẩu mới..." />
                                <i class="fa fa-lock"></i>
                            </div>
                            <div class="box">
                                <input type="text" @bind="pass2" placeholder="Nhập lại mật khẩu..." />
                                <i class="fa fa-lock"></i>
                            </div>
                            @if (isLoading)
                            {
                                <div class="spinner" style="margin-top:10px;"></div>
                            }
                            else
                            {
                                <button type="button" @onclick="ChangePASS">Submit</button>
                            }
                        </form>
                    }
                    if (forgotPW)
                    {
                        <h2>Quên mật khẩu?</h2>
                        <form @onsubmit:preventDefault="true">
                            <div class="box">
                                <input type="text" @bind="FGusername" placeholder="Nhập tên đăng nhập..." />
                                <i class="fa fa-user"></i>
                            </div>
                            @if (isLoading)
                            {
                                <div class="spinner" style="margin-top:10px;"></div>
                            }
                            else
                            {
                                <button type="button" @onclick="GetNewPW">Submit</button>
                            }
                        </form>
                        <p><a href="#" @onclick="BackLogin">Back to Login</a></p>
                    }
                    else
                    {
                        if (!CheckforgotPW)
                        {
                            <h2>Admin Login</h2>
                            <form @onsubmit="LoginDB" @onsubmit:preventDefault="true">
                                <div class="box">
                                    <input type="text" @bind="username" placeholder="Nhập tên đăng nhập..." />
                                    <i class="fa fa-user"></i>
                                </div>
                                <div class="box">
                                    <input type="password" @bind="pass" placeholder="Nhập mật khẩu..." />
                                    <i class="fa fa-lock"></i>
                                </div>
                                <div class="options">
                                    <label>
                                        <input type="checkbox" @bind="rememberMe" /> Ghi nhớ đăng nhập
                                    </label>
                                    <a href="#" @onclick="ForgotPW">Quên mật khẩu?</a>
                                </div>

                                @if (isLoading)
                                {
                                    <div class="spinner" style="margin-top:10px;"></div>
                                }
                                else
                                {
                                    <button type="submit" @onclick="LoginDB">Submit</button>
                                }
                            </form>

                            <p>Don't have an account? <a href="#">Register</a></p>
                        }
                    }
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="full-screen-center">
        <div class="form-area">
            <div class="wrapper">
                <h2>Welcome @savedUsername!</h2>
                <button @onclick="Logout">Logout</button>
            </div>
        </div>
    </div>
}

@if (showLoginError)
{
    <div class="popup-bubble">
        @loginErrorMessage
    </div>
}

@code {
    private string username, FGusername;
    private string pass, pass1, pass2;
    private bool rememberMe = true;

    private bool forgotPW = false, CheckforgotPW = false;
    private bool isLoginPending = false;
    private bool isRestoring = true;
    private bool isLoading = false;
    private bool showLoginError = false;
    private string loginErrorMessage = "";
    private string savedUsername;
    private bool isLoggedIn = false;

    private bool _disposed = false;
    private CancellationTokenSource cts = new();

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
    }

    private async Task ForgotPW()
    {
        forgotPW = true;
        StateHasChanged();
    }

    private async Task ChangePASS()
    {
        if (pass1 != pass2)
        {
            await ShowErrorAsync("Mật khẩu không khớp!");
            return;
        }
        if (string.IsNullOrEmpty(pass1) || string.IsNullOrEmpty(pass2))
        {
            await ShowErrorAsync("Vui lòng nhập mật khẩu mới!");
            return;
        }
        isLoading = true;
        bool res = await UpdatePW.UpdatePasswordAsync(pass1);
        if (res)
        {
            await ShowErrorAsync("Đổi mật khẩu thành công!");
            forgotPW = false;
            CheckforgotPW = false;
            pass1 = "";
            pass2 = "";
            FGusername = "";
        }
        else
        {
            await ShowErrorAsync("Đổi mật khẩu thất bại!");
        }
        isLoading = false;
        StateHasChanged();
    }

    private async Task GetNewPW()
    {
        isLoading = true;
        List<Data.DTOs.ListParaUser> datapara = await GetLoginUser.GetLoginUser("admin", FGusername, null);
        if (datapara != null && datapara.Any())
        {
            FGusername = datapara[0].keyUsername;
            CheckforgotPW = true;
            forgotPW = false;
        }
        else
        {
            await ShowErrorAsync("Tài khoản không tồn tại!");
        }
        isLoading = false;
        StateHasChanged();
    }
    private async Task BackLogin()
    {
        forgotPW = false;
    }
    private async Task LoginDB()
    {
        if (isLoginPending) return;
        isLoginPending = true;
        isLoading = true;
        StateHasChanged();

        string u = username?.Trim();
        string p = pass?.Trim();

        if (string.IsNullOrEmpty(u) || string.IsNullOrEmpty(p))
        {
            await ShowErrorAsync("Vui lòng nhập tài khoản và mật khẩu");
            isLoading = false;
            isLoginPending = false;
            return;
        }

        try
        {
            List<Data.DTOs.ListParaUser> datapara = await GetLoginUser.GetLoginUser("admin", username, pass);
            if (datapara != null && datapara.Any())
            {
                isLoggedIn = true;
                savedUsername = u;

                if (rememberMe)
                {
                    await localStorage.SetItemAsync("isLoggedIn", true);
                    await localStorage.SetItemAsync("username", u);
                }
                Navigation.NavigateTo("/", true);
            }
            else
            {
                await ShowErrorAsync("Tài khoản hoặc mật khẩu không đúng");
            }
        }
        finally
        {
            isLoading = false;
            isLoginPending = false;
            StateHasChanged();
        }
    }

    private async Task ShowErrorAsync(string message)
    {
        loginErrorMessage = message;
        showLoginError = true;
        StateHasChanged();

        await Task.Delay(1400);

        showLoginError = false;
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var loginResult = await JS.InvokeAsync<string>("localStorage.getItem", "isLoggedIn");
                if (loginResult == "true")
                {
                    var user = await JS.InvokeAsync<string>("localStorage.getItem", "username");
                    isLoggedIn = true;
                    savedUsername = user.Trim('\"');
                }
            }
            catch { }

            isRestoring = false;
            if (!_disposed)
            {
                StateHasChanged();
            }
        }
    }

    private async Task Logout()
    {
        await localStorage.RemoveItemAsync("isLoggedIn");
        await localStorage.RemoveItemAsync("username");

        isLoggedIn = false;
        username = string.Empty;
        pass = string.Empty;
        savedUsername = string.Empty;
        Navigation.NavigateTo("/", true);
        StateHasChanged();
    }
}

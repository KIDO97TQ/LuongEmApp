    <button class="tab-btn" data-tab="tab2">
        <img src="cameralist.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Tổng hợp lịch chụp
    </button>
    <button class="tab-btn @(IsAdminUser ? "" : "d-none")" data-tab="tab3">

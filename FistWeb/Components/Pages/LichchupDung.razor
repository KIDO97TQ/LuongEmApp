    private async Task AddLichChup()
    {
        try
        {
            if (TextValueQTY <= 0) { await JS.InvokeVoidAsync("alert", "Vui lòng điền số lượng!"); return; }
            if (string.IsNullOrEmpty(SelectValueNhanJob) || string.IsNullOrEmpty(TextValueNameKH) || !ngayGioChup.HasValue)
            { await JS.InvokeVoidAsync("alert", "Vui lòng điền đầy đủ thông tin!"); return; }

            UpdateisLoading = true;
            long productID = long.Parse(DateTime.Now.ToString("yyyyMMddHHmmss"));

            #region Xử lý nén ảnh và Upload
            if (fileStream == null || uploadedFile == null)
            {
                await JS.InvokeVoidAsync("alert", "Chưa chọn ảnh");
                UpdateisLoading = false;
                return;
            }

            string fileName = productID.ToString();

            // Thực hiện nén ảnh trước khi upload
            string imageUrl = "";

            fileStream.Position = 0;
            using (var outputStream = new MemoryStream())
            {
                using (var image = await Image.LoadAsync(fileStream))
                {
                    int maxWidth = 1200;
                    if (image.Width > maxWidth)
                    {
                        image.Mutate(x => x.Resize(maxWidth, 0));
                    }

                    var encoder = new JpegEncoder { Quality = 75 };
                    await image.SaveAsJpegAsync(outputStream, encoder);
                }

                imageUrl = await UploadToCloudinaryAsync(outputStream, fileName);
            }

            if (string.IsNullOrEmpty(imageUrl))
            {
                UpdateisLoading = false;
                await JS.InvokeVoidAsync("alert", "Upload ảnh thất bại!");
                return;
            }
            #endregion

            string Tienorder = SelectValuePrice.Replace(".", "").Replace(",", "").Replace(" vnđ", "").Trim();
            decimal money = decimal.TryParse(Tienorder, out decimal m) ? m : 0;
            decimal total = money * TextValueQTY;

            // Lưu Database
            int checkInsert = await AddOrderChup.InsertRevenueWedding(
                productID.ToString(), TextValueNameKH, total, "Dũng", ngayGioChup, ngayTraFile, null,
                TextValueDesc, productID, TextValueQTY, SelectValueThoMake, SelectValueThoToc, SelectValueNhanJob, imageUrl);

            if (checkInsert > 0)
            {
                // Reset form
                await ResetForm();
                await TimKiem();

                var dataResponse = await GetListChup.GetListChupWedding(null, null, null);
                allData = dataResponse.Items;

                await JS.InvokeVoidAsync("alert", "Thêm lịch chụp mới thành công!");
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Lưu thông tin thất bại!");
            }

            UpdateisLoading = false;
        }
        catch (Exception ex)
        {
            UpdateisLoading = false;
            await JS.InvokeVoidAsync("alert", $"Lỗi hệ thống: {ex.Message}");
        }
    }


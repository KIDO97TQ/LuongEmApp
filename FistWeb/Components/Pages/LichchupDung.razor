    private async Task<bool> UploadImageToGitHubAsync(string tokennnn, string owner, string repo, string pathInRepo, string base64Content, string commitMessage)
    {
        using var http = new HttpClient();

        http.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("token", tokennnn);

        http.DefaultRequestHeaders.UserAgent.ParseAdd("BlazorUploader");
        string putUrl = $"https://api.github.com/repos/{owner}/{repo}/contents/{pathInRepo}";

        var payload = new
        {
            message = commitMessage,
            content = base64Content,
            branch = "main"
        };

        var json = JsonSerializer.Serialize(payload);

        var request = new HttpRequestMessage(HttpMethod.Put, putUrl)
        {
            Content = new StringContent(json, Encoding.UTF8, "application/json")
        };

        var response = await http.SendAsync(request);
        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            string message = $"❌ GitHub PUT error: {response.StatusCode} - {error}";
            await JS.InvokeVoidAsync("alert", $"Lỗi khi upload ảnh: {message}");

            return false;
        }

        return response.IsSuccessStatusCode;
    }


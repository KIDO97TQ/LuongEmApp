@page "/Lichchup"
@using Microsoft.EntityFrameworkCore
@using System.Data
@using System.Text.Json
@using FistWeb.Data.Services
@using System.Text.RegularExpressions
@inject Data.AppDbContext Db
@inject IGetParamaterMakeupService GetListParamaterMakeup
@rendermode InteractiveServer
@inject IJSRuntime JS
@using System.Globalization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@using System.Text
@inject NavigationManager Navigation
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject IGetParaUserService GetSPInfo
@inject IAddParaService AddPara
@inject IDeleteParaService DeletePara
@inject IGetParaUserService GetUserInfo
@implements IDisposable
@inject IInsertRevenueWeddingService AddOrderChup
@inject IGetSumRevenueWeddingService GetSumChup
@inject IGetListWeddingService GetListChup
@inject LoadingService LoadingService


<div class="tabs">
    <button class="tab-btn active" data-tab="tab1">
        <img src="makeup-artist.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Thêm lịch Chụp
    </button>
    <button class="tab-btn" data-tab="tab2">
        <img src="customer.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Tổng hợp lịch chụp
    </button>
    <button class="tab-btn" data-tab="tab3">
        <img src="pie-chart.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Doanh thu chụp
    </button>
</div>

@* tab1 *@
<div class="tab-content active" id="tab1">
    <div class="form-container">
        <div class="form-section-left">
            <!-- Tên KH -->
            <div class="form-group">
                <label class="form-label required-label">Tên khách chụp:</label>
                <input type="text" @bind="TextValueNameKH" @bind:event="oninput" class="form-input" placeholder="Nhập tên khách chụp..." />
                <div></div>
            </div>

            <!-- Gói chụp -->
            <div class="form-group">
                <label class="form-label required-label">Chọn gói chụp:</label>
                <select class="form-select" @bind="SelectValueSP" @bind:event="oninput">
                    <option value="">Chọn gói chụp</option>
                    @{
                        if (this.ListGoimake != null && !isLoading)
                        {
                            foreach (var item in this.ListGoimake)
                            {
                                <option value="@item.Key">@item.Key</option>
                            }
                        }
                    }
                </select>
                @if (isLoading)
                {
                    <div class="spinner" style="margin-top:10px;"></div>
                }
                else
                {
                    <div class="option-wrapper">
                        <button class="btn btn-option" onclick="toggleOptionMenu(this)"><span>...</span> Option</button>
                        <div class="option-menu">
                            <div class="New-price">
                                <input id="priceInput" type="text"
                                       @bind="newValueSP"
                                       @bind:event="oninput"
                                       placeholder="Thêm mới gói chụp..." />

                                <button class="option-itemAdd" type="button" @onclick="addGoiChupClick">
                                    <i class="bi-option bi-plus-circle-fill"></i>
                                </button>
                            </div>
                            <div class="option-item" @onclick="XoaGoiChupClick">🗑️ Xóa gói chụp đang chọn</div>

                        </div>
                    </div>
                }
            </div>

            <!-- Tên thợ chụp -->
            <div class="form-group">
                <label class="form-label required-label">Thợ chụp:</label>
                <select class="form-select" @bind="nameThochup" @bind:event="oninput">
                    <option value="">Chọn thợ chụp</option>
                    <option value="@nameThochup">Dũng</option>
                    <option value="@nameThochup">Long</option>
                    }
                </select>
            </div>

            <!-- Giá gói chụp -->
            <div class="form-group">
                <label class="form-label required-label">Giá gói chụp:</label>
                <select class="form-select" @bind="SelectValuePrice" @bind:event="oninput">
                    <option value="">Chọn giá gói chụp</option>
                    @{
                        if (this.ListPrice != null && !isLoading)
                        {
                            @foreach (var item in this.ListPrice)
                            {
                                if (decimal.TryParse(item, NumberStyles.Number, new CultureInfo("vi-VN"), out var parsedValue))
                                {
                                    <option value="@item">@parsedValue.ToString("N0", new CultureInfo("vi-VN")) Vnđ</option>
                                }
                            }
                        }
                    }
                </select>
                @if (isLoading)
                {
                    <div class="spinner" style="margin-top:10px;"></div>
                }
                else
                {
                    <div class="option-wrapper">
                        <button class="btn btn-option" onclick="toggleOptionMenu(this)"><span>...</span> Option</button>

                        <div class="option-menu">
                            <div class="New-price">
                                <input id="priceInput" type="text"
                                       @bind="newValuePrice"
                                       placeholder="Thêm mới giá gói chụp..."
                                       @oninput="OnPriceInput"
                                       autofocus />
                                <button class="option-itemAdd" type="button" @onclick="addPriceClick">
                                    <i class="bi-option bi-plus-circle-fill"></i>
                                </button>
                            </div>
                            <div class="option-item" @onclick="XoaPriceClick">🗑️ Xóa giá gói chụp đang chọn</div>
                        </div>
                    </div>
                }
            </div>

            <!-- Ngày Chup -->
            <div class="form-group">
                <label class="form-label required-label">Ngày chụp:</label>
                <input type="datetime-local"
                       class="form-control"
                       value="@ngayGioChupString"
                       @onchange="UpdateNgayGioChup" />
            </div>

            <!-- Ngày trả file -->
            <div class="form-group">
                <label class="form-label required-label">Ngày trả File:</label>
                <input type="date"
                       class="form-control"
                       @bind-value="ngayTraFile"
                       @bind-value:format="yyyy-MM-dd" />
            </div>

            <!-- Ngày cưới -->
            <div class="form-group">
                <label class="form-label required-label">Ngày Cưới:</label>
                <input type="date"
                       class="form-control"
                       @bind-value="ngayCuoi"
                       @bind-value:format="yyyy-MM-dd" />
            </div>

            <!-- Mô tả thêm -->
            <div class="form-group">
                <label class="form-label">Note:</label>
                <textarea class="form-input" @bind="TextValueDesc" @bind:event="oninput" rows="4" placeholder="Lưu ý....."></textarea>
                <div></div>
            </div>

            <div class="store-info">
                @if (UpdateisLoading)
                {
                    <div class="spinner" style="margin-top:10px;"></div>
                }
                else
                {
                    <button class="button-add" type="button" @onclick="AddLichChup"><i class="bi bi-check2-circle"></i>THÊM GÓI CHỤP</button>
                }
            </div>
        </div>
    </div>
</div>

@* tab2 *@
<div class="tab-content tab2" id="tab2">
    @if (isLoading)
    {
        <div> ⏳ Đang tải dữ liệu...</div>
    }
    else
    {
        <h3 class="header-controls">
            <div class="controls-left">
                Gói chụp
                <select class="control-select" value="type" @onchange="OnTypeChanged">
                    @{
                        if (this.ListGoimake != null && !isLoading)
                        {
                            <option value="All">All</option>
                            foreach (var item in this.ListGoimake)
                            {
                                <option value="@item.Key">@item.Key</option>
                            }
                        }
                    }
                </select>
                Thợ chụp
                <select class="control-select" value="type" @onchange="OnThoChupChanged">
                    @{
                        <option value="All">All</option>
                        <option value="Dũng">Dũng</option>
                        <option value="Long">Long</option>
                    }
                </select>
                Tháng
                <select class="control-select" value="month" @onchange="OnMonthChanged1">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i.ToString("D2")">@i.ToString("D2")</option>
                    }
                </select>

                <button class="Reset" type="button" @onclick="Reset">
                    <img src="return.png" alt="icon" style="width: 37px; height: 33px;">
                </button>
            </div>
        </h3>

        <!-- Hàng ngày cập nhật theo tháng -->
        <div class="month-days">
            @for (int day = 1; day <= DaysofMonth(selectedYear, selectedMonth); day++)
            {
                var currentDay = day;

                <div class="day-cell @(HasEventOnDay(currentDay) ? "has-event" : "")"
                     @onclick="() => OnDayClicked(currentDay)">
                    @currentDay
                </div>
            }

            @* @for (int day = 1; day <= DaysofMonth(selectedYear, selectedMonth); day++)
            {
                <div class="day-cell @(HasEventOnDay(day) ? "has-event" : "")"
                     @onclick="() => OnDayClicked(day)">
                    @day
                </div>
            } *@
        </div>

        <div class="chart-order">
            @*Hiện lên table*@
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Stt</th>
                        <th>Tên thợ</th>
                        <th>Tên khách</th>
                        <th>Gói chụp</th>
                        <th>Giá gói chụp</th>
                        <th>Ngày chụp</th>
                        <th>Ngày trả File</th>
                        <th>Ngày Cưới</th>
                        <th>Ngày tạo</th>
                    </tr>
                </thead>
                <tbody>
                    @if (currentPageData != null && currentPageData.Any())
                    {
                        int count = (currentPage - 1) * rowsPerPage + 1;
                        foreach (var item in currentPageData)
                        {
                            <tr>
                                <td data-label="STT">@count</td>
                                <td data-label="Thợ chụp">@item.Photograper</td>
                                <td data-label="Tên khách">@item.namekh</td>
                                <td data-label="Gói chụp">@item.type</td>
                                <td data-label="Giá gói chụp">@item.price.ToString("N0", new CultureInfo("vi-VN")) vnđ</td>
                                <td data-label="Ngày chụp">@item.dateChup.ToString("dd/MM/yyyy HH:mm")</td>
                                <td data-label="Ngày trả File">@item.dateTraFile.ToString("dd/MM/yyyy HH:mm")</td>
                                <td data-label="Ngày Cưới">@item.dateCuoi.ToString("dd/MM/yyyy HH:mm")</td>
                                <td data-label="Ngày tạo">@item.createdate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                            count++;
                        }
                    }
                    else if (checkNull)
                    {
                        <tr>
                            <td colspan="13" style="text-align:center">❌ Không có dữ liệu.</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="13" style="text-align:center">⏳ Đang tải dữ liệu...</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination">
            <button @onclick="PrevPage" disabled="@(!CanPrev)">
                <i class="fa-solid fa-arrow-left"></i> Trước
            </button>
            <span>Trang @currentPage / @totalPages</span>
            <button @onclick="NextPage" disabled="@(!CanNext)">
                Sau <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>
    }
</div>

@* tab3 *@

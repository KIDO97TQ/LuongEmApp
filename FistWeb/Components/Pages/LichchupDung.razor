                        <option value="Long">Long</option>
                    </select>
                </div>
                <div class="staff-controls">
                    <label class="label-ca">Tháng: </label>
                    <select class="control-select" value="Month" @onchange="OnMonthChanged">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i.ToString("D2")">@i.ToString("D2")</option>
                        }

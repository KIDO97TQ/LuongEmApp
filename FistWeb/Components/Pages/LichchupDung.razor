        <div class="chart-card">
            <div class="staff-header">
                <h3 class="card-title">
                    <img src="statistics.png" alt="icon" style="width: 35px; height: 35px; margin-right: 6px;">
                    Tổng doanh thu chụp năm @year
                </h3>
                <div class="staff-controls">
                    <select class="control-select" value="year" @onchange="OnYearChanged">
                        <option value="@yearFix1">@yearFix1</option>
                        <option value="@yearFix0">@yearFix0</option>
                        <option value="@yearFix2">@yearFix2</option>
                    </select>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="Doanhthunam"></canvas>
                <h4 class="chart-legend">Tổng doanh thu năm @year: @tongDoanhThuNam.ToString("N0") Vnđ</h4>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', function() {
    // đổi active trên nút
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');

    // đổi nội dung hiển thị
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    document.getElementById(this.dataset.tab).classList.add('active');
    });
    });
</script>


@code {
    private DateTime? ngayGioChup, ngayCuoi, ngayTraFile;
    private string month;
    private string year;
    private List<Data.DTOs.ListParamaterMakeup> datapara = new();
    private List<Data.DTOs.ProductStock> dataWH = new();
    Dictionary<string, string> ListGoimake;
    List<string> ListPrice;
    private bool isLoading = true, UpdateisLoading = false, UpdateisLoading2 = false;
    private string SelectValueSP, TextValueNameKH, SelectValuePrice, newValueSP, newValuePrice, nameThochup, TextValueDesc;
    private string typeSelect, typeWHSelect;
    [Inject] private IJSRuntime JSx { get; set; }
    private bool isLoadingService = true;
    private bool _disposed = false;
    private CancellationTokenSource cts = new();
    public void Dispose()
    {
        _disposed = true;
        cts.Cancel();
        cts.Dispose();
    }
    private string ngayGioChupString => ngayGioChup?.ToString("yyyy-MM-ddTHH:mm") ?? "";

    private void UpdateNgayGioChup(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
            ngayGioChup = dt;
    }

    protected override async Task OnInitializedAsync()
    {
        this.month = DateTime.Now.Month.ToString();
        this.year = DateTime.Now.Year.ToString();
        this.yearFix0 = DateTime.Now.Year.ToString();
        this.yearFix1 = (DateTime.Now.Year - 1).ToString();
        this.yearFix2 = (DateTime.Now.Year + 1).ToString();
        UpdateDays();
    }

    private ValueTask OnBeforeNavigation(LocationChangingContext context)
    {
        if (isLoadingService)
        {
            context.PreventNavigation();
        }
        return ValueTask.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {

                LoadingService.Begin();
                bool isLoggedIn = await localStorage.GetItemAsync<bool>("isLoggedIn");
                if (isLoggedIn)
                {
                    isLoading = true;
                    //await GetMaterialInWH(true, false);
                    await TimKiem();
                    datapara = await GetListParamaterMakeup.GetParamaterMakeUp();
                    this.ListGoimake = datapara.Where(x => x.KeyPara == "goiChupWedding").ToDictionary(x => x.keyData1, x => x.keyData2);
                    this.ListPrice = datapara.Where(x => x.KeyPara == "priceGoiChup")
                                         .OrderBy(x =>
                                         {
                                             if (decimal.TryParse(x.keyData1, out var number))
                                                 return number;
                                             return decimal.MaxValue;
                                         })
                                         .Select(x => x.keyData1)
                                         .ToList();
                    await LoadData(this.type_, null, null, thochup_);
                    isLoading = false;
                    if (!_disposed)
                    {
                        StateHasChanged();
                    }
                    LoadingService.End();
                    isLoadingService = false;
                }
                else
                {
                    LoadingService.End();
                    isLoadingService = false;
                    Navigation.NavigateTo("/", true);

                }
            }
            catch (Exception)
            {
                LoadingService.End();
                isLoadingService = false;
                throw;
            }
        }

    }

    #region tab1
    private async Task addGoiChupClick()
    {
        List<Data.DTOs.ListParaUser> datapara = await GetSPInfo.GetLoginUser("goiChupWedding", newValueSP.ToUpper(), null);
        if (datapara != null && datapara.Any())
        {
            await JS.InvokeVoidAsync("alert", $"Gói chụp ({newValueSP}) đã tồn tại!");
        }
        else
        {
            isLoading = true;
            var random = new Random();
            string id = DateTime.Now.ToString("yyyyMMddHHmmss") + random.Next(10, 99);
            int checkInsert = await AddPara.InsertParamaterRawAsync("goiChupWedding", newValueSP, id);
            if (checkInsert > 0)
            {
                List<Data.DTOs.ListParamaterMakeup> data = await GetListParamaterMakeup.GetParamaterMakeUp();
                this.ListGoimake = data.Where(x => x.KeyPara == "goiChupWedding").ToDictionary(x => x.keyData1, x => x.keyData2);
                isLoading = false;
                await JS.InvokeVoidAsync("closeAllOptionMenus");
                await JS.InvokeVoidAsync("alert", $"Thêm gói chụp ({newValueSP}) thành công!");
                newValueSP = "";
                StateHasChanged();
            }
            else
            {
                isLoading = false;
                await JS.InvokeVoidAsync("alert", $"Thêm gói chụp ({newValueSP}) không thành công!");
            }
        }
    }

    private async Task XoaGoiChupClick()
    {
        if (string.IsNullOrEmpty(SelectValueSP))
        {
            await JS.InvokeVoidAsync("alert", "Vui lòng chọn gói chụp cần xóa trước");
            await JS.InvokeVoidAsync("closeAllOptionMenus");
            return;
        }
        bool confirmed = await JSx.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa gói chụp này không?");

        if (confirmed)
        {
            isLoading = true;
            int checkInsert = await DeletePara.DeleteParamaterRawAsync("goiChupWedding", SelectValueSP, null);
            if (checkInsert > 0)
            {
                List<Data.DTOs.ListParamaterMakeup> data = await GetListParamaterMakeup.GetParamaterMakeUp();
                this.ListGoimake = data.Where(x => x.KeyPara == "goiChupWedding").ToDictionary(x => x.keyData1, x => x.keyData2);
                isLoading = false;
                await JS.InvokeVoidAsync("closeAllOptionMenus");
                await JS.InvokeVoidAsync("alert", $"Delete gói chụp ({SelectValueSP}) thành công!");
                newValueSP = "";
                StateHasChanged();
            }
            else
            {
                isLoading = false;
                await JS.InvokeVoidAsync("alert", $"Delete gói chụp ({newValueSP}) không thành công!");
            }
        }
    }

    private async Task addPriceClick()
    {
        isLoading = true;
        List<Data.DTOs.ListParaUser> datapara = await GetSPInfo.GetLoginUser("priceGoiChup", newValuePrice, null);
        if (datapara != null && datapara.Any())
        {
            await JS.InvokeVoidAsync("alert", $"Giá gói chụp ({newValuePrice}) đã tồn tại!");
            isLoading = false;
        }
        else
        {
            int checkInsert = await AddPara.InsertParamaterRawAsync("priceGoiChup", newValuePrice, null);
            if (checkInsert > 0)
            {

                List<Data.DTOs.ListParamaterMakeup> data = await GetListParamaterMakeup.GetParamaterMakeUp();
                this.ListPrice = data.Where(x => x.KeyPara == "priceGoiChup")
                                     .OrderBy(x =>
                                     {
                                         if (decimal.TryParse(x.keyData1, out var number))
                                             return number;
                                         return decimal.MaxValue;
                                     })
                                     .Select(x => x.keyData1)
                                     .ToList();
                isLoading = false;
                await JS.InvokeVoidAsync("closeAllOptionMenus");
                await JS.InvokeVoidAsync("alert", $"Thêm Giá gói chụp ({newValuePrice}) thành công!");
                newValuePrice = "";
                StateHasChanged();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Thêm Giá gói chụp ({newValuePrice}) không thành công!");
                isLoading = false;
            }
        }
    }

    private async Task XoaPriceClick()
    {
        if (string.IsNullOrEmpty(SelectValuePrice))
        {
            await JS.InvokeVoidAsync("alert", "Vui lòng chọn giá gói chụp cần xóa trước");
            await JS.InvokeVoidAsync("closeAllOptionMenus");
            return;
        }
        bool confirmed = await JSx.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa giá gói chụp này không?");

        if (confirmed)
        {
            isLoading = true;
            int checkInsert = await DeletePara.DeleteParamaterRawAsync("priceGoiChup", SelectValuePrice, null);
            if (checkInsert > 0)
            {
                List<Data.DTOs.ListParamaterMakeup> data = await GetListParamaterMakeup.GetParamaterMakeUp();
                this.ListPrice = data.Where(x => x.KeyPara == "priceGoiChup")
                                     .OrderBy(x =>
                                     {
                                         if (decimal.TryParse(x.keyData1, out var number))
                                             return number;
                                         return decimal.MaxValue;
                                     })
                                     .Select(x => x.keyData1)
                                     .ToList();
                await JS.InvokeVoidAsync("closeAllOptionMenus");
                await JS.InvokeVoidAsync("alert", $"Delete giá gói chụp ({SelectValuePrice}) thành công!");
                newValueSP = "";
                isLoading = false;
                StateHasChanged();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Delete giá gói chụp ({SelectValuePrice}) không thành công!");
            }
        }
    }

    private void OnPriceInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";

        var digitsOnly = new string(input.Where(char.IsDigit).ToArray());

        if (string.IsNullOrEmpty(digitsOnly))
        {
            newValuePrice = "";
            return;
        }

        if (int.TryParse(digitsOnly, out int number))
        {
            var culture = new CultureInfo("vi-VN");
            newValuePrice = number.ToString("N0", culture);
        }
        else
            newValuePrice = "";
    }

    private async Task AddLichChup()
    {
        try
        {
            //SelectValueSP,TextValueNameSP,SelectValuePrice
            if (string.IsNullOrEmpty(SelectValueSP) || string.IsNullOrEmpty(SelectValuePrice) || string.IsNullOrEmpty(TextValueNameKH) || string.IsNullOrEmpty(nameThochup)
            || !ngayGioChup.HasValue || !ngayTraFile.HasValue || !ngayCuoi.HasValue)
            {
                await JS.InvokeVoidAsync("alert", $"Vui lòng điền đầy đủ thông tin trước!");
                return;
            }
            UpdateisLoading = true;

            string id = ListGoimake[SelectValueSP];

            string cleanedGiaTheoNgay = SelectValuePrice.Replace(".", "").Replace(",", "").Replace(" Vnđ", "").Trim();
            bool parseGiaOk = decimal.TryParse(cleanedGiaTheoNgay, out decimal gia);

            int checkInsert = await AddOrderChup.InsertRevenueWedding(id, TextValueNameKH, gia, nameThochup, ngayGioChup, ngayTraFile, ngayCuoi, TextValueDesc);
            if (checkInsert > 0)
            {
                SelectValuePrice = null;
                SelectValueSP = null;
                TextValueNameKH = null;
                nameThochup = null;
                ngayGioChup = null;
                ngayTraFile = null;
                ngayCuoi = null;
                TextValueDesc = null;
                await TimKiem();
                allData = await GetListChup.GetListChupWedding("goiChupWedding", null, null, null, "");
                await JS.InvokeVoidAsync("alert", "Thêm lịch chụp mới ok!");
                LoadPage();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Upload thất bại");
            }
            UpdateisLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Lỗi khi upload: {ex.Message}");
        }
    }

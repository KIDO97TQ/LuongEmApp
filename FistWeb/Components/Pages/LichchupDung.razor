    public async Task<object> Getdoanhthuthang(int nam, int thang, int ngay, string thochup)
    {
        if (ngay == 0)
            Doanhthuthang = await GetSumChup.SumGetListWedding("goiChupWedding", nam, thang, null, thochup);
        else
            Doanhthuthang = await GetSumChup.SumGetListWedding("goiChupWedding", nam, thang, ngay, thochup);
        tongdoanhthuthang = (double)Doanhthuthang.Sum(x => x.Reverue);


        var labels = Doanhthuthang
            .Select(x => x.Date.Date.ToString("MM/yyyy"))
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        // Nhóm theo loại sản phẩm
        var productGroups = Doanhthuthang
            .GroupBy(x => x.Type)
            .ToDictionary(
                g => g.Key,
                g => labels.Select(label =>
                    g.Where(x => x.Date.Date.ToString("MM/yyyy") == label)
                     .Sum(x => x.Reverue)
                ).ToList()
            );

        // Tạo datasets
        var datasets = productGroups.Select(g => new
        {
            label = g.Key,
            data = g.Value,
            backgroundColor = GetRandomColor(),
            borderColor = "'rgba(79, 195, 247, 0.1)",
            borderWidth = 1,
            fill = true,
            tension = 0.4
        }).ToList();

        // Tạo chartData
        var chartData = new
        {
            labels = labels,
            datasets = datasets
        };
        return chartData;
    }


@* tab1 *@
<div class="tab-content active" id="tab1">
    <div class="form-container">
        <div class="form-content">

            <div class="form-section-right">
                <label for="fileInput" class="image-upload-area">
                    @if (!openImage)
                    {
                        <div class="image-upload-icon">📷</div>
                        <div class="image-upload-text">Click để tải ảnh lên</div>
                    }
                    <img src="@previewImageUrl" style="max-width: 100%; margin-top: 10px;" />
                </label>
                <InputFile id="fileInput" OnChange="OnFileSelected" accept="image/*" style="display:none" />
            </div>
            @* @if (!string.IsNullOrEmpty(imageid))
            {
                <div class="form-section-right">
                    <label for="fileInput" class="image-upload-area">
                        <img src="@($"https://raw.githubusercontent.com/kido1997/ImageLuongEm/main/ImageLuongEm/{imageid}.jpg")" style="max-width: 100%; margin-top: 10px;" />
                    </label>
                </div>
            } *@
            <div class="form-section-left">
                <!-- Tên KH -->
                <div class="form-group">
                    <label class="form-label required-label">Tên khách chụp:</label>
                    <input type="text" @bind="TextValueNameKH" @bind:event="oninput" class="form-input" placeholder="Nhập tên khách chụp..." />
                    <div></div>
                </div>

                <!-- NV MAKE -->
                <div class="form-group">
                    <label class="form-label required-label">Chọn nhân viên Make:</label>

                    <select class="form-select"
                            value="@SelectValueThoMake"
                            @onchange="OnChangeHandlerNVmake">
                        <option value="">Chọn nhân viên Make</option>
                        @if (ListNv != null && !isLoading)
                        {
                            foreach (var item in ListNv)
                            {
                                <option value="@item.Key">@item.Key</option>
                            }
                        }
                    </select>
                    @if (isLoading)
                    {
                        <div class="spinner" style="margin-top:10px;"></div>
                    }
                    else
                    {
                        <div class="option-wrapper">
                            <button class="btn btn-option" onclick="toggleOptionMenu(this)"><span>...</span> Option</button>

                            <div class="option-menu">
                                <div class="New-price">
                                    <input id="priceInput" type="text"
                                           @bind="newValueNV"
                                           @bind:event="oninput"
                                           placeholder="Thêm mới Nhân viên..." />
                                    @if (isLoading)
                                    {
                                        <div class="spinner" style="margin-top:10px;"></div>
                                    }
                                    else
                                    {
                                        <button class="option-itemAdd" type="button" @onclick="addNVClick">
                                            <i class="bi-option bi-plus-circle-fill"></i>
                                        </button>
                                    }
                                </div>
                                <div class="option-item" @onclick="XoaNVClick">🗑️ Xóa nhân viên đang chọn</div>
                            </div>
                        </div>
                    }

                    @* @if (!isLoading)
                    {
                        <div class="form-section-right">
                            <label for="fileInput" class="image-upload-area">
                                @if (!openImage)
                                {
                                    <div class="image-upload-icon">📷</div>
                                    <div class="image-upload-text">Click để tải ảnh lên</div>
                                }
                                <img src="@previewImageUrl" style="max-width: 100%; margin-top: 10px;" />
                            </label>
                            <InputFile id="fileInput" OnChange="OnFileSelected" accept="image/*" style="display:none" />
                        </div>
                    } *@
                </div>

                <!-- NV TOC -->
                <div class="form-group">
                    <label class="form-label required-label">Chọn nhân viên làm tóc:</label>

                    <select class="form-select"
                            value="@SelectValueThoToc"
                            @onchange="OnChangeHandlerNVtoc">
                        <option value="">Chọn nhân viên làm tóc </option>
                        @if (ListNv != null && !isLoading)
                        {
                            foreach (var item in ListNv)
                            {
                                <option value="@item.Key">@item.Key</option>
                            }
                        }
                    </select>
                </div>

                <!-- NV nhận job -->
                <div class="form-group">
                    <label class="form-label required-label">Chọn nhân viên nhận Job:</label>

                    <select class="form-select"
                            value="@SelectValueNhanJob"
                            @onchange="OnChangeHandlerIDnvNhanJob">
                        <option value="">Chọn nhân viên nhận Job </option>
                        @if (ListNv != null && !isLoading)
                        {
                            foreach (var item in ListNv)
                            {
                                <option value="@item.Key">@item.Key</option>
                            }
                        }
                    </select>
                </div>

                <!-- Số lượng -->
                <div class="form-group">
                    <label class="form-label required-label">Số lượng:</label>
                    <input type="text" inputmode="numeric" pattern="[0-9]*"
                           maxlength="2" @bind="TextValueQTY" @bind:event="oninput"
                           class="form-input" placeholder="Nhập số lượng..." min="1" />
                    <div></div>
                </div>


                <!-- Tên thợ chụp -->
                @* <div class="form-group">
                    <label class="form-label required-label">Thợ chụp:</label>
                    <select class="form-select" @bind="nameThochup" @bind:event="oninput">
                        <option value="">Chọn thợ chụp</option>
                        <option value="@nameThochup">Dũng</option>
                        <option value="@nameThochup">Long</option>
                    </select>
                </div> *@

                <!-- Giá gói chụp -->
                <div class="form-group">
                    <label class="form-label required-label">Giá gói chụp:</label>
                    <select class="form-select" @bind="SelectValuePrice" @bind:event="oninput">
                        <option value="">Chọn giá gói chụp</option>
                        @{
                            if (this.ListPrice != null && !isLoading)
                            {
                                @foreach (var item in this.ListPrice)
                                {
                                    if (decimal.TryParse(item, NumberStyles.Number, new CultureInfo("vi-VN"), out var parsedValue))
                                    {
                                        <option value="@item">@parsedValue.ToString("N0", new CultureInfo("vi-VN")) Vnđ</option>
                                    }
                                }
                            }
                        }
                    </select>
                    @if (isLoading)
                    {
                        <div class="spinner" style="margin-top:10px;"></div>
                    }
                    else
                    {
                        <div class="option-wrapper">
                            <button class="btn btn-option" onclick="toggleOptionMenu(this)"><span>...</span> Option</button>

                            <div class="option-menu">
                                <div class="New-price">
                                    <input id="priceInput" type="text"
                                           @bind="newValuePrice"
                                           placeholder="Thêm mới giá gói chụp..."
                                           @oninput="OnPriceInput"
                                           autofocus />
                                    @if (isLoading)
                                    {
                                        <div class="spinner" style="margin-top:10px;"></div>
                                    }
                                    else
                                    {
                                        <button class="option-itemAdd" type="button" @onclick="addPriceClick">
                                            <i class="bi-option bi-plus-circle-fill"></i>
                                        </button>
                                    }
                                </div>
                                <div class="option-item" @onclick="XoaPriceClick">🗑️ Xóa giá gói chụp đang chọn</div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Ngày Chup -->
                <div class="form-group">
                    <label class="form-label required-label">Ngày chụp:</label>
                    <input type="datetime-local"
                           class="form-control"
                           value="@ngayGioChupString"
                           @onchange="UpdateNgayGioChup" />
                </div>

                <!-- Ngày trả file -->
                <div class="form-group">
                    <label class="form-label required-label">Ngày trả File:</label>
                    <input type="date"
                           class="form-control"
                           @bind-value="ngayTraFile"
                           @bind-value:format="yyyy-MM-dd" />
                </div>

                <!-- Mô tả thêm -->
                <div class="form-group">
                    <label class="form-label">Note:</label>
                    <textarea class="form-input" @bind="TextValueDesc" @bind:event="oninput" rows="4" placeholder="Lưu ý....."></textarea>
                    <div></div>
                </div>

                <div class="store-info">
                    @if (UpdateisLoading)
                    {
                        <div class="spinner" style="margin-top:10px;"></div>
                    }
                    else
                    {
                        <button class="button-add" type="button" @onclick="AddLichChup"><i class="bi bi-check2-circle"></i>THÊM GÓI CHỤP</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* tab2 *@
<div class="tab-content tab2" id="tab2">
    @if (isLoading)
    {
        <div> ⏳ Đang tải dữ liệu...</div>
    }
    else
    {
        <h3 class="header-controls">
            <div class="controls-left">
                Nhân Viên
                <select class="control-select" value="type" @onchange="OnNVChanged">
                    @{
                        if (this.ListNv != null && !isLoading)
                        {
                            <option value="All">All</option>
                            foreach (var item in this.ListNv)
                            {
                                <option value="@item.Key">@item.Key</option>
                            }
                        }
                    }
                </select>
                List Job
                <select class="control-select" value="type" @onchange="OnJobChanged">
                    @{
                        <option value="All">All</option>
                        <option value="Make-up">Make-up</option>
                        <option value="Hair">Làm tóc</option>
                        <option value="Job">Nhận Job</option>
                    }
                </select>
                Tháng
                <select class="control-select" value="month" @onchange="OnMonthChanged1">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i.ToString("D2")">@i.ToString("D2")</option>
                    }
                </select>

                <div class="control-item qty">
                    All Job: @qty
                </div>
                <div class="control-item qty">
                    Make-up: @qtyMake
                </div>
                <div class="control-item qty">
                    Tóc: @qtyToc
                </div>
                <div class="control-item qty">
                    Job nhận: @qtyJob
                </div>

                <button class="Reset" type="button" @onclick="Reset">
                    <img src="return.png" alt="icon" style="width: 37px; height: 33px;">
                </button>
            </div>
        </h3>

        <!-- Hàng ngày cập nhật theo tháng -->
        <div class="month-days">
            @for (int day = 1; day <= DaysofMonth(selectedYear, selectedMonth); day++)
            {
                var currentDay = day;
                bool isToday = (currentDay == gioVN.Day &&
                selectedMonth == gioVN.Month &&
                selectedYear == gioVN.Year);

                @* <div class="day-cell @(HasEventOnDay(currentDay) ? "has-event" : "") @(isToday ? "is-today" : "")" *@
                <div class="day-cell @(daysWithEvents.Contains(currentDay) ? "has-event" : "") @(isToday ? "is-today" : "")"
                     @onclick="() => OnDayClicked(currentDay)">
                    @currentDay
                </div>
            }
        </div>

        <div class="chart-order">
            @*Hiện lên table*@
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>Stt</th>
                        <th>Tên Khách</th>
                        <th>Thợ Make</th>
                        <th>Thợ làm Tóc</th>
                        <th>NV nhận Job</th>
                        <th>Số lượng</th>
                        <th class="@(IsAdminUser ? "" : "d-none")">Giá gói chụp</th>
                        <th>Ngày chụp</th>
                        <th>Trạng thái</th>
                        <th>Ngày trả File</th>
                        @*  <th>Ngày Cưới</th> *@
                        <th>Ngày tạo</th>
                        <th style="display: none;">imageid</th>
                        <th class="@(IsAdminUser ? "" : "d-none")">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @if (currentPageData != null && currentPageData.Any())
                    {
                        int count = (currentPage - 1) * rowsPerPage + 1;
                        foreach (var item in currentPageData)
                        {
                            <tr @onclick="() => OnRowClick(item)" style="cursor:pointer">
                                <td data-label="STT">@count</td>
                                <td data-label="Tên khách">@item.namekh</td>
                                <td data-label="Thợ Make">@item.NameThoMake</td>
                                <td data-label="Thợ làm Tóc">@item.NameThoToc</td>
                                <td data-label="NV nhận Job">@item.NVNhanJob</td>
                                <td data-label="Số lượng">@item.qty.ToString()</td>
                                <td data-label="Giá gói chụp" class="@(IsAdminUser ? "" : "d-none")">@item.price.ToString("N0", new CultureInfo("vi-VN")) vnđ</td>
                                <td data-label="Ngày chụp">@item.dateChup.ToString("dd/MM/yyyy HH:mm")</td>
                                <td data-label="Trạng thái">
                                    <button type="button"
                                            class="btn @(item.dateChup.AddHours(2) <= gioVN ? "btn-success" : "btn-warning")">
                                        @(item.dateChup.AddHours(2) <= gioVN ? "Đã xong" : "Chưa xong")
                                    </button>
                                </td>
                                <td data-label="Ngày trả File">@item.dateTraFile.ToString("dd/MM/yyyy")</td>
                                @* <td data-label="Ngày Cưới">@(item.dateCuoi.HasValue? item.dateCuoi.Value.ToString("dd/MM/yyyy"): "")</td> *@
                                <td data-label="Ngày tạo">@item.createdate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td style="display: none;" data-label="imageid">@item.imageid</td>
                                @if (IsAdminUser)
                                {
                                    <td data-label="Action" @onclick:stopPropagation="true">
                                        @if (isLoadingOption)
                                        {
                                            <div class="spinner"></div>
                                        }
                                        else if (item.dateChup >= gioVN.AddDays(-10))
                                        {
                                            <div class="option-wrapper">
                                                <button class="btn btn-option" onclick="toggleOptionMenu(this)"><span>...</span> Option</button>
                                                <div class="option-menu option-1">
                                                    <div class="New-price1">
                                                        <button class="btn btn-option1" @onclick="() => UpdateLichChup(item)">♻️ Update</button>
                                                    </div>
                                                    <div class="New-price1">
                                                        <button class="btn btn-option1" @onclick="() => CancelLichChup(item)">❌ Cancel</button>
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                            count++;
                        }
                    }
                    else if (checkNull)
                    {
                        <tr>
                            <td colspan="13" style="text-align:center">❌ Không có dữ liệu...</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="13" style="text-align:center">⏳ Đang tải dữ liệu...</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination">
            <button @onclick="PrevPage" disabled="@(!CanPrev)">
                <i class="fa-solid fa-arrow-left"></i> Trước
            </button>
            <span>Trang @currentPage / @totalPages</span>
            <button @onclick="NextPage" disabled="@(!CanNext)">
                Sau <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>

        @if (showGalleryModal)
        {
            <ImageGalleryModalWedding Product="ProductInfo" checkAdmin="IsAdminUser" OnClose="CloseGalleryModal" OnImageSelected="HandleImageSelected" />
        }
        @if (showGalleryModal2)
        {
            <UpdateOrderWedding Product="ProductInfoUpdate" ListNv="ListNv" ListGiaChup="ListPrice" OnClose="CloseUpdateLichChup" OnUpdate="OnUpdate" />
        }
    }
</div>

@* tab3 *@
<div class="tab-content" id="tab3">
    <div class="dashboard-row">
        <div class="chart-card">
            <div class="staff-header">
                <h3 class="card-title">
                    <img src="statistics.png" alt="icon" style="width: 30px; height: 30px; margin-right: 6px;">
                    Tổng doanh thu chụp tháng @month
                </h3>
                <div class="staff-controls">
                    <label class="label-ca">NV: </label>
                    <select class="control-select" @onchange="OnThoChanged">
                        @{
                            if (this.ListNv != null && !isLoading)
                            {
                                <option value="All">All</option>
                                foreach (var item in this.ListNv)
                                {
                                    <option value="@item.Key">@item.Key</option>
                                }
                            }
                        }
                    </select>
                </div>
                <div class="staff-controls">
                    <label class="label-ca">Tháng: </label>
                    <select class="control-select" value="Month" @onchange="OnMonthChanged">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i.ToString("D2")">@i.ToString("D2")</option>
                        }
                    </select>
                </div>
                <div class="staff-controls">
                    <label class="label-ca">Ngày: </label>
                    <select class="control-select" @onchange="OnDayChanged">
                        @foreach (var day in DaysInMonth)
                        {
                            <option value="@day">@day.ToString("D2")</option>
                        }
                    </select>
                </div>
            </div>
            <div class="chart-wrapper">
                <div class="chart-container">
                    <canvas id="Doanhthuthang"></canvas>
                    <h4 class="chart-legend">Tổng doanh thu tháng @month: @tongdoanhthuthang.ToString("N0") Vnđ</h4>
                </div>
            </div>
        </div>
        <div class="chart-card">
            <div class="staff-header">
                <h3 class="card-title">
                    <img src="statistics.png" alt="icon" style="width: 35px; height: 35px; margin-right: 6px;">
                    Tổng doanh thu chụp năm @year
                </h3>
                <div class="staff-controls">
                    <select class="control-select" value="year" @onchange="OnYearChanged">
                        <option value="@yearFix1">@yearFix1</option>
                        <option value="@yearFix0">@yearFix0</option>
                        <option value="@yearFix2">@yearFix2</option>
                    </select>
                </div>
            </div>
            <div class="chart-container">
                <canvas id="Doanhthunam"></canvas>
                <h4 class="chart-legend">Tổng doanh thu năm @year: @tongDoanhThuNam.ToString("N0") Vnđ</h4>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', function() {
    // đổi active trên nút
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');

    // đổi nội dung hiển thị
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    document.getElementById(this.dataset.tab).classList.add('active');
    });
    });
</script>


@code {
    private DateTime? ngayGioChup, ngayTraFile;
    private string month;
    private string year;
    private List<Data.DTOs.ListParamaterMakeup> datapara = new();
    private List<Data.DTOs.ProductStock> dataWH = new();
    Dictionary<string, (string, long?)> ListNv;
    List<string> ListPrice;
    private bool isLoading = true, UpdateisLoading = false, UpdateisLoading2 = false;
    private string SelectValueThoMake, SelectValueThoToc, SelectValueNhanJob, TextValueNameKH, SelectValuePrice, newValueSP, newValuePrice, TextValueDesc, newValueNV;
    private int TextValueQTY = 1;
    private string typeSelect, typeWHSelect;
    [Inject] private IJSRuntime JSx { get; set; }
    private bool isLoadingService = true;
    private bool _disposed = false;
    private CancellationTokenSource cts = new();
    private DateTime gioVN = TimeZoneInfo.ConvertTimeFromUtc(DateTime.UtcNow, TimeZoneInfo.FindSystemTimeZoneById("SE Asia Standard Time"));

    public void Dispose()
    {
        _disposed = true;
        cts.Cancel();
        cts.Dispose();
    }
    private string ngayGioChupString => ngayGioChup?.ToString("yyyy-MM-ddTHH:mm") ?? "";

    private void UpdateNgayGioChup(ChangeEventArgs e)
    {
        if (DateTime.TryParse(e.Value?.ToString(), out var dt))
            ngayGioChup = dt;
    }

    protected override async Task OnInitializedAsync()
    {
        DateTime test = gioVN;

        this.month = DateTime.Now.Month.ToString();
        this.year = DateTime.Now.Year.ToString();
        this.yearFix0 = DateTime.Now.Year.ToString();
        this.yearFix1 = (DateTime.Now.Year - 1).ToString();
        this.yearFix2 = (DateTime.Now.Year + 1).ToString();
        UpdateDays();
    }

    private ValueTask OnBeforeNavigation(LocationChangingContext context)
    {
        if (isLoadingService)
        {
            context.PreventNavigation();
        }
        return ValueTask.CompletedTask;
    }

    private string usernameLogin = "";
    private bool IsAdminUser => !string.IsNullOrEmpty(usernameLogin) && (usernameLogin.ToUpper() == "BANGTAM" || usernameLogin.ToUpper() == "TRUONGDUNG");
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {

                LoadingService.Begin();
                bool isLoggedIn = await localStorage.GetItemAsync<bool>("isLoggedIn");
                if (isLoggedIn)
                {
                    isLoading = true;
                    //await GetMaterialInWH(true, false);
                    usernameLogin = await localStorage.GetItemAsync<string>("username");
                    await TimKiem();
                    datapara = await GetListParamaterMakeup.GetParamaterMakeUp();
                    this.ListNv = datapara.Where(x => x.KeyPara == "nvAmy").ToDictionary(x => x.keyData1, x => (x.keyData2, x.imageid));

                    this.ListPrice = datapara.Where(x => x.KeyPara == "priceGoiChup")
                                         .OrderBy(x =>
                                         {
                                             if (decimal.TryParse(x.keyData1, out var number))
                                                 return number;
                                             return decimal.MaxValue;
                                         })
                                         .Select(x => x.keyData1)
                                         .ToList();
                    await LoadData(this.NameNV_, int.Parse(this.month), null, NameJob_);
                    isLoading = false;
                    if (!_disposed)
                    {
                        StateHasChanged();
                    }

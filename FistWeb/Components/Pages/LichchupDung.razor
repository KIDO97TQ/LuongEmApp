    public async Task<string> UploadToCloudinaryAsync(MemoryStream stream, string fileName)
    {
        List<Data.DTOs.ListParaUser> datapara = await GetUserInfo.GetLoginUser("CloudInfo", null, null);
        string[] result = datapara[0].keyUsername.Split(new char[] { ';' }, StringSplitOptions.RemoveEmptyEntries);

        string CLOUD_NAME = result[0];
        string API_KEY = result[1];
        string API_SECRET = result[2];

        var account = new Account(
            CLOUD_NAME,
            API_KEY,
            API_SECRET
        );

        var cloudinary = new Cloudinary(account);

        stream.Position = 0;

        var uploadParams = new ImageUploadParams()
        {
            File = new FileDescription(fileName, stream),
            PublicId = fileName,
            Folder = "AmyTam",
            Overwrite = true
        };

        var uploadResult = await cloudinary.UploadAsync(uploadParams);

        return uploadResult.SecureUrl?.ToString();
    }


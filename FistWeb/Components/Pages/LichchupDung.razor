    public async Task<object> Getdoanhthunam(int nam)
    {
        DoanhthuNam = await GetSumChup.SumGetListWedding("goiChupWedding", nam);
        tongDoanhThuNam = (double)DoanhthuNam.Sum(x => x.Reverue);

        // Lấy danh sách tháng có dữ liệu
        var labels = DoanhthuNam
            .Select(x => x.Date.ToString("MM/yyyy"))
            .Distinct()
            .OrderBy(x => x)
            .ToList();

        // Tính tổng doanh thu cho từng tháng
        var data = labels
            .Select(label => DoanhthuNam
                .Where(x => x.Date.ToString("MM/yyyy") == label)
                .Sum(x => x.Reverue))
            .ToList();

        // Tạo dataset (dạng đơn, không phân nhóm)
        var datasets = new[]
        {
        new
        {
            label = "Tổng doanh thu",
            data = data,
            backgroundColor = "rgba(79, 195, 247, 0.5)",
            borderColor = "rgba(79, 195, 247, 1)",
            borderWidth = 2,
            fill = true,
            tension = 0.4
        }
    };

        // Tạo chartData trả về JS
        var chartData = new
        {
            labels = labels,
            datasets = datasets
        };

        return chartData;
    }


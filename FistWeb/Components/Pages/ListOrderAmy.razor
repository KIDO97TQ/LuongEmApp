                <!-- Số lượng -->
                <div class="form-group">
                    <label class="form-label required-label">Số lượng:</label>
                    @* <input type="number" value="@TextQTY" @oninput="OnQtyInput" class="form-input" placeholder="Nhập số lượng..." min="1" /> *@
                    <input type="number" @bind="TextQTY" @bind:event="oninput" class="form-input" placeholder="Nhập số lượng..." min="1" />
                    <label class="form-label-TonKho">Số lượng hiện còn lại: @Tonkho</label>

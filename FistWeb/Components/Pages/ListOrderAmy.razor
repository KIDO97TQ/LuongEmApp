        <!-- button thuê -->
        <div class="store-info">
            @if (UpdateisLoading)
            {
                <div class="spinner" style="margin-top:10px;"></div>
            }
            else
            {
                <button class="button-add" type="button" @onclick="UpdateOrder"><i class="bi bi-check2-circle"></i>Chốt đơn</button>
                @* <button class="button-add" type="button" @onclick="UpdateMuaDo"><i class="bi bi-check2-circle"></i>Bán</button> *@

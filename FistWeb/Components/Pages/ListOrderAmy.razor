                            <th>TypeSP</th>
                            <th>Số lượng</th>
                            @if (MethordBuy)
                            {
                                <th>Giá bán</th>
                            }
                            else
                            {
                                <th>Giá thuê</th>                          
                                <th>Tiền cọc</th>
                            }

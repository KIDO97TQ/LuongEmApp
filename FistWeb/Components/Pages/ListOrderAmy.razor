    [Inject] private IJSRuntime JSx { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                LoadingService.Begin();
                isLoading = true;
                bool isLoggedIn = await localStorage.GetItemAsync<bool>("isLoggedIn");
                if (isLoggedIn)
                {
                    username = await localStorage.GetItemAsync<string>("username");
                    objRef = DotNetObjectReference.Create(this);
                    await JS.InvokeVoidAsync("screenHelper.registerResizeHandler", objRef);
                    await LoadData();

                    UserInfo = await GetUserInfo.GetUserInfo();
                    List<Data.DTOs.ListParamater> datapara = await GetListParamater.GetParamater();
                    this.ListType = datapara.Where(x => x.KeyPara == "typeAmy").Select(x => x.keyData).OrderBy(x => x).ToList();
                    isLoading = false;

                    if (!_disposed)
                    {
                        StateHasChanged();
                    }
                    LoadingService.End();
                    isLoadingService = false;
                }
                else
                {
                    LoadingService.End();
                    isLoadingService = false;
                    Navigation.NavigateTo("/", true);
                }
            }
            catch (Exception ex)
            {
                LoadingService.End();
                isLoadingService = false;
            }
        }
    }

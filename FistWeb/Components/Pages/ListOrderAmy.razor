                        {
                            <button class="button-add" type="button" @onclick="AddStore">
                                <i class="bi bi-cart4"></i> Thêm vào giỏ hàng
                            </button>
                        }

                        @if (TotalAmount > 0)
                        {
                            <div class="qr-payment-section">
                                <h4 style="color: white;" class="total-text">Tổng tiền cần thanh toán: @TotalAmount.ToString("N0", new CultureInfo("vi-VN")) vnđ</h4>
                                <img src="@GetVietQrUrl()" alt="QR Code chuyển khoản" class="qr-img" />
                                <p style="color: white;" class="qr-desc">Quét mã QR để thanh toán đến tài khoản <strong>@accountNumber</strong> (@accountName)</p>

    private void AddStore()
    {
        string sdtKH = TextSdtKH;
        string nameKH = TextNameKH;
        string note = TextNote;
        string giaTheoNgay = SelectGiaTheoNgay;
        string tienCoc = SelectTienCoc;
        string qtythue = TextQTY;
        string size = SelectSizeSP;

        if (string.IsNullOrEmpty(sdtKH))
        {
            JSx.InvokeVoidAsync("alert", "Vui lòng điền sdt khách");
            return;
        }
        if (string.IsNullOrEmpty(nameKH))
        {
            JSx.InvokeVoidAsync("alert", "Vui lòng điền tên khách");
            return;
        }
        if (string.IsNullOrEmpty(typeSP))
        {
            JSx.InvokeVoidAsync("alert", "Vui lòng chọn kiểu sản phẩm.");
            return;
        }
        if (string.IsNullOrEmpty(productid))
        {
            JSx.InvokeVoidAsync("alert", "Vui lòng điền đầy đủ thông tin sản phẩm.");
            return;
        }
        if (string.IsNullOrEmpty(qtythue))
        {
            JSx.InvokeVoidAsync("alert", "Vui lòng điền số lượng thuê");
            return;
        }

        if (string.IsNullOrEmpty(giaTheoNgay) && (MethordBuy))
        {
            JSx.InvokeVoidAsync("alert", "Vui lòng điền giá bán");
            return;
        }

        string cleanedGiaTheoNgay = giaTheoNgay.Replace(".", "").Replace(",", "").Replace(" vnđ", "").Trim();
        string cleanedTienCoc = tienCoc.Replace(".", "").Replace(",", "").Replace(" vnđ", "").Trim();

        bool parseGiaOk = decimal.TryParse(cleanedGiaTheoNgay, out decimal gia);
        bool parseCocOk = decimal.TryParse(cleanedTienCoc, out decimal coc);
        bool parseQtyOk = int.TryParse(TextQTY, out int qty);

        decimal total = 0;
        decimal totalnoncoc = 0;

        if (parseGiaOk && parseCocOk && parseQtyOk)
        {
            total = (gia * qty) + coc;
            totalnoncoc = gia * qty;
        }

        ProductList.Add(new Data.DTOs.ProductItem
        {
            TypeSP = typeSP,
            TienCoc = coc,
            QTYThue = int.Parse(qtythue),
            Notes = note,
            PricePerDay = gia,
            Size = size,
            ProductID = long.Parse(productid),
            TongTienThue = total,
            TongTienThueNonCoc = totalnoncoc
        });

        resutlsImage = null;
        SelectSizeSP = null;
        SelectGiaTheoNgay = null;
        SelectTienCoc = null;
        DisplayGia = null;
        MotaSP = null;
        productid = null;
        typeSP = null;
        TextQTY = null;
        Tonkho = 0;
        results = new();
        SelectTypeSP = "";
        StateHasChanged();
    }

    private async Task UpdateOrder()
    {
        string action;
        int checkupdate = 0;
        if (ProductList.Count == 0)
        {
            JSx.InvokeVoidAsync("alert", "❗ Không có đơn nào cần thuê");
            return;
        }

        if (MethordBuy)
            action = "MUA";
        else
            action = "THUE";

        if (action == "MUA")
        {
            bool confirmed = await JSx.InvokeAsync<bool>("confirm", $"Bạn có muốn bán đơn này không?");
            if (!confirmed)
            { return; }
        }
        UpdateisLoading = true;
        var random = new Random();
        long Usserid = 0;

        try
        {
            if (!Khachquen)
            {
                Usserid = long.Parse(DateTime.Now.ToString("yyyyMMddHHmmss") + random.Next(10, 99));
                checkupdate = await InsertUser.InsertUser(Usserid, TextNameKH, TextSdtKH);
            }
            else
            {
                Usserid = await GetuserID.GetUserID(TextSdtKH);
                if (Usserid != 0)
                    checkupdate = 1;
                else
                {
                    JSx.InvokeVoidAsync("alert", "Lấy thông tin khách hàng thất bại");
                    UpdateisLoading = false;
                    return;
                }
            }

            if (Usserid != 0 && checkupdate > 0)
            {
                checkupdate = await InsertOrder.InsertOrderAmy(Usserid, ProductList, username, action);
                if (checkupdate > 0)
                {
                    UserInfo = new();
                    UserInfo = await GetUserInfo.GetUserInfo();
                    Khachquen = false;
                    ProductList = new();
                    TextNameKH = "";
                    TextSdtKH = "";
                    TextNote = "";
                    SelectTypeSP = "";
                    if (action == "MUA")
                        JSx.InvokeVoidAsync("alert", "Thêm đơn bán hàng thành công");
                    else
                        JSx.InvokeVoidAsync("alert", "Thêm đơn thuê hàng thành công");
                }
            }
            else
            {
                JSx.InvokeVoidAsync("alert", "❌ Thêm khách hàng thất bại");
            }
        }
        catch (Exception ex)
        {
            JSx.InvokeVoidAsync("alert", "❌ Thêm đơn thất bại");
            UpdateisLoading = false;
            StateHasChanged();
        }

        UpdateisLoading = false;
        StateHasChanged();
    }

    private string QtyErrorMessage = string.Empty;
    private string _textQTY;
    public string TextQTY
    {
        get => _textQTY;
        set
        {
            _textQTY = value;
            ValidateQty(value);
        }
    }

    private void ValidateQty(string value)
    {
        QtyErrorMessage = "";

        if (!int.TryParse(value, out int qty) || qty < 1)
        {
            QtyErrorMessage = "❌ Vui lòng nhập số hợp lệ lớn hơn 0.";
            _textQTY = "";
            return;
        }

        if (qty > Tonkho)
        {
            QtyErrorMessage = $"❌ Không đủ hàng. Chỉ còn {Tonkho} cái";
            _textQTY = "";
        }
    }


    string DisplayGia = "";
    void OnGiaChanged(ChangeEventArgs e)
    {
        if (!MethordBuy) return;

        var input = e.Value?.ToString() ?? "";

        // chỉ giữ số
        var numeric = new string(input.Where(char.IsDigit).ToArray());

        if (decimal.TryParse(numeric, out decimal value))
        {
            SelectGiaTheoNgay = value.ToString();

            DisplayGia = value.ToString("N0", new CultureInfo("vi-VN"));
        }
        else

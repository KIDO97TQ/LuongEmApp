    #region load sdt khách
    private string _textSdtKH;
    public string TextSdtKH
    {
        get => _textSdtKH;
        set
        {
            _textSdtKH = value;
            if (string.IsNullOrWhiteSpace(value))
            {
                Suggestions = new List<Data.DTOs.UserOrderDto>();
                ShowSuggestions = false;
                Khachquen = false;
            }
            else
            {
                var query = value.ToLower();

                Suggestions = UserInfo
                    .Where(u =>
                        (!string.IsNullOrWhiteSpace(u.phone) && u.phone.ToLower().Contains(query)) ||
                        (!string.IsNullOrWhiteSpace(u.Username) && u.Username.ToLower().Contains(query)))
                    .Take(5)
                    .ToList();

                ShowSuggestions = Suggestions.Any();
                Khachquen = false;
            }
        }
    }


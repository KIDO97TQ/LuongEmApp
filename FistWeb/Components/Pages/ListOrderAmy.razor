<div class="tabs">
    <button class="tab-btn active" data-tab="tab1" @onclick="HandleTabClick">
        <img src="list.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Danh sách Thuê - Trả đồ
    </button>

    @if (isLoadingListOrder)
    {
        <div class="spinner" style="margin-top:10px;"></div>
    }
    <button class="tab-btn" data-tab="tab2">
        <img src="shopper.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Thuê đồ
    </button>

</div>

<!-- Page control -->
<!-- tab1 -->
<div class="tab-content active" id="tab1">
    @if (isLoading)
    {
        <div> ⏳ Đang tải dữ liệu...</div>
    }
    else
    {
        <h3 class="header-controls">
            <div class="controls-left">
                <div class="control-item">
                    Trạng Thái
                    <select class="control-select" value="type" @onchange="OnTypeChanged">
                        <option>All</option>
                        <option>Đã trả</option>
                        <option>Chưa trả</option>
                        <option>Đã bán</option>
                        <option>Bị hủy</option>
                    </select>
                </div>

                <div class="control-item">
                    Tháng
                    <select class="control-select" value="month" @onchange="OnMonthChanged">
                        @for (int i = 1; i <= 12; i++)
                        {
                            <option value="@i.ToString("D2")">@i.ToString("D2")</option>
                        }
                    </select>
                </div>
            </div>
            <div class="control-item qty">
                QTY: @qty
            </div>

            <button class="UserModify" type="button" @onclick="ReturnAllOrder">
                <img src="return.png" alt="icon" style="width:37px;height:33px;">
            </button>
        </h3>
        <div class="chart-order">
            @*Hiện lên table*@
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Họ tên</th>
                        <th>SĐT/Facebook</th>
                        <th>Ngày mượn</th>
                        <th>Ngày trả</th>
                        <th>Loại sản phẩm</th>
                        <th>Size</th>
                        <th>Số lượng</th>
                        <th>Thành tiền</th>
                        <th>Giá/ngày</th>
                        <th>Tiền cọc</th>
                        @* <th>Phát sinh</th> *@
                        <th>Trạng thái</th>
                        <th style="display: none;">Order</th>
                        <th style="display: none;">productid</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (currentPageData != null && currentPageData.Any())
                    {
                        int count = (currentPage - 1) * rowsPerPage + 1;
                        foreach (var item in currentPageData)
                        {
                            <tr @onclick="() => OnRowClick(item)" style="cursor:pointer">
                                <td data-label="STT">@count</td>
                                <td data-label="Họ tên">@item.fullname</td>
                                <td data-label="SĐT/Facebook">@item.facebookphone</td>
                                <td data-label="Ngày mượn">@item.borrowdate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td data-label="Ngày trả">@item.returndate?.ToString("dd/MM/yyyy HH:mm")</td>
                                <td data-label="Loại sản phẩm">@item.type_production</td>
                                <td data-label="Size">@item.size</td>
                                <td data-label="Số lượng">@item.qty</td>
                                <td data-label="Thành tiền">@item.totalamount.ToString("N0", new CultureInfo("vi-VN")) vnđ</td>
                                @{
                                    string examp = item.priceperday.ToString().Replace(".", "").Replace(",", "").Replace(" vnđ", "").Trim(); ;
                                    bool parseOk = decimal.TryParse(examp, out decimal pricePerDay);
                                    item.priceperday = pricePerDay;
                                    <td data-label="Giá/ngày">@item.priceperday.ToString("N0", new CultureInfo("vi-VN")) vnđ</td>
                                }
                    <td data-label="Tiền cọc">@item.moneycoc.ToString("N0", new CultureInfo("vi-VN")) vnđ</td>
                    @* <td data-label="Phát sinh">@item.tienphatsinh.ToString("N0", new CultureInfo("vi-VN")) vnđ</td> *@
                    @* <td data-label="Trạng thái">@item.status</td> *@
                    <td data-label="Trạng thái">
                        @(item.status == "BORROW" ? "Đang thuê" :
                                                item.status == "RETURN" ? "Đã trả" :
                                                item.status == "CANCEL" ? "Đã hủy" :
                                                item.status == "SOLD" ? "Đã bán" : item.status)
                    </td>
                    <td style="display: none;" data-label="Order">@item.orderid</td>
                    <td style="display: none;" data-label="productid">@item.productid</td>
                    @if (item.status == "BORROW")
                                {
                                    @if (isLoadingOption)
                                    {
                                        <div class="spinner" style="margin-top:10px;"></div>
                                    }
                                    else
                                    {
                                        <td data-label="Hành động">
                                            <div class="option-wrapper">
                                                <button class="btn btn-option" @onclick:stopPropagation="true" onclick="toggleOptionMenu(this) "><span>...</span> Option</button>
                                                <div class="option-menu">
                                                    <div class="New-price">
                                                        <button class="option-itemAdd" type="button" @onclick="() => ReturnOrder(item)">♻️ Trả đồ</button>
                                                        <button class="option-itemAdd" type="button" @onclick="() => ReturnAllOrder(item)">♻️ Trả all đồ</button>
                                                    </div>
                                                    <div class="New-price">
                                                        <button class="option-itemAdd" type="button" @onclick="() => DeleteOrder(item)">🗑️ Xóa đơn</button>
                                                        <button class="option-itemAdd" type="button" @onclick="() => CancelAllOrder(item)">🗑️ Xóa all đơn</button>
                                                    </div>
                                                </div>
                                            </div>
                                        </td>
                                    }
                                }
                            </tr>
                            count++;
                        }
                    }
                    else if (checkNull)
                    {
                        <tr>
                            <td colspan="13" style="text-align:center">❌ Không có dữ liệu.</td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                            <td colspan="13" style="text-align:center">⏳ Đang tải dữ liệu...</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="pagination">
            <button @onclick="PrevPage" disabled="@(!CanPrev)">
                <i class="fa-solid fa-arrow-left"></i> Trước
            </button>
            <span>Trang @currentPage / @totalPages</span>
            <button @onclick="NextPage" disabled="@(!CanNext)">
                Sau <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>

        @if (showGalleryModalOrder)
        {
            <ImageGalleryModalDetailOrder Product="OrderInfo" OnClose="CloseGalleryModalOrder" />
        }
    }
</div>

<!-- tab2 -->
<div class="tab-content" id="tab2">
    @if (isLoading)
    {
        <div class="lds-spinner"><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div><div></div></div>
    }
    else
    {
        <div class="form-container">
            <!-- Left side - Form -->
            <div class="form-section-left">

                @* <input class="button-add" type="radio" name="type" value="thue" @onchange="OnMethordByChanged" /> <label>Thuê</label>
                <input class="button-add" type="radio" name="type" value="mua" @onchange="OnMethordByChanged" /> <label>Bán</label> *@


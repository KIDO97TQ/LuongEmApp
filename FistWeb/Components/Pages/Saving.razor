@page "/Saving"
@using Microsoft.EntityFrameworkCore
@using System.Data
@using System.Text.Json
@using FistWeb.Data.Services
@using System.Text.RegularExpressions
@inject Data.AppDbContext Db
@inject LoadingService LoadingService
@rendermode InteractiveServer
@inject IJSRuntime JS
@using System.Globalization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@using System.Text
@inject NavigationManager Navigation
@implements IDisposable
@inject Blazored.LocalStorage.ILocalStorageService localStorage

@inject IGetUserAcount GetUserAcount
@inject IInsertGold InsertGold
@inject IInsertIncome InsertIncome
@inject IGetGoldAssets GetGoldAssets
@inject IGetIncome GetIncome
@inject IUpdateAccount UpdateAccounts
@inject IGetGoldInfo GetGoldInfo
@inject IUpdateGoldPrice UpdateGoldInfo

<div class="tabs">
    <button class="tab-btn active" data-tab="tab1">
        <img src="dashboard.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Dashboard
    </button>
    <button class="tab-btn" data-tab="tab2">
        <img src="his.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Lịch sử thu nhập
    </button>
    <button class="tab-btn" data-tab="tab3">
        <img src="addMoney.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Thêm Thu Nhập
    </button>
    <button class="tab-btn" data-tab="tab4">
        <img src="user.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        User Mntn
    </button>
</div>

@* TAB 1 - DASHBOARD*@
<div class="tab-content active" id="tab1">

    @if (isLoadingDashboard)
    {
        <div class="dashboard-loading">
            ⏳ Đang tải Dashboard...
        </div>
    }
    else
    {
        <div class="saving-dashboard">

            <div class="dashboard-title">
                <div>
                    <h2>💰 Dashboard tích lũy</h2>
                    <p>Tổng quan tài sản hiện tại</p>
                </div>

                <select class="control-select"
                        @bind="SavingDashboardUser"
                        @bind:after="LoadSavingDashboard">

                    <option value="">
                        Tất cả
                    </option>
                    @foreach (var item in User)
                    {
                        <option value="@item.Key">
                            @item.Value
                        </option>
                    }

                </select>
            </div>

            @* =========================
           ROW 1 - SUMMARY
           ========================= *@
            <div class="saving-summary-grid">

                <div class="saving-summary-card money">
                    <div class="saving-card-icon">💵</div>

                    <div>
                        <div class="saving-card-title">
                            Tổng tiền đang có
                        </div>

                        <div class="saving-card-value">
                            @TotalAccountBalance.ToString("N0", new CultureInfo("vi-VN")) vnđ
                        </div>
                    </div>
                </div>


                <div class="saving-summary-card gold">
                    <div class="saving-card-icon">🪙</div>

                    <div>
                        <div class="saving-card-title">
                            Tổng vốn mua vàng
                        </div>

                        <div class="saving-card-value">
                            @TotalGoldPurchase.ToString("N0", new CultureInfo("vi-VN")) vnđ
                        </div>
                    </div>
                </div>


                <div class="saving-summary-card asset">
                    <div class="saving-card-icon">📈</div>

                    <div>
                        <div class="saving-card-title">
                            Tổng tài sản
                        </div>

                        <div class="saving-card-value">
                            @TotalAssets.ToString("N0", new CultureInfo("vi-VN")) vnđ
                        </div>
                    </div>
                </div>


                <div class="saving-summary-card income">
                    <div class="saving-card-icon">💰</div>

                    <div>
                        <div class="saving-card-title">
                            Thu nhập tháng này
                        </div>

                        <div class="saving-card-value">
                            @CurrentMonthIncome.ToString("N0", new CultureInfo("vi-VN")) vnđ
                        </div>
                    </div>
                </div>

            </div>

            @* =========================
           ROW 2
           ========================= *@

            <div class="dashboard-row1">

                <div class="chart-card yy">

                    <h3 class="card-title">
                        💰 Cơ cấu tiền hiện có
                    </h3>

                    <div class="asset-list">

                        <div class="asset-item">

                            <div>
                                <span class="asset-icon">💵</span>
                                Tiền mặt
                            </div>

                            <strong>
                                @CashBalance.ToString("N0", new CultureInfo("vi-VN")) vnđ
                            </strong>

                        </div>


                        <div class="asset-item">

                            <div>
                                <span class="asset-icon">🏦</span>
                                Ngân hàng
                            </div>

                            <strong>
                                @BankBalance.ToString("N0", new CultureInfo("vi-VN")) vnđ
                            </strong>

                        </div>


                        <div class="asset-item">

                            <div>
                                <span class="asset-icon">💳</span>
                                Ví điện tử
                            </div>

                            <strong>
                                @EWalletBalance.ToString("N0", new CultureInfo("vi-VN")) vnđ
                            </strong>

                        </div>


                        <div class="asset-item">

                            <div>
                                <span class="asset-icon">💰</span>
                                Tiền tiết kiệm
                            </div>

                            <strong>
                                @SavingBalance.ToString("N0", new CultureInfo("vi-VN")) vnđ
                            </strong>

                        </div>

                    </div>

                </div>

                <div class="chart-card gold-dashboard-card">

                    <h3 class="card-title">
                        🪙 Tình hình vàng
                    </h3>


                    <div class="gold-dashboard">

                        <div class="gold-stat">

                            <span>
                                Tổng số lần mua
                            </span>

                            <strong>
                                @SavingGoldList.Count
                            </strong>

                        </div>


                        <div class="gold-stat">

                            <span>
                                Tổng khối lượng
                            </span>

                            <strong>
                                @TotalGoldWeight.ToString("0.####") chỉ
                            </strong>

                        </div>


                        <div class="gold-stat">

                            <span>
                                Tổng vốn đã mua
                            </span>

                            <strong>
                                @TotalGoldPurchase.ToString("N0", new CultureInfo("vi-VN"))                            vnđ
                            </strong>

                        </div>


                        <div class="gold-stat">

                            <span>
                                Giá trị hiện tại
                            </span>

                            <strong class="gold-current-value">
                                @TotalGoldCurrentValue.ToString("N0", new CultureInfo("vi-VN"))                            vnđ
                            </strong>

                        </div>


                        <div class="gold-stat gold-profit-row">

                            <span>
                                Lãi / Lỗ
                            </span>


                            @if (TotalGoldProfitLoss > 0)
                            {
                                <strong class="profit-positive">

                                    +
                                    @TotalGoldProfitLoss.ToString("N0", new CultureInfo("vi-VN"))                            vnđ

                                    <small>
                                        (+@TotalGoldProfitPercent.ToString("0.##")%)
                                    </small>

                                    📈

                                </strong>
                            }
                            else if (TotalGoldProfitLoss < 0)
                            {
                                <strong class="profit-negative">

                                    @TotalGoldProfitLoss.ToString("N0", new CultureInfo("vi-VN"))                            vnđ

                                    <small>
                                        (@TotalGoldProfitPercent.ToString("0.##")%)
                                    </small>

                                    📉

                                </strong>
                            }
                            else
                            {
                                <strong class="profit-neutral">
                                    0 vnđ
                                </strong>
                            }

                        </div>

                    </div>

                </div>

            </div>

            <div class="dashboard-row1">

                <div class="chart-card">
                    <h3 class="card-title">
                        📊 Cơ cấu tài sản
                    </h3>

                    <div class="saving-chart-box">
                        <canvas id="AssetStructureChart"></canvas>
                    </div>
                </div>

                <div class="chart-card">
                    <h3 class="card-title">
                        📈 Thu nhập theo tháng
                    </h3>

                    <div class="saving-chart-box">
                        <canvas id="IncomeByMonthChart"></canvas>
                    </div>
                </div>

            </div>

            <div class="chart-card user-asset-card">

                <h3 class="card-title">
                    👤 Tài sản từng người
                </h3>

                <div class="user-asset-list">

                    @foreach (var item in UserAssetSummaries)
                    {
                        <div class="user-asset-item">

                            <div class="user-asset-left">

                                <div class="user-avatar">
                                    👤
                                </div>

                                <div>
                                    <div class="user-name">
                                        @item.UserName
                                    </div>

                                    <div class="user-sub">
                                        Tiền:
                                        @item.Money.ToString("N0", new CultureInfo("vi-VN")) vnđ

                                        • Vàng:
                                        @item.Gold.ToString("N0", new CultureInfo("vi-VN")) vnđ
                                    </div>
                                </div>

                            </div>

                            <strong class="user-asset-value">
                                @item.TotalAsset.ToString("N0", new CultureInfo("vi-VN")) vnđ
                            </strong>

                        </div>
                    }

                </div>

            </div>
        </div>
    }
</div>

@* TAB 2 - LỊCH SỬ THU NHẬP & VÀNG *@
<div class="tab-content" id="tab2">

    @* LỊCH SỬ THU NHẬP *@
    <div class="chart-card">

        <div class="history-header">

            <h3 class="card-title">
                💵 Lịch sử thu nhập
            </h3>

            <div class="history-filter">

                <select class="control-select"
                        @bind="IncomeHistoryMonth"
                        @bind:after="OnHisMoneyUserChanged">

                    <option value="0">
                        Tất cả tháng
                    </option>

                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i">
                            Tháng @i.ToString("D2")
                        </option>
                    }

                </select>

                <select class="control-select"
                        @bind="IncomeHistoryUser"
                        @bind:after="OnHisMoneyUserChanged">

                    <option value="">
                        Tất cả User
                    </option>

                    @foreach (var item in User)
                    {
                        <option value="@item.Key">
                            @item.Value
                        </option>
                    }

                </select>


                <select class="control-select"
                        @bind="IncomeHistoryAccountId"
                        @bind:after="FilterIncomeHistory">

                    <option value="">
                        Tất cả tài khoản
                    </option>

                    @foreach (var account in this.AccountsMoney)
                    {
                        if (account.IsActive)
                        {
                            <option value="@account.Id">
                                @account.Name
                            </option>
                        }
                    }
                </select>


                @* <button class="button-search"
                        type="button"
                        @onclick="FilterIncomeHistory">

                    <i class="bi bi-search"></i>

                    Tìm kiếm

                </button> *@

            </div>

        </div>

        <div class="history-summary">

            <span>
                Tổng thu nhập:
            </span>

            <strong>
                @IncomeHistoryTotal.ToString("N0", new CultureInfo("vi-VN")) vnđ
            </strong>

        </div>

        <div class="chart-order">
            <table class="table-custom">
                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Ngày nhận</th>
                        <th>Loại thu nhập</th>
                        <th>Số tiền</th>
                        <th>User</th>
                        <th>Tài khoản</th>
                        <th>Ghi chú</th>
                    </tr>
                </thead>

                <tbody>

                    @if (IncomeHistoryPage?.Any() == true)
                    {
                        int stt = (IncomeHistoryCurrentPage - 1) * IncomeHistoryRowsPerPage + 1;

                        foreach (var income in IncomeHistoryPage)
                        {
                            <tr>

                                <td data-label="STT">
                                    @stt
                                </td>

                                <td data-label="Ngày nhận">
                                    @income.IncomeDate.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td data-label="Loại thu nhập">
                                    @(income.IncomeType switch
                                    {
                                        "FROM_SHOP" => "Cửa hàng",
                                        "FROM_COMPANY" => "Lương công ty",
                                        "OTHER" => "Thu nhập khác",
                                        "FROM_INVESTMENT" => "Đầu tư",
                                        _ => "Không xác định"
                                    } )
                        </td>

                                <td data-label="Số tiền">
                                    <strong>
                                        @income.Amount.ToString("N0", new CultureInfo("vi-VN")) vnđ
                                    </strong>
                                </td>

                                <td data-label="User">
                            @foreach (var item in User)
                                    {
                                        if (income.UserName == item.Key)
                                        {
                                            @item.Value
                                        }
                                    }
                                </td>

                                <td data-label="Tài khoản">

                                    @{
                                        var account = AllAccounts.FirstOrDefault(x => x.Id == income.AccountId);
                                    }

                                    @(account?.Name ?? "Không xác định")

                                </td>

                                <td data-label="Ghi chú">
                                    @(string.IsNullOrWhiteSpace(income.Note) ? "-" : income.Note)
                                </td>

                            </tr>

                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                style="text-align:center; padding:30px;">
                                📭 Không có dữ liệu thu nhập
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

        <div class="pagination">

            <button @onclick="PrevIncomeHistoryPage"
                    disabled="@(!CanIncomeHistoryPrev)">
                ← Trước
            </button>

            <span>
                Trang @IncomeHistoryCurrentPage /
                @IncomeHistoryTotalPages
            </span>

            <button @onclick="NextIncomeHistoryPage"
                    disabled="@(!CanIncomeHistoryNext)">
                Sau →
            </button>

        </div>

    </div>

    @* DANH SÁCH VÀNG *@
    <div class="chart-card">

        <div class="history-header">

            <h3 class="card-title">
                🪙 Danh sách vàng
            </h3>

            <div class="history-filter">

                <select class="control-select"
                        @bind="GoldHistoryMonth"
                        @bind:after="FilterGoldHistory">

                    <option value="0">
                        Tất cả tháng
                    </option>

                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i">
                            Tháng @i.ToString("D2")
                        </option>
                    }

                </select>


                <select class="control-select" @bind="GoldHistoryUser"
                        @bind:after="OnHisGoldUserChanged">

                    <option value="">
                        Tất cả User
                    </option>

                    @foreach (var item in User)
                    {
                        <option value="@item.Key">
                            @item.Value
                        </option>
                    }

                </select>


                <select class="control-select" @bind="GoldHistoryAccountId"
                        @bind:after="FilterGoldHistory">

                    <option value="">
                        Tất cả tài khoản
                    </option>

                    @foreach (var account in AccountsGold)
                    {
                        <option value="@account.Id">
                            @account.Name
                        </option>
                    }

                </select>


                @* <button class="button-search"
                        type="button"
                        @onclick="FilterGoldHistory">

                    <i class="bi bi-search"></i>

                    Tìm kiếm

                </button> *@

            </div>

        </div>


        <div class="history-summary">

            <span>
                Tổng tiền mua vàng:
            </span>

            <strong>
                @GoldHistoryTotal.ToString("N0", new CultureInfo("vi-VN")) vnđ
            </strong>

            <span class="history-separator">
                |
            </span>

            <span>
                Tổng khối lượng:
            </span>

            <strong>
                @GoldHistoryWeight.ToString("0.####") chỉ
            </strong>

        </div>


        <div class="chart-order">

            <table class="table-custom">

                <thead>
                    <tr>
                        <th>STT</th>
                        <th>Ngày mua</th>
                        <th>Loại vàng</th>
                        <th>Khối lượng</th>
                        <th>Giá mua</th>
                        <th>User</th>
                        <th>Tài khoản</th>
                        <th>Ghi chú</th>
                    </tr>
                </thead>

                <tbody>

                    @if (GoldHistoryPage?.Any() == true)
                    {
                        int stt = (GoldHistoryCurrentPage - 1) * GoldHistoryRowsPerPage + 1;

                        foreach (var gold in GoldHistoryPage)
                        {
                            <tr>

                                <td data-label="STT">
                                    @stt
                                </td>

                                <td data-label="Ngày mua">
                                    @gold.PurchaseDate.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td data-label="Loại vàng">
                                    @foreach (var item in GoldInfo)
                                    {
                                        if (gold.GoldType == item.GoldType)
                                        {
                                            @item.Description
                                        }
                                    }
                                </td>

                                <td data-label="Khối lượng">
                                    @gold.Weight.ToString("0.####") chỉ
                                </td>

                                <td data-label="Giá mua">
                                    <strong>
                                        @gold.PurchasePrice.ToString("N0", new CultureInfo("vi-VN")) vnđ
                                    </strong>
                                </td>

                                <td data-label="User">
                                    @foreach (var item in User)
                                    {
                                        if (gold.UserName == item.Key)
                                        {
                                            @item.Value
                                        }
                                    }
                                </td>

                                <td data-label="Tài khoản">

                                    @{
                                        var account = AllAccounts.FirstOrDefault(x => x.Id == gold.AccountId);
                                    }

                                    @(account?.Name ?? "Không xác định")

                                </td>

                                <td data-label="Ghi chú">
                                    @(string.IsNullOrWhiteSpace(gold.Note) ? "-" : gold.Note)
                                </td>

                            </tr>

                            stt++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8"
                                style="text-align:center; padding:30px;">
                                🪙 Không có dữ liệu vàng
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <div class="pagination">

            <button @onclick="PrevGoldHistoryPage" disabled="@(!CanGoldHistoryPrev)">
                ← Trước
            </button>

            <span>
                Trang @GoldHistoryCurrentPage / @GoldHistoryTotalPages
            </span>

            <button @onclick="NextGoldHistoryPage" disabled="@(!CanGoldHistoryNext)">
                Sau →
            </button>

        </div>

    </div>

</div>

@* TAB 3 - THÊM THU NHẬP *@
<div class="tab-content" id="tab3">

    <div class="dashboard-row">

        @* ================= THÊM THU NHẬP ================= *@
        <div class="chart-card income-form-card">

            <h3 class="card-title">
                <span style="font-size: 28px;">💵</span>
                Thêm khoản thu nhập
            </h3>

            <div class="form-section-left">

                @* Số tiền *@
                <div class="form-group">

                    <label class="form-label required-label">
                        💰 Số tiền:
                    </label>

                    <input type="text"
                           class="form-input"
                           @bind="IncomeAmountDisplay"
                           @oninput="OnIncomeAmountInput"
                           placeholder="Nhập số tiền..." />

                </div>

                @* Loại thu nhập *@
                <div class="form-group">

                    <label class="form-label required-label">
                        🏷️ Loại thu nhập:
                    </label>

                    <select class="form-select"
                            @bind="SelectedIncomeType">

                        <option value="">
                            Chọn loại thu nhập
                        </option>

                        <option value="FROM_SHOP">
                            Cửa hàng
                        </option>

                        <option value="FROM_COMPANY">
                            Lương công ty
                        </option>

                        <option value="OTHER">
                            Thu nhập khác
                        </option>

                    </select>

                </div>

                @* Ngày nhận *@
                <div class="form-group">

                    <label class="form-label required-label">
                        📅 Ngày nhận:
                    </label>

                    <input type="date"
                           class="form-input"
                           @bind="IncomeDate" />

                </div>

                @* User *@
                <div class="form-group">

                    <label class="form-label required-label">
                        👤 Người thêm:
                    </label>

                    <select class="form-select"
                            @bind="SelectedIncomeUser"
                            @bind:after="OnIncomeUserChanged">

                        @foreach (var item in User)
                        {
                            <option value="@item.Key">
                                @item.Value
                            </option>
                        }
                    </select>

                </div>

                @* Tài khoản nhận *@
                <div class="form-group">

                    <label class="form-label required-label">
                        🏦 Tài khoản nhận:
                    </label>

                    <select class="form-select"
                            @bind="SelectedIncomeAccountID">

                        <option value="">
                            Chọn tài khoản nhận
                        </option>

                        @foreach (var account in AccountsMoney)
                        {
                            if (account.IsActive)
                            {
                                <option value="@account.Id">
                                    @account.Name
                                    :
                                    @account.Balance.ToString("N0", new CultureInfo("vi-VN")) vnđ (Số dư)
                                </option>
                            }
                        }

                    </select>

                </div>

                @* Ghi chú *@
                <div class="form-group">

                    <label class="form-label">
                        📝 Ghi chú:
                    </label>

                    <textarea class="form-input"
                              rows="4"
                              @bind="IncomeNote"
                              placeholder="Ghi chú...">
                </textarea>

                </div>

                @* Button *@
                <div class="store-info">

                    <button class="button-add"
                            type="button"
                            @onclick="AddIncome">

                        <i class="bi bi-plus-circle"></i>

                        Lưu khoản thu nhập

                    </button>

                </div>

            </div>

        </div>


        @* ================= THÊM VÀNG ================= *@
        <div class="chart-card gold-form-card">

            <h3 class="card-title">
                <span style="font-size: 28px;">🧈</span>
                Thêm vàng
            </h3>

            <div class="form-section-left">

                @* Loại vàng *@
                <div class="form-group">

                    <label class="form-label required-label">
                        ✨ Loại vàng:
                    </label>

                    <select class="form-select"
                            @bind="SelectedGoldType">

                        <option value="">
                            Chọn loại vàng
                        </option>

                        @foreach (var item in GoldInfo)
                        {
                            <option value="@item.GoldType">
                                @item.Description
                            </option>
                        }
                    </select>

                </div>

                @* Khối lượng *@
                <div class="form-group">

                    <label class="form-label required-label">
                        ⚖️ Khối lượng:
                    </label>

                    <div class="input-with-unit">

                        <input type="number"
                               class="form-input"
                               @bind="GoldWeight"
                               step="0.5"
                               min="0"
                               placeholder="Ví dụ: 0.5" />

                        <span>chỉ</span>

                    </div>

                </div>

                @* Giá mua *@
                <div class="form-group">

                    <label class="form-label required-label">
                        💰 Giá mua:
                    </label>

                    <input type="text"
                           class="form-input"
                           @bind="GoldPurchasePriceDisplay"
                           @oninput="OnGoldPriceInput"
                           placeholder="Giá mua..." />

                </div>

                @* Ngày mua *@
                <div class="form-group">

                    <label class="form-label required-label">
                        📅 Ngày mua:
                    </label>

                    <input type="date"
                           class="form-input"

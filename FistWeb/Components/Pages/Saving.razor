    private async Task AddIncome()
    {
        if (IncomeAmount <= 0)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Vui lòng nhập số tiền!"
            );
            return;
        }

        if (string.IsNullOrWhiteSpace(SelectedIncomeType))
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Vui lòng chọn loại thu nhập!"
            );
            return;
        }

        if (string.IsNullOrWhiteSpace(SelectedIncomeUser))
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Vui lòng chọn User!"
            );
            return;
        }

        if (SelectedIncomeAccountID == Guid.Empty)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Vui lòng chọn tài khoản nhận tiền!"
            );
            return;
        }

        try
        {
            UpdateisLoadingIncome = true;

            int result = await InsertIncome.InsertIncome(
                IncomeDate,
                IncomeAmount,
                SelectedIncomeType,
                SelectedIncomeUser,
                IncomeNote,
                SelectedIncomeAccountID
            );

            if (result > 0)
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    "Thêm khoản thu nhập thành công!"
                );

                ResetIncomeForm();
                // Sau này gọi LoadData()
                // await LoadData();
                StateHasChanged();
            }
            else
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    "Thêm khoản thu nhập không thành công!"
                );
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Lỗi khi thêm khoản thu nhập: {ex.Message}"
            );
        }
        finally
        {
            UpdateisLoadingIncome = false;
            StateHasChanged();
        }
    }

    private async Task AddGold()
    {
        #region verification data
        if (string.IsNullOrWhiteSpace(SelectedGoldType))
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Vui lòng chọn loại vàng!"
            );
            return;
        }

        if (GoldWeight <= 0)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Vui lòng nhập khối lượng vàng!"
            );
            return;
        }

        if (GoldPurchasePrice <= 0)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Vui lòng nhập giá mua vàng!"
            );
            return;
        }

        if (string.IsNullOrWhiteSpace(SelectedGoldUser))
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Vui lòng chọn User!"
            );
            return;
        }

        if (SelectedIncomeGoldAccountID == Guid.Empty)
        {
            await JS.InvokeVoidAsync(
                "alert",
                "Vui lòng chọn tài khoản thanh toán!"
            );
            return;
        }
        #endregion

        bool NoMoney = AllAccounts.Any(t => t.Id == SelectedIncomeGoldAccountID && t.Name.StartsWith("TK Khác", StringComparison.OrdinalIgnoreCase));

        try
        {
            UpdateisLoadingGold = true;

            int result = await InsertGold.InsertGold(
                SelectedGoldType,
                GoldWeight,
                GoldPurchasePrice,
                GoldPurchaseDate,
                SelectedGoldUser,
                GoldNote,
                SelectedIncomeGoldAccountID,
                NoMoney
            );

            if (result > 0)
            {
                if (result == 1000)
                {
                    await JS.InvokeVoidAsync(
                        "alert",
                        "Số dư không đủ!"
                    );
                }
                else
                {
                    await JS.InvokeVoidAsync(
                        "alert",
                        "Thêm khoản vàng thành công!"
                    );

                    ResetGoldForm();
                    // Sau này:
                    // await LoadData();
                }
                StateHasChanged();
            }
            else
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    "Thêm khoản vàng không thành công!"
                );
            }
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Lỗi khi thêm vàng: {ex.Message}"
            );
        }
        finally
        {
            UpdateisLoadingGold = false;

            StateHasChanged();
        }
    }


    private void OnIncomeAmountInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";
        var digitsOnly = new string(input.Where(char.IsDigit).ToArray());

        if (string.IsNullOrEmpty(digitsOnly))
        {
            IncomeAmountDisplay = "";
            IncomeAmount = 0;
            return;
        }

        if (decimal.TryParse(digitsOnly, out decimal amount))
        {
            IncomeAmount = amount;
            IncomeAmountDisplay = amount.ToString("N0", new CultureInfo("vi-VN"));
        }
    }

    private void ResetIncomeForm()
    {
        IncomeAmountDisplay = "";
        IncomeAmount = 0;
        SelectedIncomeType = "";
        IncomeDate = DateTime.Now;
        SelectedIncomeUser = "KIDO";
        SelectedIncomeAccountID = Guid.Empty;
        IncomeNote = "";
    }


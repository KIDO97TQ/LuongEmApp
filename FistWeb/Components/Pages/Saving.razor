    #region Tab 1 Dashbroad
    private string SavingDashboardUser = "";

    private List<Data.DTOs.UserAccount> SavingAccounts = new();
    private List<Data.DTOs.Income> SavingIncomeList = new();
    private List<Data.DTOs.GoldAsset> SavingGoldList = new();
    private decimal[] AssetStructureData = new decimal[6];
    private decimal[] IncomeByMonthData = new decimal[12];
    private List<Data.DTOs.UserAssetSummary> UserAssetSummaries = new();

    private decimal TotalAccountBalance = 0;
    private decimal CashBalance = 0;
    private decimal BankBalance = 0;
    private decimal EWalletBalance = 0;
    private decimal SavingBalance = 0;
    private decimal OtherBalance = 0;
    private decimal TotalGoldPurchase = 0;
    private decimal TotalGoldWeight = 0;
    private decimal TotalAssets = 0;
    private decimal CurrentMonthIncome = 0;

    private async Task LoadSavingDashboard()
    {
        try
        {
            if (!this.checkload)
                isLoadingDashboard = true;

            var accounts = AllAccounts.ToList();
            var incomes = IncomeHistoryAll.ToList();
            var goldAssets = GoldHistoryAll.ToList();


            if (!string.IsNullOrWhiteSpace(SavingDashboardUser))
            {
                accounts = accounts
                    .Where(x =>
                        x.UserName == SavingDashboardUser)
                    .ToList();

                incomes = incomes
                    .Where(x =>
                        x.UserName == SavingDashboardUser)
                    .ToList();

                goldAssets = goldAssets
                    .Where(x =>
                        x.UserName == SavingDashboardUser)
                    .ToList();
            }

            SavingAccounts = accounts;
            SavingIncomeList = incomes;
            SavingGoldList = goldAssets;

            CalculateSavingDashboard();

            if (!this.checkload)
                isLoadingDashboard = false;

            StateHasChanged();
            await RenderSavingDashboardCharts();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Lỗi khi tải Dashboard tích lũy: {ex.Message}"
            );
        }
    }

    private void CalculateSavingDashboard()
    {
        TotalAccountBalance =
            SavingAccounts.Sum(x => x.Balance);


        CashBalance =
            SavingAccounts
                .Where(x => x.AccountType == "CASH")
                .Sum(x => x.Balance);


        BankBalance =
            SavingAccounts
                .Where(x => x.AccountType == "BANK")
                .Sum(x => x.Balance);


        EWalletBalance =
            SavingAccounts
                .Where(x => x.AccountType == "EWALLET")
                .Sum(x => x.Balance);


        SavingBalance =
            SavingAccounts
                .Where(x => x.AccountType == "SAVING")
                .Sum(x => x.Balance);


        OtherBalance =
            SavingAccounts
                .Where(x => x.AccountType == "OTHER")
                .Sum(x => x.Balance);


        TotalGoldPurchase =
            SavingGoldList.Sum(x => x.PurchasePrice);


        TotalGoldWeight =
            SavingGoldList.Sum(x => x.Weight);


        CurrentMonthIncome =
            SavingIncomeList
                .Where(x =>
                    x.IncomeDate.Month == DateTime.Now.Month &&
                    x.IncomeDate.Year == DateTime.Now.Year)
                .Sum(x => x.Amount);


        TotalAssets =
            TotalAccountBalance +
            TotalGoldPurchase;
        CalculateUserAssets();
    }

    private async Task RenderSavingDashboardCharts()
    {
        // =====================================================
        // 1. CƠ CẤU TÀI SẢN
        // =====================================================

        var assetLabels = new List<string>
    {
        "Tiền mặt",
        "Ngân hàng",
        "Ví điện tử",
        "Tiết kiệm",
        "Khác",
        "Vàng"
    };

        var assetData = new List<decimal>
    {
        CashBalance,
        BankBalance,
        EWalletBalance,
        SavingBalance,
        OtherBalance,
        TotalGoldPurchase
    };


        var assetChart = new
        {
            labels = assetLabels,

            datasets = new[]
            {
            new
            {
                label = "Tài sản",

                data = assetData,

                borderWidth = 1
            }
        }
        };


        await JS.InvokeVoidAsync(
            "chartHelper.renderChart",
            "AssetStructureChart",
            assetChart,
            "doughnut"
        );


        // =====================================================
        // 2. THU NHẬP THEO THÁNG
        // =====================================================

        int year = DateTime.Now.Year;


        var incomeMonthData = SavingIncomeList
            .Where(x => x.IncomeDate.Year == year)
            .GroupBy(x => x.IncomeDate.Month)
            .ToDictionary(
                x => x.Key,
                x => x.Sum(y => y.Amount)
            );


        var incomeLabels = Enumerable
            .Range(1, 12)
            .Select(x => $"T{x}")
            .ToList();


        var incomeData = Enumerable
            .Range(1, 12)
            .Select(month =>
                incomeMonthData.TryGetValue(
                    month,
                    out var amount)
                    ? amount
                    : 0
            )
            .ToList();


        var incomeChart = new
        {
            labels = incomeLabels,

            datasets = new[]
            {
            new
            {
                label = "Thu nhập",

                data = incomeData,

                borderWidth = 2,

                fill = true,

                tension = 0.3
            }
        }
        };


        await JS.InvokeVoidAsync(
            "chartHelper.renderChart",
            "IncomeByMonthChart",
            incomeChart,
            "bar"
        );
    }

    private void CalculateUserAssets()
    {
        UserAssetSummaries = User
            .Select(user =>
            {
                var money = AllAccounts
                    .Where(x => x.UserName == user.Key)
                    .Sum(x => x.Balance);

                var gold = GoldHistoryAll
                    .Where(x => x.UserName == user.Key)
                    .Sum(x => x.PurchasePrice);

                return new Data.DTOs.UserAssetSummary
                {
                    UserCode = user.Key,
                    UserName = user.Value,
                    Money = money,
                    Gold = gold
                };
            })
            .OrderByDescending(x => x.TotalAsset)
            .ToList();
    }

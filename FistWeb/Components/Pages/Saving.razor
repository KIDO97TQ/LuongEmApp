    #region Tab 2 - History Income & Gold
    //  Income ========================
    private List<Data.DTOs.Income> IncomeHistoryAll = new();
    private List<Data.DTOs.Income> IncomeHistoryFiltered = new();
    private List<Data.DTOs.Income> IncomeHistoryPage = new();

    private int IncomeHistoryMonth = 0;
    private string IncomeHistoryUser = "";
    private string IncomeHistoryAccountId = "";

    private decimal IncomeHistoryTotal = 0;

    private int IncomeHistoryCurrentPage = 1;
    private int IncomeHistoryRowsPerPage = 10;

    private int IncomeHistoryTotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                (decimal)IncomeHistoryFiltered.Count /
                IncomeHistoryRowsPerPage
            )
        );

    private bool CanIncomeHistoryPrev => IncomeHistoryCurrentPage > 1;
    private bool CanIncomeHistoryNext => IncomeHistoryCurrentPage < IncomeHistoryTotalPages;


    // ======================== Gold ========================

    private List<Data.DTOs.GoldAsset> GoldHistoryAll = new();
    private List<Data.DTOs.GoldAsset> GoldHistoryFiltered = new();
    private List<Data.DTOs.GoldAsset> GoldHistoryPage = new();

    private int GoldHistoryMonth = 0;
    private string GoldHistoryUser = "";
    private string GoldHistoryAccountId = "";

    private decimal GoldHistoryTotal = 0;
    private decimal GoldHistoryWeight = 0;

    private int GoldHistoryCurrentPage = 1;
    private int GoldHistoryRowsPerPage = 10;

    private async Task OnHisMoneyUserChanged()
    {
        AccountsMoney = AllAccounts.Where(x => x.UserName == IncomeHistoryUser).ToList();
        FilterIncomeHistory();
    }

    private async Task OnHisGoldUserChanged()
    {
        AccountsGold = AllAccounts.Where(x => x.UserName == GoldHistoryUser).ToList();
        FilterGoldHistory();
    }

    private int GoldHistoryTotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                (decimal)GoldHistoryFiltered.Count /
                GoldHistoryRowsPerPage
            )
        );

    private bool CanGoldHistoryPrev => GoldHistoryCurrentPage > 1;
    private bool CanGoldHistoryNext => GoldHistoryCurrentPage < GoldHistoryTotalPages;

    private async Task LoadIncomeGoldHistory()
    {
        IncomeHistoryAll = await GetIncome.GetIncome();

        GoldHistoryAll = await GetGoldAssets.GetGoldAssets();


        IncomeHistoryFiltered = IncomeHistoryAll
            .OrderByDescending(x => x.IncomeDate)
            .ToList();


        GoldHistoryFiltered = GoldHistoryAll
            .OrderByDescending(x => x.PurchaseDate)
            .ToList();

        IncomeHistoryCurrentPage = 1;
        GoldHistoryCurrentPage = 1;

        CalculateIncomeHistory();
        CalculateGoldHistory();

        LoadIncomeHistoryPage();
        LoadGoldHistoryPage();
    }

    private void FilterIncomeHistory()
    {
        IEnumerable<Data.DTOs.Income> query = IncomeHistoryAll;

        if (IncomeHistoryMonth > 0)
        {
            query = query.Where(x =>
                x.IncomeDate.Month ==
                IncomeHistoryMonth
            );
        }

        if (!string.IsNullOrWhiteSpace(
            IncomeHistoryUser))
        {
            query = query.Where(x =>
                x.UserName ==
                IncomeHistoryUser
            );
        }

        if (Guid.TryParse(
            IncomeHistoryAccountId,
            out Guid accountId))
        {
            query = query.Where(x =>
                x.AccountId == accountId
            );
        }


        IncomeHistoryFiltered = query
            .OrderByDescending(x => x.IncomeDate)
            .ToList();

        IncomeHistoryCurrentPage = 1;
        CalculateIncomeHistory();
        LoadIncomeHistoryPage();
    }

    private void FilterGoldHistory()
    {
        IEnumerable<Data.DTOs.GoldAsset> query = GoldHistoryAll;

        if (GoldHistoryMonth > 0)
        {
            query = query.Where(x =>
                x.PurchaseDate.Month ==
                GoldHistoryMonth
            );
        }

        if (!string.IsNullOrWhiteSpace(GoldHistoryUser))
        {
            query = query.Where(x =>
                x.UserName ==
                GoldHistoryUser
            );
        }

        if (Guid.TryParse(GoldHistoryAccountId, out Guid accountId))
        {
            query = query.Where(x =>
                x.AccountId == accountId
            );
        }

        GoldHistoryFiltered = query
            .OrderByDescending(x => x.PurchaseDate)
            .ToList();

        GoldHistoryCurrentPage = 1;
        CalculateGoldHistory();
        LoadGoldHistoryPage();
    }

    private void CalculateIncomeHistory()
    {
        IncomeHistoryTotal = IncomeHistoryFiltered.Sum(x => x.Amount);
    }

    private void CalculateGoldHistory()
    {
        GoldHistoryTotal =
            GoldHistoryFiltered.Sum(
                x => x.PurchasePrice
            );

        GoldHistoryWeight =
            GoldHistoryFiltered.Sum(
                x => x.Weight
            );
    }

    private void LoadIncomeHistoryPage()
    {
        IncomeHistoryPage =
            IncomeHistoryFiltered
                .Skip(
                    (IncomeHistoryCurrentPage - 1)
                    * IncomeHistoryRowsPerPage
                )
                .Take(IncomeHistoryRowsPerPage)
                .ToList();
    }

    private void LoadGoldHistoryPage()
    {
        GoldHistoryPage =
            GoldHistoryFiltered
                .Skip(
                    (GoldHistoryCurrentPage - 1)
                    * GoldHistoryRowsPerPage
                )
                .Take(GoldHistoryRowsPerPage)
                .ToList();
    }

    private void NextIncomeHistoryPage()
    {
        if (!CanIncomeHistoryNext)
            return;
        IncomeHistoryCurrentPage++;
        LoadIncomeHistoryPage();
    }

    private void PrevIncomeHistoryPage()
    {
        if (!CanIncomeHistoryPrev)
            return;
        IncomeHistoryCurrentPage--;
        LoadIncomeHistoryPage();
    }

    private void NextGoldHistoryPage()
    {
        if (!CanGoldHistoryNext)
            return;
        GoldHistoryCurrentPage++;
        LoadGoldHistoryPage();
    }

    private void PrevGoldHistoryPage()
    {
        if (!CanGoldHistoryPrev)
            return;
        GoldHistoryCurrentPage--;
        LoadGoldHistoryPage();
    }


    this.classList.add('active');

    // đổi nội dung hiển thị
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    document.getElementById(this.dataset.tab).classList.add('active');
    });
    });
</script>

@code {
    private string month;
    [Inject] private IJSRuntime JSx { get; set; }
    private bool isLoadingService = true;
    private bool _disposed = false;
    private CancellationTokenSource cts = new();
    private bool UpdateisLoading = false;
    private bool checkload = false;
    private bool isLoadingDashboard = true;
    private Dictionary<string, string> User = new()
    {
        {"KIDO","Kido"},
        {"LUONG","Lương"}
    };
    private List<Data.DTOs.UserAccount> AllAccounts = new();
    private List<Data.DTOs.UserAccount> AccountsMoney = new();
    private List<Data.DTOs.UserAccount> AccountsGold = new();
    private List<Data.DTOs.GoldInfo> GoldInfo = new();

    public void Dispose()
    {
        _disposed = true;
        cts.Cancel();
        cts.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        this.month = DateTime.Now.Month.ToString();
    }

    private async Task LoadData()
    {
        this.checkload = true;

        await LoadIncomeGoldHistory();
        await LoadSavingDashboard();

        this.checkload = false;
        StateHasChanged();
    }

    private ValueTask OnBeforeNavigation(LocationChangingContext context)
    {
        if (isLoadingService)
        {
            context.PreventNavigation();
        }
        return ValueTask.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {

                LoadingService.Begin();
                bool isLoggedIn = await localStorage.GetItemAsync<bool>("isLoggedIn");
                if (isLoggedIn)
                {
                    this.AllAccounts = await GetUserAcount.GetUserAcount();
                    AccountsMoney = AllAccounts.ToList();
                    AccountsGold = AllAccounts.ToList();
                    await OnIncomeUserChanged();
                    await OnIncomeUserChanged1();
                    await LoadIncomeGoldHistory();
                    this.GoldInfo = await GetGoldInfo.GetGoldInfo();
                    await LoadSavingDashboard();

                    if (!_disposed)
                    {
                        StateHasChanged();
                    }
                    LoadingService.End();
                    isLoadingService = false;
                }
                else
                {
                    LoadingService.End();
                    isLoadingService = false;
                    Navigation.NavigateTo("/", true);

                }
            }
            catch (Exception)
            {
                LoadingService.End();
                isLoadingService = false;
                throw;
            }
        }
    }

    #region Tab 1 Dashbroad
    private string SavingDashboardUser = "";

    private List<Data.DTOs.UserAccount> SavingAccounts = new();
    private List<Data.DTOs.Income> SavingIncomeList = new();
    private List<Data.DTOs.GoldAsset> SavingGoldList = new();
    private List<Data.DTOs.UserAssetSummary> UserAssetSummaries = new();

    private decimal TotalAccountBalance = 0;
    private decimal CashBalance = 0;
    private decimal BankBalance = 0;
    private decimal EWalletBalance = 0;
    private decimal SavingBalance = 0;
    private decimal OtherBalance = 0;
    private decimal TotalGoldPurchase = 0;
    private decimal TotalGoldWeight = 0;
    private decimal TotalAssets = 0;
    private decimal CurrentMonthIncome = 0;

    private decimal TotalGoldCurrentValue = 0;
    private decimal TotalGoldProfitLoss = 0;
    private decimal TotalGoldProfitPercent = 0;

    private async Task LoadSavingDashboard()
    {
        try
        {
            if (!this.checkload)
                isLoadingDashboard = true;

            var accounts = AllAccounts.ToList();
            var incomes = IncomeHistoryAll.ToList();
            var goldAssets = GoldHistoryAll.ToList();


            if (!string.IsNullOrWhiteSpace(SavingDashboardUser))
            {
                accounts = accounts
                    .Where(x =>
                        x.UserName == SavingDashboardUser)
                    .ToList();

                incomes = incomes
                    .Where(x =>
                        x.UserName == SavingDashboardUser)
                    .ToList();

                goldAssets = goldAssets
                    .Where(x =>
                        x.UserName == SavingDashboardUser)
                    .ToList();
            }

            SavingAccounts = accounts;
            SavingIncomeList = incomes;
            SavingGoldList = goldAssets;

            CalculateSavingDashboard();

            if (!this.checkload)
                isLoadingDashboard = false;

            StateHasChanged();
            await RenderSavingDashboardCharts();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Lỗi khi tải Dashboard tích lũy: {ex.Message}"
            );
        }
    }

    private void CalculateSavingDashboard()
    {
        // ======================================
        // TIỀN
        // ======================================

        TotalAccountBalance =
            SavingAccounts.Sum(x => x.Balance);

        CashBalance =
            SavingAccounts
                .Where(x => x.AccountType == "CASH")
                .Sum(x => x.Balance);

        BankBalance =
            SavingAccounts
                .Where(x => x.AccountType == "BANK")
                .Sum(x => x.Balance);

        EWalletBalance =
            SavingAccounts
                .Where(x => x.AccountType == "EWALLET")
                .Sum(x => x.Balance);

        SavingBalance =
            SavingAccounts
                .Where(x => x.AccountType == "SAVING")
                .Sum(x => x.Balance);

        OtherBalance =
            SavingAccounts
                .Where(x => x.AccountType == "OTHER")
                .Sum(x => x.Balance);


        // ======================================
        // RESET DỮ LIỆU VÀNG
        // ======================================

        TotalGoldPurchase = 0;
        TotalGoldWeight = 0;
        TotalGoldCurrentValue = 0;
        TotalGoldProfitLoss = 0;
        TotalGoldProfitPercent = 0;


        // ======================================
        // TÍNH TỪNG KHOẢN VÀNG RỒI CỘNG LẠI
        // ======================================

        foreach (var gold in SavingGoldList)
        {
            // Giá vốn thực tế của khoản vàng này
            decimal purchaseAmount =
                gold.PurchasePrice;

            // Khối lượng khoản vàng này
            decimal weight =
                gold.Weight;


            // Cộng tổng vốn
            TotalGoldPurchase +=
                purchaseAmount;

            // Cộng tổng trọng lượng
            TotalGoldWeight +=
                weight;


            // Tìm giá hiện tại theo đúng loại vàng
            var priceInfo = GoldInfo
                .FirstOrDefault(x =>
                    string.Equals(
                        x.GoldType?.Trim(),
                        gold.GoldType?.Trim(),
                        StringComparison.OrdinalIgnoreCase
                    )
                );


            if (priceInfo != null)
            {
                // Giá trị hiện tại của riêng khoản vàng này
                decimal currentValue =
                    weight *
                    priceInfo.NowPrice;


                // Lãi/lỗ riêng khoản này
                decimal profitLoss =
                    currentValue -
                    purchaseAmount;


                // Sau đó cộng vào tổng
                TotalGoldCurrentValue +=
                    currentValue;

                TotalGoldProfitLoss +=
                    profitLoss;
            }
            else
            {
                // Chưa có giá hiện tại cho loại vàng này
                // thì tạm coi giá trị hiện tại = giá vốn
                // để không làm tổng tài sản bị tụt về 0.

                TotalGoldCurrentValue +=
                    purchaseAmount;
            }
        }


        // ======================================
        // % LÃI / LỖ TOÀN BỘ VÀNG
        // ======================================

        TotalGoldProfitPercent =
            TotalGoldPurchase > 0
                ? TotalGoldProfitLoss /
                  TotalGoldPurchase * 100
                : 0;


        // ======================================
        // THU NHẬP THÁNG HIỆN TẠI
        // ======================================

        CurrentMonthIncome =
            SavingIncomeList
                .Where(x =>
                    x.IncomeDate.Month == DateTime.Now.Month &&
                    x.IncomeDate.Year == DateTime.Now.Year)
                .Sum(x => x.Amount);


        // ======================================
        // TỔNG TÀI SẢN
        // ======================================

        TotalAssets =
            TotalAccountBalance +
            TotalGoldCurrentValue;


        // ======================================
        // TÀI SẢN THEO USER
        // ======================================

        CalculateUserAssets();
    }

    private async Task RenderSavingDashboardCharts()
    {
        // =====================================================
        // 1. CƠ CẤU TÀI SẢN
        // =====================================================

        var assetLabels = new List<string>
    {
        "Tiền mặt",
        "Ngân hàng",
        "Ví điện tử",
        "Tiết kiệm",
        "Khác",
        "Vàng"
    };

        var assetData = new List<decimal>
    {
        CashBalance,
        BankBalance,
        EWalletBalance,
        SavingBalance,
        OtherBalance,
        TotalGoldCurrentValue
    };


        var assetChart = new
        {
            labels = assetLabels,

            datasets = new[]
            {
            new
            {
                label = "Tài sản",

                data = assetData,

                borderWidth = 1
            }
        }
        };


        await JS.InvokeVoidAsync(
            "chartHelper.renderChart",
            "AssetStructureChart",
            assetChart,
            "doughnut"
        );


        // =====================================================
        // 2. THU NHẬP THEO THÁNG
        // =====================================================

        int year = DateTime.Now.Year;


        var incomeMonthData = SavingIncomeList
            .Where(x => x.IncomeDate.Year == year)
            .GroupBy(x => x.IncomeDate.Month)
            .ToDictionary(
                x => x.Key,
                x => x.Sum(y => y.Amount)
            );


        var incomeLabels = Enumerable
            .Range(1, 12)
            .Select(x => $"T{x}")
            .ToList();


        var incomeData = Enumerable
            .Range(1, 12)
            .Select(month =>
                incomeMonthData.TryGetValue(
                    month,
                    out var amount)
                    ? amount
                    : 0
            )
            .ToList();


        var incomeChart = new
        {
            labels = incomeLabels,

            datasets = new[]
            {
            new
            {
                label = "Thu nhập",

                data = incomeData,

                borderWidth = 2,

                fill = true,

                tension = 0.3
            }
        }
        };


        await JS.InvokeVoidAsync(
            "chartHelper.renderChart",
            "IncomeByMonthChart",
            incomeChart,
            "bar"
        );
    }

    private void CalculateUserAssets()
    {
        UserAssetSummaries = User
            .Select(user =>
            {
                // =========================
                // TIỀN
                // =========================

                var money = AllAccounts
                    .Where(x => x.UserName == user.Key)
                    .Sum(x => x.Balance);


                // =========================
                // VÀNG THEO GIÁ HIỆN TẠI
                // =========================

                decimal goldCurrentValue = 0;

                var userGold = GoldHistoryAll
                    .Where(x => x.UserName == user.Key)
                    .ToList();


                foreach (var gold in userGold)
                {
                    var price = GoldInfo
                        .FirstOrDefault(x =>
                            string.Equals(
                                x.GoldType?.Trim(),
                                gold.GoldType?.Trim(),
                                StringComparison.OrdinalIgnoreCase
                            )
                        );


                    if (price != null)
                    {
                        goldCurrentValue +=
                            gold.Weight *
                            price.NowPrice;
                    }
                    else
                    {
                        // Chưa có giá hiện tại
                        // tạm dùng giá vốn để tránh tài sản bị tụt về 0
                        goldCurrentValue +=
                            gold.PurchasePrice;
                    }
                }


                return new Data.DTOs.UserAssetSummary
                {
                    UserCode = user.Key,
                    UserName = user.Value,
                    Money = money,
                    Gold = goldCurrentValue
                };
            })
            .OrderByDescending(x => x.TotalAsset)
            .ToList();
    }
    #endregion


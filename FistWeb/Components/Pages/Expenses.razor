    #region tab5 Reports

    private int ReportYear = DateTime.Now.Year;
    private int ReportMonth = DateTime.Now.Month;
    private string ReportUser = "";
    private Guid? ReportCategoryId = null;
    private List<Data.DTOs.ExpenseInfo> ReportExpenses = new();
    private List<Data.DTOs.ReportCategoryInfo> ReportCategories = new();
    private decimal ReportTotal;
    private decimal ReportAverage;

    private async Task LoadReport()
    {
        try
        {
            var expenses = this.DataDashboardExpenses;

            if (expenses == null)
            {
                ReportExpenses = new();
                return;
            }

            // =========================
            // FILTER
            // =========================

            ReportExpenses = expenses
                .Where(x =>
                    x.ExpenseDate.Year == ReportYear
                )
                .Where(x =>
                    ReportMonth == 0 ||
                    x.ExpenseDate.Month == ReportMonth
                )
                .Where(x =>
                    string.IsNullOrEmpty(ReportUser) ||
                    x.User == ReportUser
                )
                .Where(x =>
                    !ReportCategoryId.HasValue ||
                    x.CategoryId == ReportCategoryId.Value
                )
                .OrderByDescending(x => x.ExpenseDate)
                .ToList();


            // =========================
            // SUMMARY
            // =========================

            ReportTotal =
                ReportExpenses.Sum(x => x.Amount);

            ReportAverage =
                ReportExpenses.Count > 0
                    ? ReportTotal / ReportExpenses.Count
                    : 0;


            // =========================
            // CATEGORY
            // =========================

            ReportCategories = ReportExpenses
                .GroupBy(x => x.CategoryId)
                .Select(g =>
                {
                    string name = "Không xác định";
                    string icon = "📦";

                    if (Categories.TryGetValue(
                        g.Key,
                        out var category))
                    {
                        name = category.Name;
                        icon = category.Icon;
                    }

                    return new Data.DTOs.ReportCategoryInfo
                    {
                        CategoryId = g.Key,

                        Name = name,

                        Icon = icon,

                        Amount = g.Sum(x => x.Amount),

                        Count = g.Count()
                    };
                })
                .OrderByDescending(x => x.Amount)
                .ToList();


            // =========================
            // PERCENT
            // =========================

            foreach (var item in ReportCategories)
            {
                item.Percent =
                    ReportTotal > 0
                        ? item.Amount / ReportTotal * 100
                        : 0;
            }


            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Lỗi khi tạo báo cáo: {ex.Message}"
            );
        }
    }

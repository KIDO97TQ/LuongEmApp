@page "/expenses"
@using Microsoft.EntityFrameworkCore
@using System.Data
@using System.Text.Json
@using FistWeb.Data.Services
@using System.Text.RegularExpressions
@inject Data.AppDbContext Db
@inject LoadingService LoadingService
@rendermode InteractiveServer
@inject IJSRuntime JS
@using System.Globalization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@using System.Text
@inject NavigationManager Navigation
@implements IDisposable
@inject Blazored.LocalStorage.ILocalStorageService localStorage

@inject InsertParamaterChiTieu InsertChiTieu
@inject IGetCategories CategoriesInfo
@inject InsertCategory InsertCategory
@inject UpdateCategory UpdateCategory
@inject IGetChiTieu GetChiTieu
@inject IGetUserAcount GetUserAcount
@inject IUpdateExpese UpdateExpese
@inject IDelChiTieu DelChiTieu

<div class="tabs">
    <button class="tab-btn active" data-tab="tab1">
        <img src="dashboard.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Dashboard
    </button>
    <button class="tab-btn" data-tab="tab2">
        <img src="spending.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Chi tiêu
    </button>
    <button class="tab-btn" data-tab="tab3">
        <img src="add.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Thêm Chi tiêu
    </button>
    <button class="tab-btn" data-tab="tab4">
        <img src="categories.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Danh mục
    </button>
    <button class="tab-btn" data-tab="tab5">
        <img src="pie-chart.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Reports
    </button>
</div>

@* TAB 1 - DASHBOARD*@
<div class="tab-content active" id="tab1">

    @if (isLoadingDashboard)
    {
        <div class="dashboard-loading">
            ⏳ Đang tải Dashboard...
        </div>
    }
    else
    {
        @* =========================
           SUMMARY
           ========================= *@

        <div class="dashboard-summary">

            <div class="dashboard-card">
                <div class="dashboard-card-title">
                    🔥 Tổng chi tiêu năm
                </div>

                <div class="dashboard-card-value">
                    @DashboardTotalExpense.ToString("N0", new CultureInfo("vi-VN")) vnđ
                </div>

                <div class="dashboard-card-sub">
                    Tất cả thời gian
                </div>
            </div>


            <div class="dashboard-card">
                <div class="dashboard-card-title">
                    Chi tiêu tháng này
                </div>

                <div class="dashboard-card-value">
                    @DashboardMonthExpense.ToString("N0", new CultureInfo("vi-VN")) vnđ
                </div>

                <div class="dashboard-card-sub">
                    Tháng @DateTime.Now.Month/@DateTime.Now.Year
                </div>
            </div>


            <div class="dashboard-card">
                <div class="dashboard-card-title">
                    Số khoản chi
                </div>

                <div class="dashboard-card-value">
                    @DashboardExpenseCount
                </div>

                <div class="dashboard-card-sub">
                    Tổng số giao dịch
                </div>
            </div>


            <div class="dashboard-card">
                <div class="dashboard-card-title">
                    Trung bình / khoản
                </div>

                <div class="dashboard-card-value">
                    @DashboardAverageExpense.ToString("N0", new CultureInfo("vi-VN")) vnđ
                </div>

                <div class="dashboard-card-sub">
                    Mức chi trung bình
                </div>
            </div>

        </div>


        @* =========================
           CHARTS
           ========================= *@

        <div class="dashboard-row">

            @* Chi tiêu theo ngày *@
            <div class="chart-card">

                <div class="staff-header">

                    <h3 class="card-title">
                        Chi tiêu trong tháng
                    </h3>

                    <div class="staff-controls">

                        <label class="label-ca">
                            Tháng:
                        </label>

                        <select class="control-select"
                                @bind="DashboardMonth"
                                @bind:after="() => LoadDashboard(DashboardMonth)">

                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i">
                                    @i.ToString("D2")
                                </option>
                            }

                        </select>

                    </div>

                </div>

                <div class="chart-container">

                    <canvas id="ExpenseMonthChart"></canvas>

                </div>

            </div>


            @* Chi tiêu theo danh mục *@
            <div class="chart-card">

                <div class="staff-header">

                    <h3 class="card-title">
                        Chi tiêu theo danh mục
                    </h3>

                </div>

                <div class="chart-container">

                    <canvas id="ExpenseCategoryChart"></canvas>

                </div>

            </div>

        </div>

        @* CHI TIÊU USER THEO NGÀY *@
        <div class="dashboard-row user-chart-row">

            <div class="chart-card user-daily-chart-card">

                <h3 class="card-title">
                    <span style="font-size: 28px;">👨‍👩‍👧</span>
                    Chi tiêu từng người hàng ngày trong tháng @DashboardMonth.ToString()
                </h3>

                <div class="chart-container user-daily-chart-container">
                    <canvas id="UserDailyExpenseChart"></canvas>
                </div>

            </div>

        </div>


        @* =========================
           TOP CATEGORY
           ========================= *@

        <div class="dashboard-section">

            <h3 class="dashboard-section-title">
                🔥 Danh mục chi tiêu nhiều nhất
            </h3>

            <div class="top-category-list">

                @if (TopCategories != null && TopCategories.Any())
                {
                    int stt = 1;

                    foreach (var item in TopCategories)
                    {
                        <div class="top-category-item">

                            <div class="top-category-number">
                                @stt
                            </div>

                            <div class="top-category-icon">
                                @item.Icon
                            </div>

                            <div class="top-category-info">

                                <div class="top-category-name">
                                    @item.Name
                                </div>

                                <div class="top-category-count">
                                    @item.Count khoản chi
                                </div>

                            </div>

                            <div class="top-category-amount">
                                @item.Amount.ToString("N0", new CultureInfo("vi-VN")) vnđ
                            </div>

                        </div>

                        stt++;
                    }
                }
                else
                {
                    <div class="dashboard-empty">
                        📭 Chưa có dữ liệu chi tiêu
                    </div>
                }

            </div>

        </div>

    }

</div>

@* TAB 2 - DANH SÁCH CHI TIÊU*@
<div class="tab-content" id="tab2">

    @if (isLoadingExpense)
    {
        <div style="text-align:center; padding:30px;">
            ⏳ Đang tải dữ liệu...
        </div>
    }
    else
    {
        @* FILTER *@
        <div class="header-controls">

            <div class="controls-left">

                <label class="form-label">
                    Từ ngày:
                </label>

                <input type="date"
                       class="control-select"
                       @bind="ExpenseFromDate" />

                <label class="form-label">
                    Đến ngày:
                </label>

                <input type="date"
                       class="control-select"
                       @bind="ExpenseToDate" />

                @if (isLoadingExpense)
                {
                    <div class="spinner" style="margin-top:10px;"></div>
                }
                else
                {
                    <button class="button-search"
                            type="button"
                            @onclick="SearchExpensesByTime">
                        <i class="bi bi-search"></i>
                        Tìm kiếm
                    </button>
                }

                <label class="form-label">
                    Người chi:
                </label>

                <select class="control-select"
                        @bind="Nguoichi"
                        @bind:after="SearchExpenses">
                    <option value="">
                        Tất cả
                    </option>
                    @foreach (var item in User)
                    {
                        <option value="@item.Key">
                            @item.Value
                        </option>
                    }
                </select>

                <label class="form-label">
                    Danh mục:
                </label>

                <select class="control-select"
                        @bind="ExpenseCategoryFilter"
                        @bind:after="SearchExpenses">
                    <option value="">
                        Tất cả
                    </option>

                    @if (Categories != null)
                    {
                        foreach (var category in Categories)
                        {
                            <option value="@category.Key">
                                @category.Value.Icon @category.Value.Name
                            </option>
                        }
                    }
                </select>
            </div>
        </div>


        @* TỔNG TIỀN *@
        <div class="expense-summary">
            <div class="summary-card">
                <div class="summary-title">
                    🔥 Tổng chi tiêu
                </div>

                <div class="summary-value">
                    @TotalExpense.ToString("N0", new CultureInfo("vi-VN")) vnđ
                </div>
            </div>

            <div class="summary-card">

                <div class="summary-title">
                    Số khoản chi
                </div>

                <div class="summary-value">
                    @FilteredExpenses.Count
                </div>

            </div>

        </div>

        @* table *@
        @if (IsEditingExpense)
        {
            <div class="edit-expense-container">

                <div class="edit-expense-header">
                    <h3>
                        ✏️ Chỉnh sửa khoản chi
                    </h3>

                    <button type="button"
                            class="edit-close-btn"
                            @onclick="CancelEditExpense">
                        ✕
                    </button>
                </div>


                <div class="edit-expense-form">

                    @* Ngày *@
                    <div class="form-group">

                        <label class="form-label">
                            Ngày chi tiêu:
                        </label>

                        <input type="datetime-local"
                               class="form-input"
                               @bind="EditExpenseDate" />

                    </div>


                    @* Danh mục *@
                    <div class="form-group">

                        <label class="form-label">
                            Danh mục:
                        </label>

                        <select class="form-select"
                                @bind="EditExpenseCategoryId">

                            <option value="@Guid.Empty">
                                Chọn danh mục
                            </option>

                            @if (Categories != null)
                            {
                                foreach (var category in Categories)
                                {
                                    <option value="@category.Key">

                                        @category.Value.Icon
                                        @category.Value.Name

                                    </option>
                                }
                            }

                        </select>

                    </div>


                    @* Số tiền *@
                    <div class="form-group">

                        <label class="form-label">
                            Số tiền:
                        </label>

                        <input type="number"
                               class="form-input"
                               min="1"
                               step="1000"
                               @bind="EditExpenseAmount" />

                    </div>

                    @* user *@
                    <div class="form-group">

                        <label class="form-label">
                            Người chi:
                        </label>

                        <select class="form-select" @bind="EditExpenseUser">

                            @foreach (var item in User)
                            {
                                <option value="@item.Key">
                                    @item.Value
                                </option>
                            }
                        </select>
                    </div>

                    @* nguồn chi *@
                    @* <div class="form-group">
                        <label class="form-label">
                            Nguồn chi:
                        </label>

                        <select class="form-select" @bind="EditExpenseUserId">
                            <option value="@Guid.Empty">
                                Chọn nguồn chi
                            </option>

                            @foreach (var account in Accounts)
                            {
                                <option value="@account.Id">
                                    @account.Name
                                    -
                                    @account.Balance.ToString("N0", new CultureInfo("vi-VN")) vnđ
                                </option>
                            }

                        </select>
                    </div> *@
                    @* Nội dung *@
                    <div class="form-group">

                        <label class="form-label">
                            Nội dung:
                        </label>

                        <input type="text"
                               class="form-input"
                               maxlength="255"
                               @bind="EditExpenseDescription"
                               placeholder="Nhập nội dung chi tiêu..." />

                    </div>


                    @* Ghi chú *@
                    <div class="form-group">

                        <label class="form-label">
                            Ghi chú:
                        </label>

                        <textarea class="form-input"
                                  rows="3"
                                  @bind="EditExpenseNote"
                                  placeholder="Nhập ghi chú...">
                                                                         </textarea>

                    </div>

                </div>


                <div class="edit-expense-footer">

                    <button type="button"
                            class="button-cancel"
                            @onclick="CancelEditExpense">

                        Hủy

                    </button>

                    <button type="button"
                            class="button-save"
                            @onclick="SaveEditExpense">

                        <i class="bi bi-check2-circle"></i>

                        Lưu thay đổi

                    </button>

                </div>

            </div>
        }

        @* TABLE *@

        @* chinh sua *@
        <div class="chart-order">

            <table class="table-custom">

                <thead>

                    <tr>
                        <th>STT</th>
                        <th>Người chi</th>
                        <th>Ngày</th>
                        <th>Danh mục</th>
                        <th>Nội dung</th>
                        <th>Số tiền</th>
                        <th>Nguồn chi</th>
                        <th>Ghi chú</th>
                        <th>Thao tác</th>
                    </tr>

                </thead>

                <tbody>

                    @if (CurrentPageExpenses != null && CurrentPageExpenses.Any())
                    {
                        int count = (ExpenseCurrentPage - 1) * ExpenseRowsPerPage + 1;

                        foreach (var item in CurrentPageExpenses)
                        {
                            <tr>

                                <td data-label="STT">
                                    @count
                                </td>

                                <td data-label="STT">
                                    @item.User
                                </td>

                                <td data-label="Ngày">
                                    @item.ExpenseDate.ToString("dd/MM/yyyy HH:mm")
                                </td>

                                <td data-label="Danh mục">
                                    @if (Categories.ContainsKey(item.CategoryId))
                                    {
                                        var category = Categories[item.CategoryId];

                                        <span>
                                            @category.Icon
                                            @category.Name
                                        </span>
                                    }
                                    else
                                    {
                                        <span>
                                            Không xác định
                                        </span>
                                    }
                                </td>

                                <td data-label="Nội dung">
                                    @item.Description
                                </td>

                                <td data-label="Số tiền">
                                    <strong>
                                        @item.Amount.ToString("N0", new CultureInfo("vi-VN")) vn₫
                                    </strong>
                                </td>

                                <td data-label="Nguồn chi">
                                    @foreach (var account in Accounts)
                                    {
                                        if (item.AccountId == account.Id)
                                        {
                                            @account.Name
                                        }
                                    }
                                </td>

                                <td data-label="Ghi chú">
                                    @(string.IsNullOrEmpty(item.Note) ? "-" : item.Note)
                                </td>

                                <td data-label="Thao tác">

                                    <button class="btn-action"
                                            title="Sửa"
                                            @onclick="() => EditExpense(item)">
                                        ✏️
                                    </button>

                                    <button class="btn-action"
                                            title="Xóa"
                                            @onclick="() => DeleteExpense(item)">
                                        🗑️
                                    </button>

                                </td>

                            </tr>

                            count++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7"
                                style="text-align:center; padding:30px;">

                                📭 Không có dữ liệu chi tiêu

                            </td>

                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @* PAGINATION *@
        <div class="pagination">

            <button @onclick="PrevExpensePage"
                    disabled="@(!CanExpensePrev)">
                <i class="fa-solid fa-arrow-left"></i>
                Trước
            </button>

            <span>
                Trang @ExpenseCurrentPage / @ExpenseTotalPages
            </span>

            <button @onclick="NextExpensePage"
                    disabled="@(!CanExpenseNext)">
                Sau
                <i class="fa-solid fa-arrow-right"></i>
            </button>

        </div>

    }

</div>

@* TAB 3 - THÊM CHI TIÊU *@
<div class="tab-content" id="tab3">

    <div class="form-container">
        <h3 class="card-title">
            <span style="font-size: 28px;">🛍️</span>
            Thêm các khoản đã chi tiêu
        </h3>
        <div class="form-section-left">

            @* user *@
            <div class="form-group">

                <label class="form-label required-label">
                    Người chi tiêu:
                </label>

                <select class="form-select"
                        @bind="SelectedUser"
                        @bind:after="OnInputUserChanged">

                    @foreach (var item in User)
                    {
                        <option value="@item.Key">
                            @item.Value
                        </option>
                    }
                </select>

            </div>

            @* Ngày chi tiêu *@
            <div class="form-group">

                <label class="form-label required-label">
                    Ngày chi tiêu:
                </label>

                <input type="date"
                       class="form-input"
                       @bind="ExpenseDate" />

            </div>


            @* Số tiền *@
            <div class="form-group">

                <label class="form-label required-label">
                    Số tiền:
                </label>

                <input type="text"
                       class="form-input"
                       value="@AmountDisplay"
                       @oninput="OnAmountInput"
                       placeholder="Nhập số tiền..." />

            </div>

            @* nguồn chi *@
            <div class="form-group">

                <label class="form-label required-label">
                    Tài khoản thanh toán:
                </label>

                <select class="form-select" @bind="SelectedExpenseAccountId">

                    <option value="">
                        Chọn tài khoản
                    </option>

                    @foreach (var account in Accounts)
                    {
                        if (account.IsActive)
                        {
                            <option value="@account.Id">
                                @account.Name
                                :
                                @account.Balance.ToString("N0", new CultureInfo("vi-VN")) vnđ (Số dư)
                            </option>
                        }
                    }

                </select>

            </div>

            @* Danh mục *@
            <div class="form-group">

                <label class="form-label required-label">
                    Danh mục:
                </label>

                <select class="form-select" @bind="SelectedCategoryId">

                    <option value="">
                        Chọn danh mục
                    </option>

                    @if (Categories != null)
                    {
                        foreach (var category in Categories)
                        {
                            var categoryInfo = CategoriesModel.FirstOrDefault(x => x.Id == category.Key);

                            if (categoryInfo != null && categoryInfo.IsActive)
                            {
                                <option value="@category.Key">
                                    @category.Value.Icon @category.Value.Name

                                    @if (!string.IsNullOrWhiteSpace(categoryInfo.Description))
                                    {
                                        @($" ({categoryInfo.Description})")
                                    }
                                </option>
                            }
                        }
                    }

                </select>

            </div>



            @* Nội dung *@
            <div class="form-group">

                <label class="form-label">
                    Nội dung:
                </label>

                <input type="text"
                       class="form-input"
                       @bind="Description"
                       placeholder="Ví dụ: Ăn trưa..." />

            </div>


            @* Ghi chú *@
            <div class="form-group">

                <label class="form-label">
                    Ghi chú:
                </label>

                <textarea class="form-input"
                          rows="4"
                          @bind="Note"
                          placeholder="Ghi chú thêm...">
                </textarea>

            </div>


            @* Button *@
            <div class="store-info">

                @if (UpdateisLoading)
                {
                    <div class="spinner" style="margin-top:10px;"></div>
                }
                else
                {
                    <button class="button-add"
                            type="button"
                            @onclick="AddExpense">
                        <i class="bi bi-check2-circle"></i>
                        Lưu khoản chi
                    </button>
                }
            </div>

        </div>

    </div>

</div>

@* TAB 4 - DANH MỤC*@
<div class="tab-content" id="tab4">

    <div class="dashboard-row1">
        @*  FORM THÊM DANH MỤC *@
        <div class="chart-card category-form-card">

            <h3 class="card-title">
                <span style="font-size: 28px;">🗂️</span>
                Thêm danh mục
            </h3>

            <div class="form-section-left">

                <div class="form-group">

                    <label class="form-label required-label">
                        Tên danh mục:
                    </label>

                    <input type="text"
                           class="form-input"
                           @bind="NewCategoryName"
                           placeholder="Ví dụ: Ăn uống..." />

                </div>

                <div class="form-group">
                    <label class="form-label">
                        Icon:
                    </label>

                    <div class="icon-selector">

                        <button type="button"
                                class="selected-icon"
                                @onclick="ToggleIconPicker">

                            @(string.IsNullOrEmpty(NewCategoryIcon)
                                                        ? "📦"
                                                        : NewCategoryIcon)

                        </button>

                        @if (ShowIconPicker)
                        {
                            <div class="icon-picker">

                                @foreach (var icon in CategoryIcons)
                                {
                                    <button type="button"
                                            class="icon-item"
                                            @onclick="() => SelectIcon(icon)">

                                        @icon

                                    </button>
                                }

                            </div>
                        }

                    </div>
                </div>

                <div class="form-group">

                    <label class="form-label">
                        Mô tả:
                    </label>

                    <textarea class="form-input"
                              rows="4"
                              @bind="NewDescription"
                              placeholder="Mô tả thêm về danh mục...">
                </textarea>

                </div>
                @if (UpdateisLoading)
                {
                    <div class="spinner" style="margin-top:10px;"></div>
                }
                else
                {
                    @if (IsEditingCategory == false)
                    {
                        <div class="store-info">

                            <button class="button-add"
                                    type="button"
                                    @onclick="AddCategory">

                                <i class="bi bi-plus-circle"></i>

                                Thêm danh mục

                            </button>

                        </div>
                    }
                    else
                    {
                        <div class="store-info">

                            <button class="button-add"
                                    type="button"
                                    @onclick="SaveEditCategory">

                                <i class="bi bi-check2-circle"></i>

                                Cập nhật danh mục

                            </button>

                        </div>

                        <div class="store-info">

                            <button class="button-add"
                                    type="button"
                                    @onclick="BtCancel">

                                <i class="bi bi-x-circle-fill"></i>

                                Cancel

                            </button>

                        </div>
                    }
                }
            </div>

        </div>


        @*  DANH SÁCH DANH MỤC *@
        <div class="chart-card category-list-card">

            <h3 class="card-title">
                <span style="font-size: 28px;">📋</span>
                Danh sách danh mục
            </h3>

            <div class="chart-order">

                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Icon</th>
                            <th>Tên danh mục</th>
                            <th>Mô tả</th>
                            <th>Trạng thái</th>
                            <th>Thao tác</th>
                        </tr>
                    </thead>

                    <tbody>

                        @if (CategoriesModel?.Any() == true)
                        {
                            int stt = 1;

                            foreach (var category in CategoriesModel)
                            {
                                <tr>

                                    <td data-label="STT">
                                        @stt
                                    </td>

                                    <td data-label="Icon"
                                        style="font-size: 24px;">
                                        @category.Icon
                                    </td>

                                    <td data-label="Tên danh mục">
                                        <strong>
                                            @category.Name
                                        </strong>
                                    </td>


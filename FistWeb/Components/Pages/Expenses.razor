    };
    public void Dispose()
    {
        _disposed = true;
        cts.Cancel();
        cts.Dispose();
    }

    protected override async Task OnInitializedAsync()
    {
        this.month = DateTime.Now.Month.ToString();
    }

    private ValueTask OnBeforeNavigation(LocationChangingContext context)
    {
        if (isLoadingService)
        {
            context.PreventNavigation();
        }
        return ValueTask.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {

                LoadingService.Begin();
                bool isLoggedIn = await localStorage.GetItemAsync<bool>("isLoggedIn");
                if (isLoggedIn)
                {
                    SelectedUser = User.First().Key;
                    await LoadExpenses(null, null, int.Parse(this.month));
                    this.DataDashboardExpenses = await GetChiTieu.GetChiTieu(null, null, null);
                    this.AllAccounts = await GetUserAcount.GetUserAcount();
                    Accounts = AllAccounts.ToList();
                    await OnInputUserChanged();
                    CategoriesModel = await CategoriesInfo.GetCategories();
                    this.Categories = this.CategoriesModel.ToDictionary(x => x.Id, x => (x.Icon, x.Name));
                    await LoadDashboard(0);
                    await LoadReport();
                    if (!_disposed)
                    {
                        StateHasChanged();
                    }
                    LoadingService.End();
                    isLoadingService = false;
                }
                else
                {
                    LoadingService.End();
                    isLoadingService = false;
                    Navigation.NavigateTo("/", true);

                }
            }
            catch (Exception)
            {
                LoadingService.End();
                isLoadingService = false;
                throw;
            }

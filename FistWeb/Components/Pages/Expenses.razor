    #region tab1 Dashboard

    private bool isLoadingDashboard = true;
    private decimal DashboardTotalExpense;
    private decimal DashboardMonthExpense;
    private int DashboardExpenseCount;
    private decimal DashboardAverageExpense;
    private int DashboardMonth = DateTime.Now.Month;
    private List<Data.DTOs.DashboardCategoryInfo> TopCategories = new();
    private List<Data.DTOs.ExpenseInfo> DataDashboardExpenses { get; set; } = new();

    private async Task LoadDashboard(int month)
    {
        try
        {
            if (!this.checkload)
                isLoadingDashboard = true;

            var expenses = new List<Data.DTOs.ExpenseInfo>();
            if (month > 0)
                expenses = await GetChiTieu.GetChiTieu(null, null, month);
            else
                expenses = this.DataDashboardExpenses;
            // =========================
            // Tổng tất cả
            // =========================

            DashboardTotalExpense = DataDashboardExpenses.Sum(x => x.Amount);


            // =========================
            // Tháng hiện tại
            // =========================

            int currentYear = DateTime.Now.Year;

            DashboardMonthExpense =
                expenses
                    .Where(x =>
                        x.ExpenseDate.Year == currentYear &&
                        x.ExpenseDate.Month == DashboardMonth
                    )
                    .Sum(x => x.Amount);


            // =========================
            // Số khoản chi
            // =========================

            DashboardExpenseCount =
                expenses.Count;


            // =========================
            // Trung bình
            // =========================

            DashboardAverageExpense =
                DashboardExpenseCount > 0
                    ? DashboardTotalExpense /
                      DashboardExpenseCount
                    : 0;


            // =========================
            // Top category
            // =========================

            TopCategories = expenses
                .GroupBy(x => x.CategoryId)
                .Select(g =>
                {
                    Categories.TryGetValue(g.Key, out var category);

                    return new Data.DTOs.DashboardCategoryInfo
                    {
                        CategoryId = g.Key,
                        Name = category.Name ?? "Không xác định",
                        Icon = category.Icon ?? "📦",
                        Amount = g.Sum(x => x.Amount),
                        Count = g.Count()
                    };
                })
                .OrderByDescending(x => x.Amount)
                .Take(5)
                .ToList();

            if (!this.checkload)
                isLoadingDashboard = false;

            StateHasChanged();

            // Chart

            await RenderDashboardCharts(expenses);
            await RenderUserDailyExpenseChart();
        }
        catch (Exception ex)
        {
            if (!this.checkload)
                isLoadingDashboard = false;

            await JS.InvokeVoidAsync(
                "alert",
                $"Lỗi Dashboard: {ex.Message}"
            );
        }
    }

    private async Task RenderDashboardCharts(List<Data.DTOs.ExpenseInfo> expenses)
    {
        int year = DateTime.Now.Year;

        var monthData = expenses
            .Where(x =>
                x.ExpenseDate.Year == year &&
                x.ExpenseDate.Month == DashboardMonth)
            .GroupBy(x => x.ExpenseDate.Day)
            .ToDictionary(
                x => x.Key,
                x => x.Sum(y => y.Amount)
            );

        int days =
            DateTime.DaysInMonth(
                year,
                DashboardMonth
            );

        var labels = Enumerable
            .Range(1, days)
            .Select(x => x.ToString("D2"))
            .ToList();

        var data = Enumerable
            .Range(1, days)
            .Select(day =>
                monthData.TryGetValue(
                    day,
                    out var amount)
                    ? amount
                    : 0
            )
            .ToList();


        var monthChart = new
        {
            labels = labels,

            datasets = new[]
            {
            new
            {
                label = "Chi tiêu",

                data = data,

                borderWidth = 2,

                fill = true,

                tension = 0.3
            }
        }
        };


        await JS.InvokeVoidAsync(
            "chartHelper.renderChart",
            "ExpenseMonthChart",
            monthChart,
            "bar"
        );


        // =========================
        // Category chart
        // =========================

        var categoryData = expenses.GroupBy(x => x.CategoryId).Select(g =>
        {
            string categoryName = "Không xác định";

            if (Categories.TryGetValue(g.Key, out var category))
            {
                categoryName = category.Name;
            }

            return new
            {
                Name = categoryName,
                Amount = g.Sum(x => x.Amount)
            };
        })
        .OrderByDescending(x => x.Amount)
        .ToList();


        var categoryChart = new
        {
            labels = categoryData
                .Select(x => x.Name)
                .ToList(),

            datasets = new[]
            {
            new
            {
                label = "Chi tiêu",

                data = categoryData
                    .Select(x => x.Amount)
                    .ToList(),

                borderWidth = 1
            }
        }
        };


        await JS.InvokeVoidAsync(
            "chartHelper.renderChart",
            "ExpenseCategoryChart",
            categoryChart,
            "doughnut"
        );
    }

    private async Task RenderUserDailyExpenseChart()
    {
        int year = DateTime.Now.Year;

        int daysInMonth = DateTime.DaysInMonth(
            year,
            DashboardMonth);

        // Trục X: ngày 1 -> ngày cuối tháng
        var labels = Enumerable
            .Range(1, daysInMonth)
            .Select(x => x.ToString())
            .ToArray();

        // Tạo dữ liệu cho từng User
        var userDatasets = new List<object>();

        foreach (var user in User)
        {
            string userCode = user.Key;
            string userName = user.Value;

            var userExpenses = DataDashboardExpenses
                .Where(x =>
                    x.User == userCode &&
                    x.ExpenseDate.Year == year &&
                    x.ExpenseDate.Month == DashboardMonth)
                .ToList();

            var data = Enumerable
                .Range(1, daysInMonth)
                .Select(day =>
                    userExpenses
                        .Where(x => x.ExpenseDate.Day == day)
                        .Sum(x => x.Amount))
                .ToArray();

            userDatasets.Add(new
            {
                label = userName,
                data = data
            });
        }

        await JS.InvokeVoidAsync(
            "userDailyExpenseChart.render",
            "UserDailyExpenseChart",
            labels,
            userDatasets);
    }

    #endregion

    #region Tab2 - Chi tiêu
    private bool isLoadingExpense = false;
    private DateTime? ExpenseFromDate { get; set; }
    private DateTime? ExpenseToDate { get; set; }
    private string ExpenseCategoryFilter { get; set; } = "";
    private string Nguoichi { get; set; } = "";
    private List<Data.DTOs.ExpenseInfo> AllExpenses { get; set; } = new();
    private List<Data.DTOs.ExpenseInfo> FilteredExpenses { get; set; } = new();
    private List<Data.DTOs.ExpenseInfo> CurrentPageExpenses { get; set; } = new();
    private decimal TotalExpense { get; set; }
    private int ExpenseCurrentPage = 1;
    private int ExpenseRowsPerPage = 10;

    private int ExpenseTotalPages =>
        Math.Max(
            1,
            (int)Math.Ceiling(
                (decimal)FilteredExpenses.Count
                / ExpenseRowsPerPage
            )
        );

    private bool CanExpensePrev => ExpenseCurrentPage > 1;
    private bool CanExpenseNext => ExpenseCurrentPage < ExpenseTotalPages;

    private async Task LoadExpenses(DateTime? FromDate, DateTime? ToDate, int? month)
    {
        try
        {
            if (!this.checkload)
                isLoadingExpense = true;

            AllExpenses = await GetChiTieu.GetChiTieu(FromDate, ToDate, month);

            FilteredExpenses = AllExpenses
                .OrderByDescending(x => x.ExpenseDate)
                .ToList();

            CalculateExpenseTotal();
            ExpenseCurrentPage = 1;
            LoadExpensePage();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Lỗi khi tải dữ liệu chi tiêu: {ex.Message}"
            );
        }
        finally
        {
            if (!this.checkload)
                isLoadingExpense = false;
        }
    }

    private void CalculateExpenseTotal()
    {
        TotalExpense = FilteredExpenses.Sum(x => x.Amount);
    }

    private void LoadExpensePage()
    {
        CurrentPageExpenses = FilteredExpenses
            .Skip((ExpenseCurrentPage - 1) * ExpenseRowsPerPage)
            .Take(ExpenseRowsPerPage)
            .ToList();
    }

    private void NextExpensePage()
    {
        if (CanExpenseNext)
        {
            ExpenseCurrentPage++;

            LoadExpensePage();
        }
    }

    private void PrevExpensePage()
    {
        if (CanExpensePrev)
        {
            ExpenseCurrentPage--;

            LoadExpensePage();
        }
    }

    private async Task SearchExpensesByTime()
    {
        if (!ExpenseFromDate.HasValue || !ExpenseToDate.HasValue)
        {
            await JS.InvokeVoidAsync(
                    "alert",
                    $"Chưa chọn thời gian tìm kiếm"
                );
            return;
        }
        await LoadExpenses(ExpenseFromDate, ExpenseToDate, null);
    }
    private async Task SearchExpenses()
    {
        try
        {
            isLoadingExpense = true;
            IEnumerable<Data.DTOs.ExpenseInfo> query = AllExpenses;

            // Nguoichi
            if (!string.IsNullOrEmpty(Nguoichi))
            {
                query = query.Where(x =>
                        x.User == Nguoichi
                );
            }

            // Danh mục
            if (!string.IsNullOrEmpty(ExpenseCategoryFilter))
            {
                if (Guid.TryParse(
                    ExpenseCategoryFilter,
                    out Guid categoryId))
                {
                    query = query.Where(x =>
                        x.CategoryId == categoryId
                    );
                }
            }

            FilteredExpenses = query
                .OrderByDescending(x => x.ExpenseDate)
                .ToList();

            ExpenseCurrentPage = 1;

            CalculateExpenseTotal();

            LoadExpensePage();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync(
                "alert",
                $"Lỗi khi tìm kiếm: {ex.Message}"
            );
        }
        finally
        {
            isLoadingExpense = false;
        }
    }

    private bool IsEditingExpense = false;
    private Guid EditExpenseId;
    private DateTime EditExpenseDate;
    private decimal EditExpenseAmount;
    private Guid EditExpenseCategoryId, EditExpenseUserId;
    private string EditExpenseDescription = "";
    private string EditExpenseUser = "";
    private string EditExpenseNote = "";
    private async Task EditExpense(Data.DTOs.ExpenseInfo expense)
    {
        if (expense == null)
            return;

        EditExpenseId = expense.Id;
        EditExpenseDate = expense.ExpenseDate;
        EditExpenseAmount = expense.Amount;
        EditExpenseCategoryId = expense.CategoryId;
        EditExpenseDescription = expense.Description ?? "";
        EditExpenseNote = expense.Note ?? "";
        EditExpenseUser = expense.User;

        IsEditingExpense = true;

        StateHasChanged();
    }
    private void CancelEditExpense()
    {
        IsEditingExpense = false;

        EditExpenseId = Guid.Empty;
        EditExpenseDate = DateTime.Now;
        EditExpenseAmount = 0;
        EditExpenseCategoryId = Guid.Empty;
        EditExpenseDescription = "";
        EditExpenseNote = "";

        StateHasChanged();
    }
    private async Task SaveEditExpense()
    {
        try
        {
            // Validate
            if (EditExpenseCategoryId == Guid.Empty)
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    "Vui lòng chọn danh mục!"
                );

                return;
            }

            if (EditExpenseAmount <= 0)
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    "Số tiền phải lớn hơn 0!"
                );

                return;
            }

            if (string.IsNullOrWhiteSpace(EditExpenseDescription))
            {
                await JS.InvokeVoidAsync(
                    "alert",
                    "Vui lòng nhập nội dung chi tiêu!"
                );

                return;
            }


            // =========================
            // Update
            // =========================

            isLoadingExpense = true;
            //Task<int> UpdateExpese(Guid id, string userName, DateTime expenseDate, decimal amount, Guid categoryId, string description, string? note);

            int result = await UpdateExpese.UpdateExpese(EditExpenseId, EditExpenseUser, EditExpenseDate, EditExpenseAmount, EditExpenseCategoryId,
                EditExpenseDescription.Trim(), string.IsNullOrWhiteSpace(EditExpenseNote) ? null : EditExpenseNote.Trim());
            if (result > 0)
            {
                IsEditingExpense = false;
                EditExpenseId = Guid.Empty;
                EditExpenseAmount = 0;
                EditExpenseCategoryId = Guid.Empty;
                EditExpenseDescription = "";
                EditExpenseNote = "";
                await LoadData();
                await JS.InvokeVoidAsync(
                    "alert",
                    "Cập nhật khoản chi thành công!"
                );
            }
            else
            {

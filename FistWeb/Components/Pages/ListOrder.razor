<script>
    window.screenHelper = {
    getHeight: function() {
    return window.innerHeight;
    },
    registerResizeHandler: function(dotNetHelper) {
    window.addEventListener('resize', () => {
    dotNetHelper.invokeMethodAsync('OnResize', window.innerHeight);
    });
    }
    };
    document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', function() {
    // đổi active trên nút
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');

    // đổi nội dung hiển thị
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    document.getElementById(this.dataset.tab).classList.add('active');
    });
    });
</script>



@code {
    private string TextSdtKH, TextNameKH, TextNote, SelectTypeSP, SelectTienCoc, SelectGiaTheoNgay, TextMota, SelectSizeSP;
    private List<Data.DTOs.InfoThueDoDto> allData = new();
    private List<Data.DTOs.ProductItem> ProductList = new();
    private List<Data.DTOs.InfoThueDoDto> currentPageData = new();
    private string type = "ALL";
    private int month;
    private int year;
    private bool checkNull = false;
    private DotNetObjectReference<ListOrder> objRef;
    private bool isLoading = true, UpdateisLoading = false;

    #region tab1
    private int currentPage = 1;
    private int rowsPerPage = 15;
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < totalPages;
    private int totalPages => (int)Math.Ceiling((decimal)(allData.Count) / rowsPerPage);

    private void UpdateRowsPerPage(int screenHeight)
    {
        int headerHeight = 200; // chiều cao phần menu + header
        int rowHeight = 50;     // chiều cao 1 row (tùy CSS thực tế)

        rowsPerPage = (screenHeight - headerHeight) / rowHeight;
        if (rowsPerPage < 1) rowsPerPage = 1;
    }

    private void LoadPage()
    {
        currentPageData = allData
            .Skip((currentPage - 1) * rowsPerPage)
            .Take(rowsPerPage)
            .ToList();

        StateHasChanged();
    }

    private void NextPage()
    {
        if (currentPage * rowsPerPage < allData.Count)
        {
            currentPage++;
            LoadPage();
        }
    }

    private void PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            LoadPage();
        }
    }

    [JSInvokable]
    public void OnResize(int newHeight)
    {
        UpdateRowsPerPage(newHeight);
        currentPage = 1; // reset về trang đầu khi resize
        LoadPage();
    }

    protected override async Task OnInitializedAsync()
    {
        this.month = DateTime.Now.Month;
        this.year = DateTime.Now.Year;
        ProductList = new List<Data.DTOs.ProductItem>
        {
            new Data.DTOs.ProductItem
            {
                TypeSP = "Loại A",
                TienCoc = "500,000",
                QTYThue = "2",
                Notes = "Không trầy xước",
                PricePerDay = "150,000",
                Size = "L",
                ProductID = "SP001",
                TongTienThue = "800,000"
            },
            new Data.DTOs.ProductItem
            {
                TypeSP = "Loại B",
                TienCoc = "300,000",
                QTYThue = "1",
                Notes = "Màu đen",
                PricePerDay = "100,000",
                Size = "M",
                ProductID = "SP002",
                TongTienThue = "400,000"
            },
            new Data.DTOs.ProductItem
            {
                TypeSP = "Loại A",
                TienCoc = "500,000",
                QTYThue = "2",
                Notes = "Không trầy xước",
                PricePerDay = "150,000",
                Size = "L",
                ProductID = "SP001",
                TongTienThue = "800,000"
            },
            new Data.DTOs.ProductItem
            {
                TypeSP = "Loại B",
                TienCoc = "300,000",
                QTYThue = "1",
                Notes = "Màu đen",
                PricePerDay = "100,000",
                Size = "M",
                ProductID = "SP002",
                TongTienThue = "400,000"
            },
            new Data.DTOs.ProductItem
            {
                TypeSP = "Loại A",
                TienCoc = "500,000",
                QTYThue = "2",
                Notes = "Không trầy xước",
                PricePerDay = "150,000",
                Size = "L",
                ProductID = "SP001",
                TongTienThue = "800,000"
            },
            new Data.DTOs.ProductItem
            {
                TypeSP = "Loại B",
                TienCoc = "300,000",
                QTYThue = "1",
                Notes = "Màu đen",
                PricePerDay = "100,000",
                Size = "M",
                ProductID = "SP002",
                TongTienThue = "400,000"
            }
        };
    }

    private async Task LoadData()
    {
        allData = await GetListThueDo.GetListThueDo(type, year, month);

        checkNull = !(allData != null && allData.Any());

        currentPage = 1;
        LoadPage();
    }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        string kieu = e.Value?.ToString() ?? "All";
        type = kieu switch
        {
            "All" => "ALL",
            "Đã trả" => "RETURN",
            "Chưa trả" => "BORROW",
            "Bị hủy" => "CANCEL",
            _ => "ALL"
        };

        await LoadData();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        month = int.Parse(e.Value?.ToString() ?? DateTime.Now.Month.ToString());
        await LoadData();
    }
    #endregion

    #region tab2
    List<string> ListType;
    [Inject] private IJSRuntime JSx { get; set; }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                isLoading = true;
                var result = await sessionStorage.GetAsync<bool>("isLoggedIn");

                if (result.Success && result.Value)
                {
                    int height = await JS.InvokeAsync<int>("screenHelper.getHeight");
                    UpdateRowsPerPage(height);
                    objRef = DotNetObjectReference.Create(this);
                    await JS.InvokeVoidAsync("screenHelper.registerResizeHandler", objRef);
                    await LoadData();

                    List<Data.DTOs.ListParamater> datapara = await GetListParamater.GetParamater();
                    this.ListType = datapara.Where(x => x.KeyPara == "type").Select(x => x.keyData).OrderBy(x => x).ToList();
                    isLoading = false;
                    StateHasChanged();
                }
                else
                {
                    Navigation.NavigateTo("/", true);
                }
            }
            catch (Exception ex)
            {
            }
        }
    }

    private async void Deletelist(string productId)
    {
        bool confirmed = await JSx.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa sản phẩm này lỏi list không?");
        if (confirmed)
        {
            var item = ProductList.FirstOrDefault(p => p.ProductID == productId);
            if (item != null)
            {
                ProductList.Remove(item);
            }
        }
    }
    #endregion
}

@page "/oderlist"
@using Microsoft.EntityFrameworkCore
@using System.Data
@using FistWeb.Data.Services
@inject Data.AppDbContext Db
@inject GetListThueDo GetListThueDo
@rendermode InteractiveServer
@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@inject NavigationManager Navigation
@inject ProtectedSessionStorage sessionStorage


<div class="tabs">
    <button class="tab-btn active" data-tab="tab1">📝 Danh sách Mượn - Trả đồ</button>
    <button class="tab-btn" data-tab="tab2">Mượn đồ</button>
    <button class="tab-btn" data-tab="tab3">Trả đồ</button>
</div>

<!-- Page control -->
<!-- tab1 -->
<div class="tab-content active" id="tab1">
    <h3>
        Trạng Thái
        <select class="control-select" value="type" @onchange="OnTypeChanged">
            <option>All</option>
            <option>Đã trả</option>
            <option>Chưa trả</option>
            <option>Bị hủy</option>
        </select>
        Tháng
        <select class="control-select" value="month" @onchange="OnMonthChanged">
            @for (int i = 1; i <= 12; i++)
            {
                <option value="@i.ToString("D2")">@i.ToString("D2")</option>
            }
        </select>
    </h3>
    <div class="chart-order">
        @*Hiện lên table*@
        <table class="table-custom">
            <thead>
                <tr>
                    <th>STT</th>
                    <th>Họ tên</th>
                    <th>SĐT/Facebook</th>
                    <th>Ngày mượn</th>
                    <th>Ngày trả</th>
                    <th>Loại sản phẩm</th>
                    <th>Size</th>
                    <th>Số lượng</th>
                    <th>Thành tiền</th>
                    <th>Giá/ngày</th>
                    <th>Tiền cọc</th>
                    <th>Phát sinh</th>
                    <th>Trạng thái</th>
                </tr>
            </thead>
            <tbody>
                @if (currentPageData != null && currentPageData.Any())
                {
                    int count = (currentPage - 1) * rowsPerPage + 1;
                    foreach (var item in currentPageData)
                    {
                        <tr>
                            <td data-label="STT">@count</td>
                            <td data-label="Họ tên">@item.fullname</td>
                            <td data-label="SĐT/Facebook">@item.facebookphone</td>
                            <td data-label="Ngày mượn">@item.borrowdate.ToString("dd/MM/yyyy")</td>
                            <td data-label="Ngày trả">@item.returndate?.ToString("dd/MM/yyyy")</td>
                            <td data-label="Loại sản phẩm">@item.type_production</td>
                            <td data-label="Size">@item.size</td>
                            <td data-label="Số lượng">@item.qty</td>
                            <td data-label="Thành tiền">@item.totalamount</td>
                            <td data-label="Giá/ngày">@item.priceperday</td>
                            <td data-label="Tiền cọc">@item.moneycoc</td>
                            <td data-label="Phát sinh">@item.tienphatsinh</td>
                            <td data-label="Trạng thái">@item.status</td>
                        </tr>
                        count++;
                    }
                }
                else if (checkNull)
                {
                    <tr>
                        <td colspan="13" style="text-align:center">❌ Không có dữ liệu.</td>
                    </tr>
                }
                else
                {
                    <tr>
                        <td colspan="13" style="text-align:center">⏳ Đang tải dữ liệu...</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="pagination">
        <button @onclick="PrevPage" disabled="@(!CanPrev)">
            <i class="fa-solid fa-arrow-left"></i> Trước
        </button>
        <span>Trang @currentPage / @totalPages</span>
        <button @onclick="NextPage" disabled="@(!CanNext)">
            Sau <i class="fa-solid fa-arrow-right"></i>
        </button>
    </div>
</div>

<!-- tab2 -->
<div class="tab-content" id="tab2">
    <h3>📝 Thuê đồ </h3>
    <p>Nội dung quản lý log công việc...</p>
</div>

<!-- tab3 -->
<div class="tab-content" id="tab3">
    <h3>📈 Trả đồ </h3>
    <p>Nội dung biểu đồ phân tích...</p>
</div>

<script>
      window.screenHelper = {
        getHeight: function() {
            return window.innerHeight;
        },
        registerResizeHandler: function(dotNetHelper) {
            window.addEventListener('resize', () => {
                dotNetHelper.invokeMethodAsync('OnResize', window.innerHeight);
            });
        }
    };
    document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', function() {
            // đổi active trên nút
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');

            // đổi nội dung hiển thị
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            document.getElementById(this.dataset.tab).classList.add('active');
        });
    });
</script>


@code {
    private List<Data.DTOs.InfoThueDoDto> allData = new();
    private List<Data.DTOs.InfoThueDoDto> currentPageData = new();
    private string type = "ALL";
    private int month;
    private int year;
    private bool checkNull = false;
    private DotNetObjectReference<ListOrder> objRef;

    #region phân trang
    private int currentPage = 1;
    private int rowsPerPage = 15;
    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < totalPages;
    private int totalPages => (int)Math.Ceiling((decimal)(allData.Count) / rowsPerPage);


    private void UpdateRowsPerPage(int screenHeight)
    {
        int headerHeight = 200; // chiều cao phần menu + header
        int rowHeight = 50;     // chiều cao 1 row (tùy CSS thực tế)

        rowsPerPage = (screenHeight - headerHeight) / rowHeight;
        if (rowsPerPage < 1) rowsPerPage = 1;
    }

    private void LoadPage()
    {
        currentPageData = allData
            .Skip((currentPage - 1) * rowsPerPage)
            .Take(rowsPerPage)
            .ToList();

        StateHasChanged();
    }

    private void NextPage()
    {
        if (currentPage * rowsPerPage < allData.Count)
        {
            currentPage++;
            LoadPage();
        }
    }

    private void PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            LoadPage();
        }
    }

    [JSInvokable]
    public void OnResize(int newHeight)
    {
        UpdateRowsPerPage(newHeight);
        currentPage = 1; // reset về trang đầu khi resize
        LoadPage();
    }
    #endregion

    protected override async Task OnInitializedAsync()
    {   
        this.month = DateTime.Now.Month;
        this.year = DateTime.Now.Year;
    }

    private async Task LoadData()
    {
        allData = await GetListThueDo.GetListThueDo(type, year, month);

        checkNull = !(allData != null && allData.Any());

        currentPage = 1;
        LoadPage();
    }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        string kieu = e.Value?.ToString() ?? "All";
        type = kieu switch
        {
            "All" => "ALL",
            "Đã trả" => "RETURN",
            "Chưa trả" => "BORROW",
            "Bị hủy" => "CANCEL",
            _ => "ALL"
        };

        await LoadData();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        month = int.Parse(e.Value?.ToString() ?? DateTime.Now.Month.ToString());
        await LoadData();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var result = await sessionStorage.GetAsync<bool>("isLoggedIn");

                if (result.Success && result.Value)
                {
                    int height = await JS.InvokeAsync<int>("screenHelper.getHeight");
                    UpdateRowsPerPage(height);
                    objRef = DotNetObjectReference.Create(this);
                    await JS.InvokeVoidAsync("screenHelper.registerResizeHandler", objRef);
                    await LoadData();
                }
                else
                {
                    Navigation.NavigateTo("/", true);
                }
            }
            catch (Exception ex)
            {
            }
        }
    }
}

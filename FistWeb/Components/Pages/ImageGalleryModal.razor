    /*-----------------buttong back and next-------------------*/

    .pagination {
        margin-top: 15px;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        font-family: Arial, sans-serif;
    }

        .pagination button {
            padding: 8px 16px;
            border: none;
            border-radius: 25px; /* bo tròn */

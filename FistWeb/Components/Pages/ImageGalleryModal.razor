                transform: translateY(-2px) scale(1.05);
                background: linear-gradient(135deg, #1f78d1, #1257a0);
                box-shadow: 0 6px 12px rgba(0,0,0,0.3);
            }

            .pagination button:disabled {
                background: #ccc;
                cursor: not-allowed;
                box-shadow: none;
                transform: none;
            }

        .pagination span {
            font-size: 14px;
            font-weight: bold;
            color: #333;
        }


    /*-------------------*/
</style>

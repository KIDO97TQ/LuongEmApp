@code {
    [Parameter]
    public List<Data.DTOs.ProductImageDto> ProductInfo { get; set; } = new();
    [Parameter]
    public EventCallback<Data.DTOs.ProductImageDto> OnImageSelected { get; set; }
    [Parameter]
    public EventCallback OnClose { get; set; }

    private List<Data.DTOs.ProductImageDto> currentPageImages;
    private int pageSize = 10;
    private int currentPage = 1;

    private string priceSort = "none";
    private string selectedPrice = "all";
    private List<decimal> priceGroups = new();

    private int totalPages => (int)Math.Ceiling((double)ProductInfo.Count / pageSize);

    protected override void OnParametersSet()
    {
        priceGroups = ProductInfo
        .GroupBy(x => x.Price)
        .Select(x => x.Key)
        .OrderBy(x => x)
        .ToList();

        selectedPrice = "all";
        LoadImagesForPage(1);
    }

    // private void LoadImagesForPage(int page)
    // {
    //     currentPage = page;
    //     currentPageImages = ProductInfo
    //         .Skip((page - 1) * pageSize)
    //         .Take(pageSize)
    //         .ToList();
    // }

    private void LoadImagesForPage(int page)
    {
        currentPage = page;

        IEnumerable<Data.DTOs.ProductImageDto> query = ProductInfo;

        // Lọc theo giá
        if (selectedPrice != "all")
        {
            decimal price = decimal.Parse(selectedPrice);

            query = query.Where(x => x.Price == price);
        }

        // Sắp xếp giá
        if (priceSort == "asc")
        {
            query = query.OrderBy(x => x.Price);
        }
        else if (priceSort == "desc")
        {
            query = query.OrderByDescending(x => x.Price);
        }

        currentPageImages = query
            .Skip((page - 1) * pageSize)
            .Take(pageSize)
            .ToList();
    }

    private void OnPriceChanged()
    {
        LoadImagesForPage(1);
    }

    private void OnPriceSortChanged()
    {
        LoadImagesForPage(1);
    }


    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            LoadImagesForPage(currentPage - 1);
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            LoadImagesForPage(currentPage + 1);
        }
    }
    private async Task SelectImage(Data.DTOs.ProductImageDto selectedImage)
    {
        await OnImageSelected.InvokeAsync(selectedImage);
        await OnClose.InvokeAsync(null);
    }
}

<div class="modal-backdrop" @onclick="() => OnClose.InvokeAsync(null)"></div>

<div class="modal-content">
    <h3>Ảnh về sản phẩm</h3>

    <div class="filter-container">

        <!-- Group theo giá -->
        <div class="filter-item">
            <label>Giá:</label>

            <select @bind="selectedPrice" @bind:after="OnPriceChanged">
                <option value="all">Tất cả giá</option>

                @foreach (var price in priceGroups)
                {
                    <option value="@price">
                        @price.ToString("#,##0").Replace(",", ".") vnđ
                    </option>
                }
            </select>
        </div>


        <!-- Sort giá -->
        <div class="filter-item">
            <label>Sắp xếp:</label>

            <select @bind="priceSort" @bind:after="OnPriceSortChanged">
                <option value="none">Mặc định</option>
                <option value="asc">Giá thấp → cao</option>
                <option value="desc">Giá cao → thấp</option>
            </select>
        </div>

    </div>

    @if (currentPageImages == null || !currentPageImages.Any())
    {
        <p>Không có ảnh để hiển thị.</p>
    }
    else
    {
        <div class="image-grid">
            @foreach (var item in currentPageImages)
            {
                <div class="image-item" @onclick="() => SelectImage(item)">
                    <img loading="lazy" src="https://raw.githubusercontent.com/kido1997/ImageLuongEm/main/ImageLuongEm/@item.ImageUrl" />
                    <div class="info">
                        <div><strong>Giá:</strong> @item.Price.ToString("#,##0").Replace(",", ".") vnđ</div>
                        <div><strong>Số lượng còn:</strong> @item.SaveQTY</div>
                        <div><strong>Size:</strong> @item.Size</div>
                        <div><strong>Mô tả:</strong> @item.Desc</div>
                    </div>
                </div>
            }
        </div>


        @if (totalPages > 1)
        {
            <div class="pagination">
                <button @onclick="PreviousPage" disabled="@(currentPage == 1)">
                    <i class="fa-solid fa-arrow-left"></i> Trước
                </button>
                <span>Trang @currentPage / @totalPages</span>
                <button @onclick="NextPage" disabled="@(currentPage == totalPages)">
                    Sau <i class="fa-solid fa-arrow-right"></i>
                </button>
            </div>
        }
    }

    <button class="close-button" @onclick="() => OnClose.InvokeAsync(null)">Đóng</button>
</div>




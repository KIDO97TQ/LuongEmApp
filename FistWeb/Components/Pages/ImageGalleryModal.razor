        height: 90%;
        overflow: auto;
    }

    .close-button {
        display: block;
        margin: 20px auto 0;
        padding: 8px 16px;
        background-color: #dc3545;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

    .close-button:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
    }

    .image-item {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    border: 1px solid #ccc;
    padding: 8px;
    height: 100%;
    box-sizing: border-box;
    background-color: #f9f9f9;
    border-radius: 6px;
    box-shadow: 0 1px 4px rgba(0,0,0,0.1);
}

.image-item img {
    width: 100%;
    border-radius: 4px;

    public List<string> GetRandomColorList(int count)
    {
        var random = new Random();
        var colors = new List<string>();
        for (int i = 0; i < count; i++)
        {
            colors.Add($"rgba({random.Next(256)}, {random.Next(256)}, {random.Next(256)}, 0.7)");
        }
        return colors;
    }


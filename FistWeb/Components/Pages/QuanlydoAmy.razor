<div class="tabs">
    <button class="tab-btn active" data-tab="tab1">
        <img src="add-product.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Thêm đồ
    </button>
    <button class="tab-btn" data-tab="tab2">
        <img src="edit.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Sửa thông tin đồ
    </button>
    <button class="tab-btn" data-tab="tab3">
        <img src="statistics.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">
        Tổng hợp đồ
    </button>
    <button class="tab-btn" data-tab="tab4">
        <img src="details.png" alt="icon" style="width: 25px; height: 25px; margin-right: 6px;">

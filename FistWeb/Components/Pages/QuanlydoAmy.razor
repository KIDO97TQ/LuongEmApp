@* tab4 *@
<div class="tab-content" id="tab4">
    <div class="modal-content">
        <div class="staff-header">
            <div class="staff-controls">
                <img src="details.png" alt="icon" style="width: 35px; height: 35px; margin-right: 6px;">
                <h3>Chi tiết sản phẩm</h3>
            </div>
            <div class="staff-controls">
                <select class="control-select" value="typeSelect" @onchange="GetImageByProductID1">
                    <option value="all">All</option>
                    @{
                        if (this.ListType != null && !isLoading)
                        {
                            foreach (var item in this.ListType)
                            {
                                <option value="@item">@item</option>
                            }
                        }
                    }
                </select>
            </div>
        </div>

        @if (currentPageImages == null || !currentPageImages.Any())
        {
            <p>Không có ảnh để hiển thị.</p>
        }
        else
        {
            @if (isLoadingImages)
            {
                <div class="loading-overlay">
                    <div class="spinnerIMG"></div>
                    <p>Đang tải ảnh...</p>
                </div>
            }
            else
            {
                <div class="image-grid">
                    @foreach (var item in currentPageImages)
                    {
                        <div class="image-item" style="cursor:pointer;">
                            <img loading="lazy" src="https://raw.githubusercontent.com/kido1997/ImageLuongEm/main/ImageLuongEm/@item.ImageUrl" alt="Image" />
                            <div class="info">
                                <div><strong>Loại sp:</strong> @item.TypeSP</div>
                                <div><strong>Tên sp:</strong> @item.NameSP</div>
                                <div><strong>Giá:</strong> @item.Price Vnđ</div>
                                <div><strong>Số lượng còn:</strong> @item.SaveQTY.ToString()</div>
                                <div><strong>Size:</strong> @item.Size</div>
                                <div><strong>Mô tả:</strong> @item.Desc</div>
                            </div>
                        </div>
                    }
                </div>

                @if (totalPages > 1)
                {
                    <div class="pagination">
                        <button @onclick="PreviousPage" disabled="@(currentPage == 1)">
                            <i class="fa-solid fa-arrow-left"></i> Trước
                        </button>
                        <span>Trang @currentPage / @totalPages</span>
                        <button @onclick="NextPage" disabled="@(currentPage == totalPages)">
                            Sau <i class="fa-solid fa-arrow-right"></i>
                        </button>
                    </div>
                }

            }
        }
    </div>
</div>

<script>
    document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', function() {
    // đổi active trên nút
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');

    // đổi nội dung hiển thị
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    document.getElementById(this.dataset.tab).classList.add('active');
    });
    });
</script>


@code {
    private int month;
    private int year;
    private List<Data.DTOs.ListParamater> datapara = new();
    private List<Data.DTOs.ProductStock> dataWH = new();
    List<string> ListType;
    List<string> ListPrice;
    private bool isLoading = true, UpdateisLoading = false, UpdateisLoading2 = false;
    private string newValueSP, newValuePrice, SelectValueSP, SelectValuePrice, TextValueNameSP, TextValueSizeSP, TextValueQTY, TextValueDesc;
    private string typeSelect, typeWHSelect;
    [Inject] private IJSRuntime JSx { get; set; }
    private bool isLoadingService = true;
    private bool _disposed = false;
    private CancellationTokenSource cts = new();

    public void Dispose()
    {
        _disposed = true;
        cts.Cancel();
        cts.Dispose();
    }
    #region tab4
    private bool isLoadingImages = false;
    private List<Data.DTOs.ProductImageDto> currentPageImages;
    private List<Data.DTOs.ProductImageDto> ProductInfoShowIMG = new();
    private int pageSize = 10;
    private int currentPage = 1;

    private int totalPages => (int)Math.Ceiling((double)ProductInfoShowIMG.Count / pageSize);

    private async void GetImageByProductID1(ChangeEventArgs e)
    {
        typeSP = e.Value?.ToString() ?? "";
        if (typeSP == "all")
            typeSP = "";
        ProductInfoShowIMG = await GetImageByProID1.GetProductID1Amy(typeSP);
        LoadImagesForPage(1);
        StateHasChanged();
    }

    private void LoadImagesForPage(int page)
    {
        isLoadingImages = true;
        StateHasChanged();

        currentPage = page;
        currentPageImages = ProductInfoShowIMG
            .Skip((page - 1) * pageSize)
            .Take(pageSize)
            .ToList();
        isLoadingImages = false;
    }

    private void PreviousPage()
    {
        if (currentPage > 1)
        {
            LoadImagesForPage(currentPage - 1);
        }
    }

    private void NextPage()
    {
        if (currentPage < totalPages)
        {
            LoadImagesForPage(currentPage + 1);
        }
    }
    #endregion

    #region add SP

    private ValueTask OnBeforeNavigation(LocationChangingContext context)
    {
        if (isLoadingService)
        {
            context.PreventNavigation();
        }
        return ValueTask.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        this.month = int.Parse(DateTime.Now.Month.ToString());
        this.year = int.Parse(DateTime.Now.Year.ToString());
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {

                LoadingService.Begin();
                bool isLoggedIn = await localStorage.GetItemAsync<bool>("isLoggedIn");
                if (isLoggedIn)
                {
                    isLoading = true;
                    await GetMaterialInWH(true, false);
                    ProductInfoShowIMG = await GetImageByProID1.GetProductID1Amy(typeSP);
                    datapara = await GetListParamater.GetParamater();
                    this.ListType = datapara.Where(x => x.KeyPara == "typeAmy").Select(x => x.keyData).OrderBy(x => x).ToList();
                    this.ListPrice = datapara.Where(x => x.KeyPara == "priceAmy")
                                         .OrderBy(x =>
                                         {
                                             if (decimal.TryParse(x.keyData, out var number))
                                                 return number;
                                             return decimal.MaxValue;
                                         })
                                         .Select(x => x.keyData)
                                         .ToList();
                    LoadImagesForPage(1);
                    isLoading = false;
                    if (!_disposed)
                    {
                        StateHasChanged();
                    }
                    LoadingService.End();
                    isLoadingService = false;
                }
                else
                {
                    LoadingService.End();
                    isLoadingService = false;
                    Navigation.NavigateTo("/", true);

                }
            }
            catch (Exception)
            {
                LoadingService.End();
                isLoadingService = false;
                throw;
            }
        }

    }

    private async Task addSpClick()
    {
        if (string.IsNullOrEmpty(newValueSP))
        { return; }
        isLoading = true;
        List<Data.DTOs.ListParaUser> datapara = await GetSPInfo.GetLoginUser("typeAmy", newValueSP.ToUpper(), null);
        if (datapara != null && datapara.Any())
        {
            await JS.InvokeVoidAsync("alert", $"Loại sp ({newValueSP}) đã tồn tại!");
            isLoading = false;
        }
        else
        {

            int checkInsert = await AddPara.InsertParamaterRawAsync("typeAmy", newValueSP, null);
            if (checkInsert > 0)
            {
                List<Data.DTOs.ListParamater> data = await GetListParamater.GetParamater();
                this.ListType = data.Where(x => x.KeyPara == "typeAmy").Select(x => x.keyData).OrderBy(x => x).ToList();
                isLoading = false;
                await JS.InvokeVoidAsync("closeAllOptionMenus");
                await JS.InvokeVoidAsync("alert", $"Thêm loại sp ({newValueSP}) thành công!");
                newValueSP = "";
                StateHasChanged();
            }
            else
            {
                isLoading = false;
                await JS.InvokeVoidAsync("alert", $"Thêm loại sp ({newValueSP}) không thành công!");
            }
        }
    }

    private async Task XoaSpClick()
    {
        if (string.IsNullOrEmpty(SelectValueSP))
        {
            await JS.InvokeVoidAsync("alert", "Vui lòng chọn loại SP cần xóa trước");
            await JS.InvokeVoidAsync("closeAllOptionMenus");
            return;
        }
        bool confirmed = await JSx.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa sản phẩm này không?");

        if (confirmed)
        {
            isLoading = true;
            int checkInsert = await DeletePara.DeleteParamaterRawAsync("typeAmy", SelectValueSP, null);
            if (checkInsert > 0)
            {
                List<Data.DTOs.ListParamater> data = await GetListParamater.GetParamater();
                this.ListType = data.Where(x => x.KeyPara == "typeAmy").Select(x => x.keyData).OrderBy(x => x).ToList();
                isLoading = false;
                await JS.InvokeVoidAsync("closeAllOptionMenus");
                await JS.InvokeVoidAsync("alert", $"Delete loại sp ({SelectValueSP}) thành công!");
                newValueSP = "";
                StateHasChanged();
            }
            else
            {
                isLoading = false;
                await JS.InvokeVoidAsync("alert", $"Delete loại sp ({newValueSP}) không thành công!");
            }
        }
    }

    private async Task addPriceClick()
    {
        if (string.IsNullOrEmpty(newValuePrice))
        { return; }
        isLoading = true;
        List<Data.DTOs.ListParaUser> datapara = await GetSPInfo.GetLoginUser("priceAmy", newValuePrice, null);
        if (datapara != null && datapara.Any())
        {
            await JS.InvokeVoidAsync("alert", $"Giá sp ({newValuePrice}) đã tồn tại!");
            isLoading = false;
        }
        else
        {
            int checkInsert = await AddPara.InsertParamaterRawAsync("priceAmy", newValuePrice, null);
            if (checkInsert > 0)
            {

                List<Data.DTOs.ListParamater> data = await GetListParamater.GetParamater();
                this.ListPrice = data.Where(x => x.KeyPara == "priceAmy")
                                     .OrderBy(x =>
                                     {
                                         if (decimal.TryParse(x.keyData, out var number))
                                             return number;
                                         return decimal.MaxValue;
                                     })
                                     .Select(x => x.keyData)
                                     .ToList();
                isLoading = false;
                await JS.InvokeVoidAsync("closeAllOptionMenus");
                await JS.InvokeVoidAsync("alert", $"Thêm Giá sp ({newValuePrice}) thành công!");
                newValuePrice = "";
                StateHasChanged();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Thêm Giá sp ({newValuePrice}) không thành công!");
                isLoading = false;
            }
        }
    }

    private async Task XoaPriceClick()
    {

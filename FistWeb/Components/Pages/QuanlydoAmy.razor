    string GetFileExtension(string contentType) => contentType switch
    {
        "image/jpeg" => ".jpg",
        "image/png" => ".png",
        "image/gif" => ".gif",
        "image/webp" => ".webp",
        "image/bmp" => ".bmp",
        _ => "bin" // mặc định nếu không biết
    };

    private async Task UploadSP()
    {
        try
        {
            if (string.IsNullOrEmpty(SelectValuePrice) || string.IsNullOrEmpty(SelectValueSP)
            || string.IsNullOrEmpty(TextValueNameSP) || string.IsNullOrEmpty(TextValueSizeSP) || string.IsNullOrEmpty(TextValueQTY))
            {
                await JS.InvokeVoidAsync("alert", $"Vui lòng điền đầy đủ thông tin trước!");
                return;
            }
            if (fileStream == null || uploadedFile == null)
            {
                await JS.InvokeVoidAsync("alert", "Chưa chọn ảnh");
                return;
            }
            fileStream.Position = 0;
            UpdateisLoading = true;

            long productID = long.Parse(DateTime.Now.ToString("yyyyMMddHHmmss"));
            Decimal PriceSP = decimal.Parse(Regex.Match(SelectValuePrice.Trim(), @"\d+(\.\d+)?").Value);
            int QtySP = int.Parse(TextValueQTY);

            string contentType = GetFileExtension(uploadedFile.ContentType);
            var fileName = productID.ToString() + contentType;
            await fileStream.CopyToAsync(fileStream);
            var base64Data = Convert.ToBase64String(fileStream.ToArray());

            var success = await UploadToGitHubAsync(base64Data.ToString(), fileName.ToString());
            if (success)
            {
                int checkInsert = await InserSP.InserProductAmy(productID, TextValueNameSP, TextValueDesc, PriceSP, QtySP, TextValueSizeSP, SelectValueSP);
                if (checkInsert > 0)
                {
                    fileStream.Dispose();
                    fileStream = null;
                    openImage = false;
                    previewImageUrl = null;
                    uploadedFile = null;
                    SelectValuePrice = null;
                    SelectValueSP = null;
                    TextValueNameSP = null;
                    TextValueSizeSP = null;
                    TextValueQTY = null;
                    TextValueDesc = null;

                    await JS.InvokeVoidAsync("alert", "Thêm Sp mới ok!");
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "Thêm Sp mới lỗi!");
                }
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Upload thất bại");
            }
            UpdateisLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Lỗi khi upload ảnh: {ex.Message}");
        }
    }

    private async Task<bool> UploadToGitHubAsync(string base64Content, string fileName)
    {
        List<Data.DTOs.ListParaUser> datapara = await GetUserInfo.GetLoginUser("tocken", null, null);
        string tokennnn = datapara[0].keyUsername;
        string owner = "kido1997";
        string repo = "ImageLuongEm";
        string pathInRepo = $"ImageLuongEm/{fileName}";
        string commitMessage = $"Upload {fileName}";

        var result = await UploadImageToGitHubAsync(tokennnn, owner, repo, pathInRepo, base64Content, commitMessage);
        return result;
    }

    private async Task<bool> UploadImageToGitHubAsync(string tokennnn, string owner, string repo, string pathInRepo, string base64Content, string commitMessage)
    {
        using var http = new HttpClient();

        http.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("token", tokennnn);

        http.DefaultRequestHeaders.UserAgent.ParseAdd("BlazorUploader");
        string putUrl = $"https://api.github.com/repos/{owner}/{repo}/contents/{pathInRepo}";

        var payload = new
        {
            message = commitMessage,
            content = base64Content,
            branch = "main"
        };

        var json = JsonSerializer.Serialize(payload);

        var request = new HttpRequestMessage(HttpMethod.Put, putUrl)
        {
            Content = new StringContent(json, Encoding.UTF8, "application/json")
        };

        var response = await http.SendAsync(request);
        if (!response.IsSuccessStatusCode)
        {
            var error = await response.Content.ReadAsStringAsync();
            string message = $"❌ GitHub PUT error: {response.StatusCode} - {error}";
            await JS.InvokeVoidAsync("alert", $"Lỗi khi upload ảnh: {message}");

            return false;
        }

        return response.IsSuccessStatusCode;
    }


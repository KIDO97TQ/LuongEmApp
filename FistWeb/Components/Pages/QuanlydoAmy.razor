    private async Task<bool> DeleteImageFromGitHubAsync(string tokennnn, string owner, string repo, string pathInRepo, string commitMessage)
    {
        using var http = new HttpClient();

        http.DefaultRequestHeaders.Authorization =
            new System.Net.Http.Headers.AuthenticationHeaderValue("token", tokennnn);
        http.DefaultRequestHeaders.UserAgent.ParseAdd("BlazorUploader");

        string getUrl = $"https://api.github.com/repos/{owner}/{repo}/contents/{pathInRepo}";
        var getResp = await http.GetAsync(getUrl);

        if (!getResp.IsSuccessStatusCode)
        {
            var err = await getResp.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"❌ Không tìm thấy file để xóa: {err}");
            return false;
        }

        var contentJson = await getResp.Content.ReadAsStringAsync();
        using var doc = JsonDocument.Parse(contentJson);
        string sha = doc.RootElement.GetProperty("sha").GetString();

        var payload = new
        {
            message = commitMessage,
            sha = sha,
            branch = "main"
        };

        string json = JsonSerializer.Serialize(payload);

        var request = new HttpRequestMessage(HttpMethod.Delete, getUrl)
        {
            Content = new StringContent(json, Encoding.UTF8, "application/json")
        };

        var deleteResp = await http.SendAsync(request);
        if (!deleteResp.IsSuccessStatusCode)
        {
            var error = await deleteResp.Content.ReadAsStringAsync();
            await JS.InvokeVoidAsync("alert", $"❌ Lỗi xóa ảnh GitHub: {error}");
            return false;
        }

        return true;
    }


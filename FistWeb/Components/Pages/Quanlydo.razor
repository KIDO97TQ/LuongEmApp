@page "/quanlydo"
@using Microsoft.EntityFrameworkCore
@using System.Data
@using FistWeb.Data.Services
@inject Data.AppDbContext Db
@inject GetListThueDo GetListThueDo
@rendermode InteractiveServer


<div class="container">
    <div class="content">

        <div class="tabs">
            <button class="tab-btn active" data-tab="tab1">📝 Danh sách Mượn - Trả đồ</button>
            <button class="tab-btn" data-tab="tab2">Mượn đồ</button>
            <button class="tab-btn" data-tab="tab3">Trả đồ</button>
        </div>

        <div class="tab-content active" id="tab1">
            <h3>
                Trạng Thái
                <select class="control-select" value="type" @onchange="OnTypeChanged">
                    <option>All</option>
                    <option>Đã trả</option>
                    <option>Chưa trả</option>
                    <option>Bị hủy</option>
                </select>
                Tháng
                <select class="control-select" value="month" @onchange="OnMonthChanged">
                    @for (int i = 1; i <= 12; i++)
                    {
                        <option value="@i.ToString("D2")">@i.ToString("D2")</option>
                    }
                </select>
            </h3>
            <div class="chart-order">
                @*Hiện lên table*@
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th>STT</th>
                            <th>Họ tên</th>
                            <th>SĐT/Facebook</th>
                            <th>Ngày mượn</th>
                            <th>Ngày trả</th>
                            <th>Loại sản phẩm</th>
                            <th>Size</th>
                            <th>Số lượng</th>
                            <th>Thành tiền</th>
                            <th>Giá/ngày</th>
                            <th>Tiền cọc</th>
                            <th>Phát sinh</th>
                            <th>Trạng thái</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (InfoThueDoDto != null && InfoThueDoDto.Any())
                        {
                            int count = (currentPage - 1) * pageSize + 1;
                            foreach (var item in PagedData)
                            {
                                <tr>
                                    <td>@count</td>
                                    <td>@item.fullname</td>
                                    <td>@item.facebookphone</td>
                                    <td>@item.borrowdate.ToString("dd/MM/yyyy")</td>
                                    <td>@item.returndate?.ToString("dd/MM/yyyy")</td>
                                    <td>@item.type_production</td>
                                    <td>@item.size</td>
                                    <td>@item.qty</td>
                                    <td>@item.totalamount</td>
                                    <td>@item.priceperday</td>
                                    <td>@item.moneycoc</td>
                                    <td>@item.tienphatsinh</td>
                                    <td>@item.status</td>
                                </tr>
                                count++;
                            }
                        }
                        else if (checkNull)
                        {
                            <tr>
                                <td colspan="13" style="text-align:center">❌ Không có dữ liệu.</td>
                            </tr>
                        }
                        else
                        {
                            <tr>
                                <td colspan="13" style="text-align:center">⏳ Đang tải dữ liệu...</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Page control -->
        <div class="pagination">
            <button @onclick="PrevPage" disabled="@(!CanPrev)">
                <i class="fa-solid fa-arrow-left"></i> Trước
            </button>
            <span>Trang @currentPage / @totalPages</span>
            <button @onclick="NextPage" disabled="@(!CanNext)">
                Sau <i class="fa-solid fa-arrow-right"></i>
            </button>
        </div>

        <div class="tab-content" id="tab2">
            <h3>📝 Thuê đồ </h3>
            <p>Nội dung quản lý log công việc...</p>
        </div>

        <div class="tab-content" id="tab3">
            <h3>📈 Trả đồ </h3>
            <p>Nội dung biểu đồ phân tích...</p>
        </div>
        <script>
            document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', function () {
            // đổi active trên nút
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            this.classList.add('active');

            // đổi nội dung hiển thị
            document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
            document.getElementById(this.dataset.tab).classList.add('active');
            });
            });
        </script>
    </div>
</div>


@code {
    private List<Data.DTOs.InfoThueDoDto> InfoThueDoDto;
    private string type = "ALL";
    private int month;
    private int year;
    private bool checkNull = false;

    #region phân trang
    private int currentPage = 1;
    private int pageSize = 14;
    private int totalPages => (int)Math.Ceiling((decimal)(InfoThueDoDto?.Count ?? 0) / pageSize);

    private IEnumerable<Data.DTOs.InfoThueDoDto> PagedData
        => InfoThueDoDto
            ?.Skip((currentPage - 1) * pageSize)
            .Take(pageSize);

    private bool CanPrev => currentPage > 1;
    private bool CanNext => currentPage < totalPages;

    private void PrevPage()
    {
        if (CanPrev)
        {
            currentPage--;
        }
    }

    private void NextPage()
    {
        if (CanNext)
        {
            currentPage++;
        }
    }
    #endregion

    protected override async Task OnInitializedAsync() //Được gọi khi component khởi tạo lần đầu tiên
    {
        this.month = int.Parse(DateTime.Now.Month.ToString());
        this.year = int.Parse(DateTime.Now.Year.ToString());

    }

    private async Task OnTypeChanged(ChangeEventArgs e)
    {
        this.checkNull = false;
        string kieu = e.Value.ToString();
        type = kieu switch
        {
            "All" => "ALL",
            "Đã trả" => "RETURN",
            "Chưa trả" => "BORROW",
            "Bị hủy" => "CANCEL",
            _ => "ALL"
        };

        InfoThueDoDto = await GetListThueDo.GetListThueDo(type, year, month);
        if (InfoThueDoDto != null && InfoThueDoDto.Any()) { }
        else
        {
            this.checkNull = true;
        }
        StateHasChanged();
    }

    private async Task OnMonthChanged(ChangeEventArgs e)
    {
        this.checkNull = false;
        month = int.Parse(e.Value.ToString());

        InfoThueDoDto = await GetListThueDo.GetListThueDo(type, year, month);
        if (InfoThueDoDto != null && InfoThueDoDto.Any()) { }
        else
        {
            this.checkNull = true;
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)//Sau khi UI render xong
    {
        if (firstRender)
        {
            InfoThueDoDto = await GetListThueDo.GetListThueDo(type, year, month);
            if (InfoThueDoDto != null && InfoThueDoDto.Any()) { }
            else
            {
                this.checkNull = true;
            }
            StateHasChanged();
        }
    }
}

@page "/quanlydo"
@using Microsoft.EntityFrameworkCore
@using System.Data
@using System.Text.Json
@using FistWeb.Data.Services
@using System.Text.RegularExpressions
@inject Data.AppDbContext Db
@inject IGetParamaterService GetListParamater
@rendermode InteractiveServer
@inject IJSRuntime JS
@using System.Globalization
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage;
@inject NavigationManager Navigation
@inject ProtectedSessionStorage sessionStorage
@inject IGetParaUserService GetSPInfo
@inject IAddParaService AddPara
@inject IDeleteParaService DeletePara
@inject IInsertSPService InserSP
@inject IGetSumWHService GetTotalWH
@inject HttpClient Http


<div class="tabs">
    <button class="tab-btn active" data-tab="tab1">Thêm - Sửa - Xóa đồ</button>
    <button class="tab-btn" data-tab="tab3">Tổng hợp đồ</button>
</div>

@* tab1 *@
<div class="tab-content active" id="tab1">
    <div class="form-container">
        <div class="form-content">
            <!-- Right side - Image -->
            <div class="form-section-right">
                <label for="fileInput" class="image-upload-area">
                    @if (!openImage)
                    {
                        <div class="image-upload-icon">📷</div>
                        <div class="image-upload-text">Click để tải ảnh lên</div>
                    }
                    <img src="@previewImageUrl" style="max-width: 100%; margin-top: 10px;" />
                </label>
                <InputFile id="fileInput" OnChange="OnFileSelected" accept="image/*" style="display:none" />
            </div>
            <!-- Left side - Form -->
            <div class="form-section-left">
                <!-- Tên SP -->
                <div class="form-group">
                    <label class="form-label">Tên SP:</label>
                    <input type="text" @bind="TextValueNameSP" @bind:event="oninput" class="form-input" placeholder="Nhập tên sản phẩm..." />
                    <div></div>
                </div>

                <!-- Loại SP -->
                <div class="form-group">
                    <label class="form-label">Loại SP:</label>
                    <select class="form-select" @bind="SelectValueSP" @bind:event="oninput">
                        <option value="">Chọn loại sản phẩm</option>
                        @{
                            if (this.ListType != null && !isLoading)
                            {
                                foreach (var item in this.ListType)
                                {
                                    <option value="@item">@item</option>
                                }
                            }
                        }
                    </select>
                    @if (isLoading)
                    {
                        <div class="spinner" style="margin-top:10px;"></div>
                    }
                    else
                    {
                        <div class="option-wrapper">
                            <button class="btn btn-option" onclick="toggleOptionMenu(this)"><span>...</span> Option</button>
                            <div class="option-menu">
                                @* <div class="option-item" @onclick="EnableEditing">➕ Thêm</div> *@
                                <div class="New-price">
                                    <input id="priceInput" type="text"
                                           @bind="newValueSP"
                                           @bind:event="oninput"
                                           placeholder="Thêm mới loại sp..." />

                                    <button class="option-itemAdd" type="button" @onclick="addSpClick">
                                        <i class="bi-option bi-plus-circle-fill"></i>
                                    </button>
                                </div>
                                <div class="option-item" @onclick="XoaSpClick">🗑️ Xóa loại sp đang chọn</div>

                            </div>
                        </div>
                    }
                </div>

                <!-- Size SP -->
                <div class="form-group">
                    <label class="form-label">Size SP:</label>
                    <input type="text" @bind="TextValueSizeSP" @bind:event="oninput" class="form-input" placeholder="S, M, L, XL..." />
                    <div></div>
                </div>

                <!-- Giá thuê theo ngày -->
                <div class="form-group">
                    <label class="form-label">Giá thuê theo ngày:</label>
                    <select class="form-select" @bind="SelectValuePrice" @bind:event="oninput">
                        <option value="">Chọn mức giá</option>
                        @{
                            if (this.ListPrice != null && !isLoading)
                            {
                                @foreach (var item in this.ListPrice)
                                {
                                    if (decimal.TryParse(item, NumberStyles.Number, new CultureInfo("vi-VN"), out var parsedValue))
                                    {
                                        <option value="@item">@parsedValue.ToString("N0", new CultureInfo("vi-VN")) Vnđ</option>
                                    }
                                }
                            }
                        }
                    </select>
                    @if (isLoading)
                    {
                        <div class="spinner" style="margin-top:10px;"></div>
                    }
                    else
                    {
                        <div class="option-wrapper">
                            <button class="btn btn-option" onclick="toggleOptionMenu(this)"><span>...</span> Option</button>

                            <div class="option-menu">
                                <div class="New-price">
                                    <input id="priceInput" type="text"
                                           @bind="newValuePrice"
                                           placeholder="Thêm mới mức giá..."
                                           @oninput="OnPriceInput"
                                           autofocus />
                                    <button class="option-itemAdd" type="button" @onclick="addPriceClick">
                                        <i class="bi-option bi-plus-circle-fill"></i>
                                    </button>
                                </div>
                                <div class="option-item" @onclick="XoaPriceClick">🗑️ Xóa giá sp đang chọn</div>
                            </div>
                        </div>
                    }
                </div>

                <!-- Số lượng -->
                <div class="form-group">
                    <label class="form-label">Số lượng:</label>
                    <input type="number" @bind="TextValueQTY" @bind:event="oninput" class="form-input" placeholder="Nhập số lượng..." min="1" />
                    <div></div>
                </div>

                <!-- Mô tả thêm về SP -->
                <div class="form-group">
                    <label class="form-label">Mô tả thêm về SP:</label>
                    <textarea class="form-input" @bind="TextValueDesc" @bind:event="oninput" rows="4" placeholder="Mô tả chi tiết về sản phẩm..."></textarea>
                    <div></div>
                </div>

                <!-- store info -->
                <div class="store-info">
                    @if (UpdateisLoading)
                    {
                        <div class="spinner" style="margin-top:10px;"></div>
                    }
                    else
                    {
                        <button class="button-add" type="button" @onclick="UploadSP"><i class="bi bi-check2-circle"></i>Thêm vào kho</button>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* tab2 *@
<div class="tab-content" id="tab3">
    <div class="chart-card">
        <div class="staff-header">
            <h3 class="card-title">
                📈 Tổng hàng hóa
            </h3>
            @if (isLoading)
            {
                <div class="spinner" style="margin-top:10px;"></div>
            }
            else
            {
                <div class="staff-select">
                    <div class="staff-controls">
                        <select class="control-select" value="typeSelect" @onchange="TypeSPChange">
                            <option value="all">All</option>
                            @{
                                if (this.ListType != null && !isLoading)
                                {
                                    foreach (var item in this.ListType)
                                    {
                                        <option value="@item">@item</option>
                                    }
                                }
                            }
                        </select>
                    </div>
                    <div class="staff-controls">
                        <select class="control-select" value="typeWHSelect" @onchange="TypeWHChange">
                            <option value="all">Tất cả trong kho hiện có</option>
                            <option value="NotReturn">Khách cầm chưa trả</option>
                            <option value="AllEnter">Tổng số đã nhập kho</option>
                        </select>
                    </div>
                </div>
            }
        </div>
        <div class="chart-container">
            <canvas id="sumMaterialWH"></canvas>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', function() {
    // đổi active trên nút
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    this.classList.add('active');

    // đổi nội dung hiển thị
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    document.getElementById(this.dataset.tab).classList.add('active');
    });
    });
</script>


@code {
    private int month;
    private int year;
    private List<Data.DTOs.ListParamater> datapara = new();
    private List<Data.DTOs.ProductStock> dataWH = new();
    List<string> ListType;
    List<string> ListPrice;
    private bool isLoading = true, UpdateisLoading = false;
    private string newValueSP, newValuePrice, SelectValueSP, SelectValuePrice, TextValueNameSP, TextValueSizeSP, TextValueQTY, TextValueDesc;
    private string typeSelect, typeWHSelect;
    [Inject] private IJSRuntime JSx { get; set; }

    #region add SP
    protected override async Task OnInitializedAsync() //Được gọi khi component khởi tạo lần đầu tiên
    {
        this.month = int.Parse(DateTime.Now.Month.ToString());
        this.year = int.Parse(DateTime.Now.Year.ToString());

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)//Sau khi UI render xong
    {
        if (firstRender)
        {
            var result = await sessionStorage.GetAsync<bool>("isLoggedIn");

            if (result.Success && result.Value)
            {
                isLoading = true;
                await GetMaterialInWH(true, false);
                datapara = await GetListParamater.GetParamater();
                this.ListType = datapara.Where(x => x.KeyPara == "type").Select(x => x.keyData).OrderBy(x => x).ToList();
                this.ListPrice = datapara.Where(x => x.KeyPara == "price")
                                     .OrderBy(x =>
                                     {
                                         if (decimal.TryParse(x.keyData, out var number))
                                             return number;
                                         return decimal.MaxValue;
                                     })
                                     .Select(x => x.keyData)
                                     .ToList();
                isLoading = false;
                StateHasChanged();
            }
            else
            {
                Navigation.NavigateTo("/", true);

            }
        }

    }

    private async Task addSpClick()
    {
        List<Data.DTOs.ListParaUser> datapara = await GetSPInfo.GetLoginUser("type", newValueSP.ToUpper(), null);
        if (datapara != null && datapara.Any())
        {
            await JS.InvokeVoidAsync("alert", $"Loại sp ({newValueSP}) đã tồn tại!");
        }
        else
        {
            isLoading = true;
            int checkInsert = await AddPara.InsertParamaterRawAsync("type", newValueSP, null);
            if (checkInsert > 0)
            {
                List<Data.DTOs.ListParamater> data = await GetListParamater.GetParamater();
                this.ListType = data.Where(x => x.KeyPara == "type").Select(x => x.keyData).OrderBy(x => x).ToList();
                isLoading = false;
                await JS.InvokeVoidAsync("closeAllOptionMenus");
                await JS.InvokeVoidAsync("alert", $"Thêm loại sp ({newValueSP}) thành công!");
                newValueSP = "";
                StateHasChanged();
            }
            else
            {
                isLoading = false;
                await JS.InvokeVoidAsync("alert", $"Thêm loại sp ({newValueSP}) không thành công!");
            }
        }
    }

    private async Task XoaSpClick()
    {
        if (string.IsNullOrEmpty(SelectValueSP))
        {
            await JS.InvokeVoidAsync("alert", "Vui lòng chọn loại SP cần xóa trước");
            await JS.InvokeVoidAsync("closeAllOptionMenus");
            return;
        }
        bool confirmed = await JSx.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa sản phẩm này không?");

        if (confirmed)
        {
            isLoading = true;
            int checkInsert = await DeletePara.DeleteParamaterRawAsync("type", SelectValueSP, null);
            if (checkInsert > 0)
            {
                List<Data.DTOs.ListParamater> data = await GetListParamater.GetParamater();
                this.ListType = data.Where(x => x.KeyPara == "type").Select(x => x.keyData).OrderBy(x => x).ToList();
                isLoading = false;
                await JS.InvokeVoidAsync("closeAllOptionMenus");
                await JS.InvokeVoidAsync("alert", $"Delete loại sp ({SelectValueSP}) thành công!");
                newValueSP = "";
                StateHasChanged();
            }
            else
            {
                isLoading = false;
                await JS.InvokeVoidAsync("alert", $"Delete loại sp ({newValueSP}) không thành công!");
            }
        }
    }

    private async Task addPriceClick()
    {
        isLoading = true;
        List<Data.DTOs.ListParaUser> datapara = await GetSPInfo.GetLoginUser("price", newValuePrice, null);
        if (datapara != null && datapara.Any())
        {
            await JS.InvokeVoidAsync("alert", $"Giá sp ({newValuePrice}) đã tồn tại!");
            isLoading = false;
        }
        else
        {
            int checkInsert = await AddPara.InsertParamaterRawAsync("price", newValuePrice, null);
            if (checkInsert > 0)
            {

                List<Data.DTOs.ListParamater> data = await GetListParamater.GetParamater();
                this.ListPrice = data.Where(x => x.KeyPara == "price")
                                     .OrderBy(x =>
                                     {
                                         if (decimal.TryParse(x.keyData, out var number))
                                             return number;
                                         return decimal.MaxValue;
                                     })
                                     .Select(x => x.keyData)
                                     .ToList();
                isLoading = false;
                await JS.InvokeVoidAsync("closeAllOptionMenus");
                await JS.InvokeVoidAsync("alert", $"Thêm Giá sp ({newValuePrice}) thành công!");
                newValuePrice = "";
                StateHasChanged();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Thêm Giá sp ({newValuePrice}) không thành công!");
                isLoading = false;
            }
        }
    }

    private async Task XoaPriceClick()
    {
        if (string.IsNullOrEmpty(SelectValuePrice))
        {
            await JS.InvokeVoidAsync("alert", "Vui lòng chọn giá SP cần xóa trước");
            await JS.InvokeVoidAsync("closeAllOptionMenus");
            return;
        }
        bool confirmed = await JSx.InvokeAsync<bool>("confirm", "Bạn có chắc chắn muốn xóa giá SP này không?");

        if (confirmed)
        {
            isLoading = true;
            int checkInsert = await DeletePara.DeleteParamaterRawAsync("price", SelectValuePrice, null);
            if (checkInsert > 0)
            {
                List<Data.DTOs.ListParamater> data = await GetListParamater.GetParamater();
                this.ListPrice = data.Where(x => x.KeyPara == "price")
                                     .OrderBy(x =>
                                     {
                                         if (decimal.TryParse(x.keyData, out var number))
                                             return number;
                                         return decimal.MaxValue;
                                     })
                                     .Select(x => x.keyData)
                                     .ToList();
                await JS.InvokeVoidAsync("closeAllOptionMenus");
                await JS.InvokeVoidAsync("alert", $"Delete giá sp ({SelectValuePrice}) thành công!");
                newValueSP = "";
                isLoading = false;
                StateHasChanged();
            }
            else
            {
                await JS.InvokeVoidAsync("alert", $"Delete giá sp ({SelectValuePrice}) không thành công!");
            }
        }
    }

    private void OnPriceInput(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? "";

        var digitsOnly = new string(input.Where(char.IsDigit).ToArray());

        if (string.IsNullOrEmpty(digitsOnly))
        {
            newValuePrice = "";
            return;
        }

        if (int.TryParse(digitsOnly, out int number))
        {
            // newValuePrice = $"{number:N0}";
            var culture = new CultureInfo("vi-VN");
            newValuePrice = number.ToString("N0", culture);
        }
        else
            newValuePrice = "";
    }

    private IBrowserFile uploadedFile;
    private string previewImageUrl;
    private bool openImage = false;
    private MemoryStream? fileStream;
    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        openImage = true;
        uploadedFile = e.File;

        using var stream = uploadedFile.OpenReadStream(maxAllowedSize: 50 * 1024 * 1024); // 5MB

        fileStream = new MemoryStream();
        await stream.CopyToAsync(fileStream);

        var base64 = Convert.ToBase64String(fileStream.ToArray());
        previewImageUrl = $"data:{uploadedFile.ContentType};base64,{base64}";
    }

    private async Task UploadSP()
    {
        try
        {
            if (string.IsNullOrEmpty(SelectValuePrice) || string.IsNullOrEmpty(SelectValueSP)
            || string.IsNullOrEmpty(TextValueNameSP) || string.IsNullOrEmpty(TextValueSizeSP) || string.IsNullOrEmpty(TextValueQTY))
            {
                await JS.InvokeVoidAsync("alert", $"Vui lòng điền đầy đủ thông tin trước!");
                return;
            }
            if (fileStream == null || uploadedFile == null)
            {
                await JS.InvokeVoidAsync("alert", "Chưa chọn ảnh");
                return;
            }
            fileStream.Position = 0;
            UpdateisLoading = true;

            long productID = long.Parse(DateTime.Now.ToString("yyyyMMddHHmmss"));
            Decimal PriceSP = decimal.Parse(Regex.Match(SelectValuePrice.Trim(), @"\d+(\.\d+)?").Value);
            int QtySP = int.Parse(TextValueQTY);

            var fileName = productID.ToString();
            var contentType = uploadedFile.ContentType;
            await fileStream.CopyToAsync(fileStream);
            var base64Data = Convert.ToBase64String(fileStream.ToArray());

            #region doing image
            var values = new Dictionary<string, string>
            {
                { "data", base64Data },
                { "filename", fileName },
                { "mimeType", contentType }
            };
            var content = new FormUrlEncodedContent(values);
            var response = await Http.PostAsync("https://script.google.com/macros/s/AKfycbz_4Dtc0b1v_NS1A3fhBbflxfYDU2VIm7Viz3ArSk86zSBtrMbgWL1s0IPHuuxRAovi/exec", content);
            #endregion

            var responseString = await response.Content.ReadAsStringAsync();
            var doc = JsonDocument.Parse(responseString);
            bool success = doc.RootElement.GetProperty("success").GetBoolean();
            if (success)
            {
                int checkInsert = await InserSP.InserProduct(productID, TextValueNameSP, TextValueDesc, PriceSP, QtySP, TextValueSizeSP, SelectValueSP);
                if (checkInsert > 0)
                {
                    fileStream.Dispose();
                    fileStream = null;
                    openImage = false;
                    previewImageUrl = null;
                    uploadedFile = null;
                    SelectValuePrice = null;
                    SelectValueSP = null;
                    TextValueNameSP = null;
                    TextValueSizeSP = null;
                    TextValueQTY = null;
                    TextValueDesc = null;

                    await JS.InvokeVoidAsync("alert", "Thêm Sp mới ok!");
                }
                else
                {
                    await JS.InvokeVoidAsync("alert", "Thêm Sp mới lỗi!");
                }
            }
            else
            {
                await JS.InvokeVoidAsync("alert", "Upload thất bại");
            }
            UpdateisLoading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            await JS.InvokeVoidAsync("alert", $"Lỗi khi upload ảnh: {ex.Message}");
        }
    }
    #endregion

    #region Dummary chart
    private string typeSP = null;
    private string typeWH = "all";
    private async Task TypeSPChange(ChangeEventArgs e)
    {
        if (e.Value.ToString() != "all")
        {
            typeSP = e.Value.ToString();
        }
        string type = typeWH;
        bool all = type == "all" ? true : false;
        bool NotReturn = type == "NotReturn" ? true : false;

        await GetMaterialInWH(all, NotReturn);

    }
    private async Task TypeWHChange(ChangeEventArgs e)
    {
        typeWH = e.Value.ToString();

        bool all = typeWH == "all" ? true : false;
        bool NotReturn = typeWH == "NotReturn" ? true : false;

        await GetMaterialInWH(all, NotReturn);
    }

    public async Task GetMaterialInWH(bool all, bool NotReturn)
    {
        dataWH = await GetTotalWH.GetTotalWH(all, NotReturn, typeSP);

        var labels = dataWH.Select(x => x.type_production).ToList();
        var values = dataWH.Select(x => x.total_quantity).ToList();

        var backgroundColors = GetRandomColorList(values.Count);

        var chartData = new
        {
            labels = labels,
            datasets = new[]
            {
            new
            {
                label = "Số lượng tồn kho",
                data = values,
                backgroundColor = backgroundColors,
                borderColor = "'rgba(79, 195, 247, 0.1)",
                borderWidth = 1,
                fill = true,
                tension = 0.4
            }
        }
        };

        await JS.InvokeVoidAsync("chartWHHelper.renderChart", "sumMaterialWH", chartData, "bar", new
        {
            legendPosition = "none",
            showLabelInTooltip = false
        });
    }

    public List<string> GetRandomColorList(int count)
    {
        var random = new Random();
        var colors = new List<string>();
        for (int i = 0; i < count; i++)
        {
            colors.Add($"rgba({random.Next(256)}, {random.Next(256)}, {random.Next(256)}, 0.7)");
        }
        return colors;
    }

    #endregion
}

@inherits LayoutComponentBase

<div class="page" style="background-image: url('@bgUrl'); background-size: cover; background-position: center;">
    <div class="sidebar" style="background-color: transparent;">
        <NavMenu />
    </div>

    <main>
        <article>
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui">
    Đã xảy ra lỗi chưa xử lý.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@using FistWeb.Data.Services
@inject IGetParaUserService GetUserInfo
@code {
    private static string? CachedBgUrl;
    private string bgUrl = "";

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(CachedBgUrl))
        {
            var bg = await GetUserInfo.GetLoginUser("background", null, null);
            if (bg != null && bg.Any())
            {
                CachedBgUrl = bg[0].keyUsername;
            }
        }
        bgUrl = CachedBgUrl ?? "";    
    }
}
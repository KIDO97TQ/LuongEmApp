
<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">LươngEm App</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-heart-fill"></span> Trang chủ
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" @onclick="() => checkloading('2')">
                <span class="bi bi-journal-richtext" aria-hidden="true"></span> Quản lý đồ
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" @onclick="() => checkloading('3')">
                <span class="bi bi-list-stars" aria-hidden="true"></span> Quản lý thuê đồ
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" @onclick="() => checkloading('4')">
                <span class="bi bi-mastodon" aria-hidden="true"></span> Make-up
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" @onclick="() => checkloading('5')">
                <span class="bi bi-bluesky" aria-hidden="true"></span> Học viên Make-up
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" @onclick="() => checkloading('6')">
                <span class="bi bi-graph-up-arrow" aria-hidden="true"></span> Doanh thu thuê đồ
            </NavLink>
        </div>
       
    </nav>
</div>
@using FistWeb.Data.Services
@inject LoadingService LoadingService
@inject NavigationManager Navigation
@rendermode InteractiveServer
@code {
    private void checkloading(char context)
    {
        if (LoadingService.IsLoading) { return; }
        var url = context.ToString() switch
        {
            "2" => "quanlydo",
            "3" => "oderlist",
            "4" => "makeup",
            "5" => "makeupstudents",
            "6" => "DoanhThu"
        };
        if (!string.IsNullOrWhiteSpace(url))
            Navigation.NavigateTo(url);
    }

}
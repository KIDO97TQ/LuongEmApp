                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" @onclick="() => checkloading(6)">
                    <span class="bi bi-graph-up-arrow" aria-hidden="true"></span> Doanh thu thuê đồ
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" @onclick="() => checkloading(7)">
                    <span class="bi bi-bar-chart-line-fill" aria-hidden="true"></span>Tổng doanh thu
                </NavLink>
            </div>

        }
        @if (loginResult == "true" && (username.ToUpper() == "BANGTAM" || username.ToUpper() == "TRUONGDUNG" || username.ToUpper() == "NHANVIENCHUP" || username.ToUpper() == "NHANVIENTHUEDO"))
        {
            @if (loginResult == "true" && (username.ToUpper() == "BANGTAM" || username.ToUpper() == "TRUONGDUNG" || username.ToUpper() == "NHANVIENCHUP"))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" @onclick="() => checkloading(13)">
                        <span class="bi bi-camera" aria-hidden="true"></span>Quản lý lịch chụp
                    </NavLink>
                </div>
            }

            @if (loginResult == "true" && (username.ToUpper() == "BANGTAM" || username.ToUpper() == "TRUONGDUNG" || username.ToUpper() == "NHANVIENTHUEDO"))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" @onclick="() => checkloading(8)">
                        <span class="bi bi-journal-richtext" aria-hidden="true"></span> Quản lý đồ
                    </NavLink>
                </div>


                <div class="nav-item px-3">
                    <NavLink class="nav-link" @onclick="() => checkloading(12)">
                        <span class="bi bi-list-stars" aria-hidden="true"></span>Quản lý thuê đồ
                    </NavLink>
                </div>
            }

            @if (loginResult == "true" && (username.ToUpper() == "BANGTAM" || username.ToUpper() == "TRUONGDUNG"))
            {
                <div class="nav-item px-3">
                    <NavLink class="nav-link" @onclick="() => checkloading(9)">
                        <span class="bi bi-mastodon" aria-hidden="true"></span> Make-up
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" @onclick="() => checkloading(10)">
                        <span class="bi bi-person-check" aria-hidden="true"></span> Học viên Make-up
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" @onclick="() => checkloading(11)">
                        <span class="bi bi-bar-chart-line-fill" aria-hidden="true"></span>Tổng doanh thu
                    </NavLink>
                </div>
            }
        }
    </nav>
</div>
@using FistWeb.Data.Services
@inject LoadingService LoadingService
@inject NavigationManager Navigation
@inject IJSRuntime JS
@rendermode InteractiveServer
@inject Blazored.LocalStorage.ILocalStorageService localStorage

@code {
    private string loginResult;
    private string username;

    private async Task checkloading(int context)
    {
        if (LoadingService.IsLoading) { return; }
        var url = context.ToString() switch
        {
            "2" => "quanlydo",
            "3" => "oderlist",
            "4" => "makeup",
            "5" => "makeupstudents",
            "6" => "DoanhThu",
            "7" => "totaldoanhthu",

            "8" => "quanlydoAmy",
            "9" => "makeupAmy",
            "10" => "makeupstudentsAmy",
            "11" => "totaldoanhthuAmy",
            "12" => "oderlistAmy",
            "13" => "Lichchup"

        };
        if (!string.IsNullOrWhiteSpace(url))
            Navigation.NavigateTo(url);
    }
    protected override async Task OnInitializedAsync()
    {
        try
        {
            loginResult = await JS.InvokeAsync<string>("localStorage.getItem", "isLoggedIn");
            if (loginResult == "true")
            {
                username = await localStorage.GetItemAsync<string>("username");
            }
        }
        catch { }
    }
}
